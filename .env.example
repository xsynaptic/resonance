# App configuration; infrastructure secrets live in deploy/.env instead
# Leave a variable commented out rather than empty: an empty string is a value and overrides defaults

# Root of the audio file server, trailing slash required
# Downloads resolve to <FILES_URL>artifacts/ and streaming renditions to <FILES_URL>stream/
# astro.config.mjs defaults this to production, so a fresh clone builds without a .env
FILES_URL=https://files.djbasilisk.com/

# Umami analytics, optional and only rendered in production when both are set
# UMAMI_DOMAIN=
# UMAMI_ID=
