# App configuration; infrastructure secrets live in deploy/.env instead
# Leave a variable commented out rather than empty: an empty string overrides its default

# Root of the audio file server, trailing slash required
FILES_URL=

# Turnstile widget; the comments form renders no challenge without it
# The key is public; 1x00000000000000000000AA accepts any hostname, for `wrangler dev`
# TURNSTILE_SITE_KEY=

# Umami analytics, rendered in production only when both are set
# UMAMI_DOMAIN=
# UMAMI_ID=
