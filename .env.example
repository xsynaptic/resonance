# App configuration; infrastructure secrets live in deploy/.env instead
# Leave a variable commented out rather than empty: an empty string overrides its default

# Root of the audio file server, trailing slash required
# FILES_URL=

# Renders listening time on Mix pages in a production build; `pnpm dev` always shows it
# LISTENING_TIME_ENABLED=true

# Draws the waveform scope in the bar under `pnpm dev`, from the precomputed archive; off until its design settles
# PLAYER_SCOPE_ENABLED=true

# Discogs app credentials
# DISCOGS_CONSUMER_KEY=
# DISCOGS_CONSUMER_SECRET=

# Turnstile widget; the key is public, and must be set or `astro:env` fails on the comment form
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Domain to run through `pnpm test-smoke-prod`
# PROD_SERVER_URL=

# Umami analytics, rendered in production only when both are set
# UMAMI_DOMAIN=
# UMAMI_ID=
