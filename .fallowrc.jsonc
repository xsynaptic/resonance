{
	// Boundary and cycle checks only cover reachable files; MDX components are reached by auto-import
	"dynamicallyLoaded": ["src/components/mdx/**/*.astro"],
	"ignorePatterns": ["packages/content-demo", "packages/scripts/src/validate-content/fixtures/**"],
	"rules": {
		// Dead code and dependency hygiene belong to knip
		"unused-files": "off",
		"unused-exports": "off",
		"unused-types": "off",
		"unused-enum-members": "off",
		"unused-class-members": "off",
		"unused-dependencies": "off",
		"unused-dev-dependencies": "off",
		"unused-optional-dependencies": "off",
		"unlisted-dependencies": "off",
		"unresolved-imports": "off",
		"duplicate-exports": "off",
		"type-only-dependencies": "off",
		"test-only-dependencies": "off",
		"dev-dependencies-in-production": "off",
		"unused-dependency-overrides": "off",
		"misconfigured-dependency-overrides": "off",
		"css-token-drift": "error",
		"css-duplicate-block": "error",
		"css-broken-reference": "error",
		"re-export-cycle": "error",
		"package-cycle": "error",
		"policy-violation": "off",
	},
	"health": {
		// Zero disables CRAP, which fallow otherwise estimates without coverage data
		"maxCrap": 0,
		"maxCognitive": 12,
		// Inventory specimens take one-off sizes with no scale step
		"ignore": ["src/dev/**"],
	},
	"duplicates": {
		"minTokens": 30,
		// A threshold of zero means no limit; this fails on any clone group
		"threshold": 0.01,
		"ignore": ["src/dev/**", "tests/e2e/test.ts"],
	},
	"boundaries": {
		"zones": [
			{ "name": "packages", "patterns": ["packages/**"] },
			{ "name": "dev", "patterns": ["src/dev/**"] },
			{ "name": "lib", "patterns": ["src/lib/**", "src/constants.ts", "src/env.d.ts"] },
			{
				"name": "components",
				"patterns": [
					"src/components/**",
					"src/layouts/**",
					"src/pages/**",
					"src/styles/**",
					"src/content.config.ts",
				],
			},
			{ "name": "worker", "patterns": ["worker/**"] },
		],
		// Unzoned files are unrestricted both ways, so every analyzed file needs a zone
		"coverage": {
			"requireAllFiles": true,
			"allowUnmatched": ["*.config.{ts,mjs}", "tests/**"],
		},
		"rules": [
			// Vite/Rolldown build breaks when packages import the app at runtime
			{ "from": "packages", "allow": [], "allowTypeOnly": ["lib"] },
			{ "from": "lib", "allow": ["packages"] },
			{ "from": "components", "allow": ["lib", "packages"] },
			{ "from": "worker", "allow": ["lib"] },
		],
	},
}
