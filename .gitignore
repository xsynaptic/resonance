# build output
dist/

# generated types and caches
.astro/
.cache/
.wrangler/
__pycache__/

# dependencies
node_modules/

# logs
*-debug.log*

# environment variables
.env
.env.*
!.env.example
!deploy/.env.example

# macOS
.DS_Store

# local editor / tooling
.claude/reference
.claude/tasks*
.claude/settings*.json
.impeccable/

# database backups (large, not for VCS)
backups/

# content: the generated MDX and media stay out, the package's own tooling config is tracked
packages/content/*
!packages/content/.mdxlintrc.mjs
!packages/content/global.d.ts
!packages/content/package.json
!packages/content/tsconfig.json

# WP extract scripts: one-off, iterated locally, not checked in yet
packages/scripts/src/wp-extract/
