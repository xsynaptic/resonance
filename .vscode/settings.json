{
	"cSpell.enabledFileTypes": {
		"css": true,
		"git-commit": true,
		"html": true,
		"javascript": true,
		"javascriptreact": true,
		"json": true,
		"jsonc": true,
		"markdown": true,
		"mdx": true,
		"plaintext": true,
		"scss": true,
		"text": true,
		"typescript": true,
		"typescriptreact": true,
		"yaml": true,
		"yml": true
	},
	"cSpell.words": [
		"astrojs",
		"djbasilisk",
		"frontmatter",
		"mixcloud",
		"pagefind",
		"satteri",
		"soundcloud",
		"tailwindcss",
		"tracklist",
		"umami",
		"xsynaptic"
	],
	"cSpell.ignorePaths": [".vscode", "pnpm*.yaml", "node_modules", "tsconfig.json"],
	"eslint.validate": [
		"javascript",
		"javascriptreact",
		"typescript",
		"typescriptreact",
		"astro",
		"markdown",
		"mdx"
	],
	"stylelint.validate": ["css", "postcss", "tailwindcss", "astro"],
	"css.lint.unknownAtRules": "ignore",
	"editor.codeActionsOnSave": {
		"source.fixAll": "always",
		"source.fixAll.eslint": "always",
		"source.fixAll.stylelint": "explicit"
	},
	"editor.colorDecorators": true,
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.formatOnSave": true,
	"editor.quickSuggestions": {
		"strings": true
	},
	"files.associations": {
		"*.css": "tailwindcss",
		"**/deploy/nginx/**/*.conf": "nginx"
	},
	"npm.packageManager": "pnpm",
	"js/ts.preferences.importModuleSpecifier": "non-relative", // Prefer import mapped paths
	"js/ts.tsdk.path": "node_modules/typescript/lib",
	"workbench.editor.labelFormat": "short",
	"[astro]": {
		"editor.defaultFormatter": "astro-build.astro-vscode"
	},
	"astro.content-intellisense": true,
	"[markdown]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[typescript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[yaml]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	}
}
