# File server connection
DEPLOY_REMOTE_HOST=<ssh-host-alias>

# Server details
DEPLOY_SITE_URL=https://resonance.<account>.workers.dev/
DEPLOY_STAGING_PATH=/srv/resonance/server-config
DEPLOY_NGINX_SITES_PATH=<absolute path to the live sites-enabled directory>
DEPLOY_NGINX_SITES_OWNER=<user>:<group>

# Cloudflare API token
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# SoundCloud app credentials
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
