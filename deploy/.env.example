# File server connection; an ssh host alias from ~/.ssh/config
DEPLOY_REMOTE_HOST=<ssh-host-alias>
# Optional: explicit SSH key (otherwise ssh agent/keychain)
DEPLOY_SSH_KEY_PATH=

# Remote paths on the file server
DEPLOY_AUDIO_PATH=/srv/resonance
DEPLOY_SERVER_CONFIG_PATH=/home/<user>/server-config
DEPLOY_NGINX_SITES_PATH=/path/to/nginx/sites-enabled
DEPLOY_NGINX_SITES_OWNER=<user>:<group>

# Health checks. Before apex cutover this is the workers.dev URL
DEPLOY_SITE_URL=https://resonance.<account>.workers.dev/

# The file server root is FILES_URL in the root .env, shared with the build (see .env.example)
