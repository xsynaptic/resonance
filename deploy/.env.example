# File server connection
DEPLOY_REMOTE_HOST=<ssh-host-alias>

# Server details
DEPLOY_SITE_URL=https://resonance.<account>.workers.dev/
DEPLOY_STAGING_PATH=/srv/resonance/server-config
DEPLOY_FILE_SERVER_CONFIG_PATH=<absolute path to the live config directory>
DEPLOY_FILE_SERVER_CONFIG_OWNER=<user>:<group>

# Cloudflare API token
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DEPLOY_TOKEN=
CLOUDFLARE_COMMENTS_DATABASE_ID=

# SoundCloud app credentials
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Comments posted with this address are offered as the Owner's in moderation
COMMENTS_OWNER_EMAIL=
