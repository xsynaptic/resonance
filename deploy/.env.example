# Audio VPS connection
DEPLOY_REMOTE_HOST=deploy@files.djbasilisk.com
# Optional: explicit SSH key (otherwise ssh agent/keychain)
DEPLOY_SSH_KEY_PATH=

# Remote paths on the audio VPS
DEPLOY_AUDIO_PATH=<audio-path>
DEPLOY_SERVER_CONFIG_PATH=<staging-path>

# Health checks. Before apex cutover this is the workers.dev URL
DEPLOY_SITE_URL=https://djbasilisk.<account>.workers.dev/

# The file server root is FILES_URL in the root .env, shared with the build (see .env.example)
