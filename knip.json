{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": ["src/components/mdx/**/*.astro"],
			"ignoreDependencies": ["wrangler"]
		},
		"packages/scripts": {
			"ignoreBinaries": ["audiowaveform", "ffmpeg", "ffprobe", "which", "ssh-add"],
			"ignoreDependencies": ["mysql2", "@fontsource/.+", "@types/react", "react"]
		}
	},
	"ignoreWorkspaces": ["packages/content"]
}
