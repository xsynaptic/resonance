{
	"name": "@xsynaptic/resonance",
	"type": "module",
	"version": "2.0.0",
	"private": true,
	"scripts": {
		"dev": "astro dev",
		"build": "pnpm scripts build",
		"preview": "astro preview",
		"check-content": "mdxlint-content packages/content --root-path=$PWD",
		"fix-content": "mdxlint-content packages/content --fix --root-path=$PWD",
		"prepare": "wrangler types",
		"test": "vitest",
		"test-e2e": "pnpm -F @xsynaptic/player cut-fixtures && playwright test",
		"test-e2e-dev": "pnpm -F @xsynaptic/player cut-fixtures && TEST_ENV=dev playwright test",
		"test-e2e-player": "pnpm -F @xsynaptic/player test-e2e",
		"test-e2e-smoke": "playwright test --grep @smoke --max-failures=3",
		"test-e2e-smoke-prod": "TEST_ENV=prod playwright test --grep @smoke --max-failures=3",
		"comments": "pnpm -F @xsynaptic/scripts comments",
		"deploy-server-config": "pnpm -F @xsynaptic/scripts deploy-server-config",
		"deploy-site": "pnpm -F @xsynaptic/scripts deploy-site",
		"stats-test": "python3 deploy/stats/test-download-stats.py",
		"check": "lefthook run check",
		"fix": "lefthook run fix",
		"content-schemas": "astro sync && pnpm -F @xsynaptic/scripts content-schemas",
		"validate-content": "astro sync && pnpm -F @xsynaptic/scripts validate-content",
		"scripts": "pnpm -F @xsynaptic/scripts"
	},
	"imports": {
		"#e2e/*": "./tests/e2e/*",
		"#worker/*": "./worker/*",
		"#*": "./src/*"
	},
	"dependencies": {
		"@xsynaptic/playback-stats": "workspace:*",
		"@xsynaptic/player": "workspace:*",
		"astro": "^7.4.2",
		"p-memoize": "^9.0.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/markdown-satteri": "^0.4.5",
		"@astrojs/mdx": "^8.1.1",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@pagefind/component-ui": "^1.5.2",
		"@playwright/test": "^1.64.1",
		"@stryker-mutator/core": "^10.0.0",
		"@stryker-mutator/vitest-runner": "^10.0.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@types/node": "^24.19.2",
		"@types/sanitize-html": "^2.16.2",
		"@xsynaptic/astro-build-logger": "^1.1.0",
		"@xsynaptic/astro-font-devtools": "^1.0.4",
		"@xsynaptic/eslint-config": "^6.7.0",
		"@xsynaptic/mdxlint-config": "^2.0.0",
		"@xsynaptic/path-suggestions": "^0.2.0",
		"@xsynaptic/satteri-auto-import": "^0.2.1",
		"@xsynaptic/satteri-img-group": "^2.0.1",
		"@xsynaptic/scripts": "workspace:*",
		"@xsynaptic/shared": "workspace:*",
		"@xsynaptic/stylelint-config": "^1.1.5",
		"astro-pagefind": "^2.0.1",
		"eslint": "^10.13.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"fallow": "^3.35.0",
		"globals": "^17.13.0",
		"happy-dom": "^20.14.6",
		"knip": "^6.42.1",
		"lefthook": "^2.2.2",
		"markdown-it": "^15.0.3",
		"ohash": "^2.0.12",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sanitize-html": "^2.18.1",
		"satteri": "^0.10.5",
		"sharp": "^0.35.5",
		"shiki": "^4.5.0",
		"stylelint": "^17.16.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.12",
		"wrangler": "^4.151.3",
		"zod": "^4.6.7"
	},
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": "^24.19.0"
	}
}
