{
	"name": "@xsynaptic/resonance",
	"type": "module",
	"version": "2.0.0",
	"private": true,
	"scripts": {
		"dev": "astro dev",
		"build": "pnpm scripts lqip && pnpm scripts generate-redirects && pnpm scripts sitemap-lastmod && astro build && pnpm scripts og-image",
		"preview": "astro preview",
		"check-content": "mdxlint-content packages/content --root-path=$PWD",
		"fix-content": "mdxlint-content packages/content --fix --root-path=$PWD",
		"prepare": "wrangler types",
		"test": "vitest",
		"test-e2e-player": "pnpm -F @xsynaptic/player test-e2e",
		"test-e2e-smoke": "pnpm -F @xsynaptic/player cut-fixtures && playwright test",
		"test-e2e-smoke-prod": "pnpm -F @xsynaptic/player cut-fixtures && TEST_ENV=prod playwright test",
		"comments": "pnpm -F @xsynaptic/scripts comments",
		"deploy-server-config": "pnpm -F @xsynaptic/scripts deploy-server-config",
		"deploy-site": "pnpm -F @xsynaptic/scripts deploy-site",
		"stats-test": "python3 deploy/stats/test-download-stats.py",
		"check": "lefthook run check",
		"fix": "lefthook run fix",
		"content-schemas": "astro sync && pnpm -F @xsynaptic/scripts content-schemas",
		"validate-content": "astro sync && pnpm -F @xsynaptic/scripts validate-content",
		"scripts": "pnpm -F @xsynaptic/scripts"
	},
	"imports": {
		"#e2e/*": "./tests/e2e/*",
		"#worker/*": "./worker/*",
		"#*": "./src/*"
	},
	"dependencies": {
		"@xsynaptic/playback-stats": "workspace:*",
		"@xsynaptic/player": "workspace:*",
		"astro": "^7.3.4",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/markdown-satteri": "^0.4.2",
		"@astrojs/mdx": "^8.0.2",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@pagefind/component-ui": "^1.5.2",
		"@playwright/test": "^1.63.0",
		"@stryker-mutator/core": "^10.0.0",
		"@stryker-mutator/vitest-runner": "^10.0.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@types/node": "^24.13.6",
		"@types/sanitize-html": "^2.16.1",
		"@xsynaptic/astro-build-logger": "^1.1.0",
		"@xsynaptic/astro-font-devtools": "^1.0.2",
		"@xsynaptic/eslint-config": "^6.4.0",
		"@xsynaptic/mdxlint-config": "^2.0.0",
		"@xsynaptic/path-suggestions": "^0.2.0",
		"@xsynaptic/satteri-auto-import": "^0.2.1",
		"@xsynaptic/satteri-img-group": "^2.0.1",
		"@xsynaptic/scripts": "workspace:*",
		"@xsynaptic/shared": "workspace:*",
		"@xsynaptic/stylelint-config": "^1.1.4",
		"astro-pagefind": "^2.0.1",
		"eslint": "^10.11.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"fallow": "^3.27.0",
		"globals": "^17.12.0",
		"happy-dom": "^20.14.5",
		"knip": "^6.37.0",
		"lefthook": "^2.1.14",
		"markdown-it": "^15.0.2",
		"prettier": "^3.9.8",
		"prettier-plugin-astro": "^1.0.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sanitize-html": "^2.17.7",
		"satteri": "^0.10.5",
		"sharp": "^0.35.4",
		"shiki": "^4.4.3",
		"stylelint": "^17.15.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11",
		"wrangler": "^4.136.1",
		"zod": "^4.6.5"
	},
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": "^24.19.0"
	}
}
