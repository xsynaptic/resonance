{
	"name": "@xsynaptic/resonance",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "astro dev",
		"build": "astro check && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "eslint",
		"lint-css": "stylelint \"src/**/*.{css,astro}\"",
		"lint-css-fix": "stylelint \"src/**/*.{css,astro}\" --fix",
		"check-content": "mdxlint-content packages/content --root-path=$PWD",
		"fix-content": "mdxlint-content packages/content --fix --root-path=$PWD",
		"knip": "knip",
		"prepare": "wrangler types worker/worker-configuration.d.ts",
		"test": "vitest",
		"audio-validate": "pnpm -F @xsynaptic/scripts audio-validate",
		"audio-renditions": "pnpm -F @xsynaptic/scripts audio-renditions",
		"audio-waveforms": "pnpm -F @xsynaptic/scripts audio-waveforms",
		"backfill-downloads": "astro sync && pnpm -F @xsynaptic/scripts backfill-downloads",
		"comments": "pnpm -F @xsynaptic/scripts comments",
		"comments-backup": "pnpm -F @xsynaptic/scripts comments-backup",
		"comments-import": "pnpm -F @xsynaptic/scripts comments-import",
		"deploy-app": "pnpm -F @xsynaptic/scripts deploy-app",
		"deploy-audio": "pnpm -F @xsynaptic/scripts deploy-audio",
		"deploy-server-config": "pnpm -F @xsynaptic/scripts deploy-server-config",
		"deploy-site": "pnpm -F @xsynaptic/scripts deploy-site",
		"stats-pull": "pnpm -F @xsynaptic/scripts stats-pull",
		"stats-test": "python3 deploy/stats/test-download-stats.py",
		"check": "stylelint \"src/**/*.{css,astro}\" --cache --cache-location node_modules/.cache/stylelint/ && prettier --check . --cache && eslint --cache --cache-location node_modules/.cache/eslint/ && astro check && tsc --noEmit --extendedDiagnostics && wrangler types worker/worker-configuration.d.ts && tsc --noEmit -p worker && vitest run && knip",
		"fix": "stylelint \"src/**/*.{css,astro}\" --fix --cache --cache-location node_modules/.cache/stylelint/ && prettier --write . --cache && eslint --fix --cache --cache-location node_modules/.cache/eslint/ && astro check && tsc --noEmit --extendedDiagnostics && wrangler types worker/worker-configuration.d.ts && tsc --noEmit -p worker && knip",
		"check-types": "tsc --noEmit --extendedDiagnostics && tsc --noEmit -p worker",
		"content-schemas": "astro sync && pnpm -F @xsynaptic/scripts content-schemas",
		"generate-redirects": "astro sync && pnpm -F @xsynaptic/scripts generate-redirects",
		"og-image": "pnpm -F @xsynaptic/scripts og-image",
		"validate-content": "astro sync && pnpm -F @xsynaptic/scripts validate-content"
	},
	"imports": {
		"#*": "./src/*"
	},
	"dependencies": {
		"astro": "^7.2.10"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/markdown-satteri": "^0.4.0",
		"@astrojs/mdx": "^8.0.0",
		"@astrojs/sitemap": "^3.7.4",
		"@pagefind/component-ui": "^1.5.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/sanitize-html": "^2.16.1",
		"@xsynaptic/astro-font-devtools": "^1.0.2",
		"@xsynaptic/eslint-config": "^6.3.0",
		"@xsynaptic/mdxlint-config": "^2.0.0",
		"@xsynaptic/satteri-auto-import": "^0.2.1",
		"@xsynaptic/satteri-img-group": "^2.0.1",
		"@xsynaptic/shared": "workspace:*",
		"@xsynaptic/stylelint-config": "^1.1.4",
		"astro-pagefind": "^2.0.1",
		"eslint": "^10.9.1",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"globals": "^17.12.0",
		"knip": "^6.34.0",
		"lefthook": "^2.1.12",
		"markdown-it": "^15.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sanitize-html": "^2.17.7",
		"satteri": "^0.10.5",
		"sharp": "^0.35.4",
		"stylelint": "^17.14.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11",
		"wrangler": "^4.128.0",
		"yaml": "^2.9.0",
		"zod": "^4.5.4"
	},
	"packageManager": "pnpm@11.21.0"
}
