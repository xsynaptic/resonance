{
	"name": "@xsynaptic/resonance",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "astro dev",
		"build": "astro check && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "eslint",
		"lint-css": "stylelint \"src/**/*.{css,astro}\"",
		"check-content": "mdxlint-content packages/content --root-path=$PWD",
		"fix-content": "mdxlint-content packages/content --fix --root-path=$PWD",
		"knip": "knip",
		"audio-validate": "pnpm -F @xsynaptic/scripts audio-validate",
		"audio-renditions": "pnpm -F @xsynaptic/scripts audio-renditions",
		"deploy-app": "pnpm -F @xsynaptic/scripts deploy-app",
		"deploy-audio": "pnpm -F @xsynaptic/scripts deploy-audio",
		"deploy-server-config": "pnpm -F @xsynaptic/scripts deploy-server-config",
		"deploy-site": "pnpm -F @xsynaptic/scripts deploy-site",
		"stats-pull": "pnpm -F @xsynaptic/scripts stats-pull",
		"stats-test": "python3 deploy/stats/test-download-stats.py",
		"check": "stylelint \"src/**/*.{css,astro}\" && prettier --check . && eslint && astro check && tsc --noEmit --extendedDiagnostics && knip",
		"fix": "stylelint \"src/**/*.{css,astro}\" --fix --cache --cache-location node_modules/.cache/stylelint/ && prettier --write . --cache && eslint --fix --cache --cache-location node_modules/.cache/eslint/ && astro check && tsc --noEmit --extendedDiagnostics && knip",
		"check-types": "tsc --noEmit --extendedDiagnostics"
	},
	"imports": {
		"#*": "./src/*"
	},
	"dependencies": {
		"astro": "^7.1.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/markdown-satteri": "^0.3.4",
		"@astrojs/mdx": "^7.0.3",
		"@astrojs/sitemap": "^3.7.3",
		"@pagefind/component-ui": "^1.5.2",
		"@tailwindcss/vite": "^4.3.3",
		"@xsynaptic/astro-font-devtools": "^1.0.0",
		"@xsynaptic/eslint-config": "^6.1.1",
		"@xsynaptic/mdxlint-config": "^1.0.0",
		"@xsynaptic/satteri-auto-import": "^0.1.1",
		"@xsynaptic/satteri-img-group": "^0.2.1",
		"@xsynaptic/stylelint-config": "^1.0.0",
		"astro-pagefind": "^2.0.1",
		"eslint": "^10.8.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"globals": "^17.7.0",
		"knip": "^6.29.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"satteri": "^0.9.5",
		"sharp": "^0.35.3",
		"stylelint": "^17.14.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"wrangler": "^4.114.0",
		"zod": "^4.4.3"
	},
	"packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
