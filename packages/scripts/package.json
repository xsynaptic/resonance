{
	"name": "@xsynaptic/scripts",
	"version": "1.0.0",
	"description": "Build and deploy scripts for Resonance",
	"type": "module",
	"private": true,
	"imports": {
		"#*": "./src/*"
	},
	"exports": {
		"./og-image": "./src/og-image/inventory-exports.ts"
	},
	"scripts": {
		"comments": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/comments/moderate.cli.ts",
		"backup": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/backup/backup.cli.ts",
		"comments-pull": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/comments/pull.cli.ts",
		"listens-pull": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/stats/listens-pull.cli.ts",
		"discogs-tracklists": "tsx --env-file-if-exists=../../.env ./src/discogs/discogs-tracklists.cli.ts",
		"lqip": "tsx --env-file-if-exists=../../.env ./src/lqip/lqip.cli.ts",
		"audio-validate": "tsx --env-file-if-exists=../../.env ./src/audio/validate.cli.ts",
		"audio-renditions": "tsx --env-file-if-exists=../../.env ./src/audio/renditions.cli.ts",
		"audio-waveforms": "tsx --env-file-if-exists=../../.env ./src/audio/waveforms.cli.ts",
		"audio-manifest": "tsx --env-file-if-exists=../../.env ./src/audio/manifest.cli.ts",
		"deploy-app": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/deploy/deploy-app.cli.ts",
		"deploy-audio": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/deploy/deploy-audio.cli.ts",
		"deploy-server-config": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/deploy/deploy-server-config.cli.ts",
		"stats-pull": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/deploy/stats-pull.cli.ts",
		"deploy-site": "NODE_ENV=production tsx --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/deploy/deploy.ts",
		"content-schemas": "tsx ./src/content-schemas/index.ts",
		"generate-redirects": "astro sync --root ../.. && tsx ./src/generate-redirects/index.ts",
		"og-image": "tsx --env-file-if-exists=../../.env ./src/og-image/index.cli.ts",
		"sitemap-lastmod": "astro sync --root ../.. && tsx --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/sitemap-lastmod/index.cli.ts",
		"mixcloud-stats": "tsx --env-file-if-exists=../../.env ./src/platform-stats/mixcloud-stats.cli.ts",
		"soundcloud-stats": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/platform-stats/soundcloud-stats.cli.ts",
		"validate-content": "tsx --env-file-if-exists=../../.env ./src/validate-content/index.ts"
	},
	"devDependencies": {
		"@fontsource/fira-sans": "^5.3.0",
		"@fontsource/manrope": "^5.3.0",
		"@types/react": "^19.3.0",
		"@xsynaptic/shared": "workspace:*",
		"astro": "^7.3.4",
		"chalk": "^6.0.0",
		"p-limit": "^7.3.3",
		"react": "^19.3.0",
		"sharp": "^0.35.4",
		"takumi-js": "^2.14.0",
		"tsx": "^4.23.15",
		"vite": "^8.3.0",
		"yaml": "^2.9.1",
		"zod": "^4.6.5",
		"zx": "^8.8.5"
	}
}
