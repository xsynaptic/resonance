{
	"name": "@xsynaptic/scripts",
	"version": "1.0.0",
	"description": "Build and deploy scripts for Resonance",
	"type": "module",
	"private": true,
	"imports": {
		"#*": "./src/*"
	},
	"exports": {
		"./og-image": "./src/og-image/inventory-exports.ts"
	},
	"scripts": {
		"comments": "node --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/comments/moderate.cli.ts",
		"comments-delete": "node --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/comments/delete.cli.ts",
		"comments-orphans": "node --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/comments/orphans.cli.ts",
		"backup": "node --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/backup/backup.cli.ts",
		"comments-pull": "node --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/comments/pull.cli.ts",
		"discogs-tracklists": "node --env-file-if-exists=../../.env ./src/discogs/discogs-tracklists.cli.ts",
		"build": "NODE_ENV=production node --import tsx --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/build/build.cli.ts",
		"deploy-server-config": "node --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/deploy/deploy-server-config.cli.ts",
		"deploy-site": "NODE_ENV=production node --env-file-if-exists=../../.env --env-file-if-exists=../../deploy/.env ./src/deploy/deploy.ts",
		"content-schemas": "node ./src/content-schemas/index.ts",
		"og-image": "node --import tsx --env-file-if-exists=../../.env ./src/og-image/index.cli.ts",
		"validate-content": "node --env-file-if-exists=../../.env ./src/validate-content/index.ts"
	},
	"devDependencies": {
		"@fontsource/fira-sans": "^5.3.0",
		"@fontsource/manrope": "^5.3.0",
		"@types/react": "^19.3.0",
		"@xsynaptic/astro-image-pipeline": "^0.11.1",
		"@xsynaptic/astro-scripts": "^0.14.0",
		"@xsynaptic/astro-sitemap-lastmod": "^0.1.0",
		"@xsynaptic/shared": "workspace:*",
		"astro": "^7.4.4",
		"chalk": "^6.0.1",
		"p-limit": "^7.3.3",
		"react": "^19.3.1",
		"satteri": "^0.10.5",
		"sharp": "^0.35.5",
		"takumi-js": "^2.18.2",
		"tsx": "^4.23.15",
		"yaml": "^2.9.1",
		"zod": "^4.6.7",
		"zx": "^8.8.5"
	}
}
