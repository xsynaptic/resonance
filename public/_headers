# Applies to static asset responses only, so the Worker answers /api/comments with its own headers

# A repeated header is joined with a comma rather than replaced, so every rule below detaches first
# The last matching rule wins, not the most specific, so these run broad to narrow

# includeSubDomains covers files.djbasilisk.com, which is https only and redirects port 80
# A year of cached policy means any future subdomain has to be https from its first request
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: frame-ancestors 'none'; upgrade-insecure-requests
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

# Everything Astro fingerprints, fonts included; the platform default is max-age=0, must-revalidate
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# A card's filename is stable while its bytes change on any edit; immutable would freeze a stale one
/og/*
  ! Cache-Control
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# The loader and the UI bundle keep stable names, and the bundle loads on every page
# Ten minutes is what pagefind-entry.json can afford; it names a shard hash the next deploy deletes
/pagefind/*
  ! Cache-Control
  Cache-Control: public, max-age=600

# The shards under these two carry a content hash, so a cached one is never the wrong bytes
/pagefind/fragment/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/pagefind/index/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Unfingerprinted, so a month is how long a replacement takes to reach a repeat visitor
/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/favicon-32x32.png
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=2592000

# A day rather than the icons' month; a wrong rule here is served to crawlers until it expires
/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=86400
