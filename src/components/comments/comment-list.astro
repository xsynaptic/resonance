---
import type { CommentNode } from '#lib/collections/comments/comments-thread.ts';

import CommentReplies from '#components/comments/comment-list.astro';
import Anchor from '#components/parts/anchor.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { formatDate } from '#lib/utils/date.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

interface Props {
	comments: Array<CommentNode>;
	nested?: boolean | undefined;
}

const { comments, nested = false } = Astro.props;
---

<ol
	class:list={['space-y-8', nested ? 'mt-8 border-l border-surface-400 pl-4 sm:pl-6' : undefined]}
>
	{
		comments.map((comment) => (
			<li>
				<article class="flex gap-x-4" id={`comment-${comment.id}`}>
					{comment.avatarUrl ? (
						<img
							alt=""
							class="size-12 shrink-0 rounded-full bg-surface-600"
							height="96"
							loading="lazy"
							src={comment.avatarUrl}
							width="96"
						/>
					) : (
						<div aria-hidden="true" class="size-12 shrink-0 rounded-full bg-surface-600" />
					)}
					<div class="min-w-0 flex-1">
						<div class="flex flex-wrap items-baseline gap-x-2 text-sm">
							<span class="font-medium text-ink-200">
								{comment.authorHref ? (
									<Anchor anchorColor="muted" href={comment.authorHref} rel="nofollow ugc noopener">
										{comment.author}
									</Anchor>
								) : (
									comment.author
								)}
							</span>
							<time datetime={comment.date.toISOString()}>
								<Anchor class="text-xs" href={`#comment-${comment.id}`} rel="bookmark">
									{formatDate(comment.date)}
								</Anchor>
							</time>
						</div>
						<div class="prose-x mt-2 text-sm">
							<Fragment set:html={comment.bodyHtml} />
						</div>
						<button
							aria-label={formatStringTemplate(t('comments.replyTo'), { author: comment.author })}
							class="mt-2 cursor-pointer rounded px-1 text-sm font-medium text-highlight-500 hover:text-highlight-400 focus-visible:text-highlight-400 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-highlight-500"
							data-reply={comment.id}
							hidden
							type="button"
						>
							{t('comments.reply')}
						</button>
					</div>
				</article>
				{comment.replies.length > 0 ? (
					<CommentReplies comments={comment.replies} nested={true} />
				) : undefined}
			</li>
		))
	}
</ol>
