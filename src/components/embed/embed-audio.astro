---
import EmbedMixcloud from '#components/embed/embed-mixcloud.astro';
import EmbedSoundcloud from '#components/embed/embed-soundcloud.astro';

interface Props {
	mixcloudEmbed?: string | undefined;
	soundcloudEmbed?: Array<string> | string | undefined;
}

const { mixcloudEmbed, soundcloudEmbed } = Astro.props;

// A mix split across two SoundCloud tracks has one player, so the first part is the one embedded
const soundcloudUrl = Array.isArray(soundcloudEmbed) ? soundcloudEmbed[0] : soundcloudEmbed;
---

{mixcloudEmbed ? <EmbedMixcloud url={mixcloudEmbed} /> : undefined}
{!mixcloudEmbed && soundcloudUrl ? <EmbedSoundcloud url={soundcloudUrl} /> : undefined}
