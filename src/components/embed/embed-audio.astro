---
import EmbedMixcloud from '#components/embed/embed-mixcloud.astro';
import EmbedSoundcloud from '#components/embed/embed-soundcloud.astro';

interface Props {
	mixcloudLink?: string | undefined;
	soundcloudLink?: Array<string> | string | undefined;
}

const { mixcloudLink, soundcloudLink } = Astro.props;

// A mix split across two SoundCloud tracks has one player, so the first part is the one embedded
const soundcloudUrl = Array.isArray(soundcloudLink) ? soundcloudLink[0] : soundcloudLink;
---

{mixcloudLink ? <EmbedMixcloud url={mixcloudLink} /> : undefined}
{!mixcloudLink && soundcloudUrl ? <EmbedSoundcloud url={soundcloudUrl} /> : undefined}
