---
import EmbedFrame from '#components/embed/embed-frame.astro';

interface Props {
	/** Minimal player (single row) */
	mini?: boolean;
	/** Full MixCloud show URL (e.g. https://www.mixcloud.com/djbasilisk/show-name/) */
	url: string;
}

const { mini = false, url } = Astro.props;

// Fail soft on a malformed URL so one bad value can't abort the build, matching other resolvers
let feed: string | undefined;
try {
	feed = new URL(url).pathname;
} catch {
	if (import.meta.env.DEV) console.warn(`[mixcloud] invalid url: ${url}`);
}

const params = feed ? new URLSearchParams({ feed, hide_cover: '1', light: '0' }) : undefined;
if (params && mini) {
	params.set('mini', '1');
}

const src = params ? `https://www.mixcloud.com/widget/iframe/?${params.toString()}` : undefined;
const height = mini ? 60 : 120;
---

{src ? <EmbedFrame height={height} src={src} title="MixCloud player" /> : undefined}
