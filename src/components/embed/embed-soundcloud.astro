---
import EmbedFrame from '#components/embed/embed-frame.astro';
import { t } from '#lib/i18n/i18n-strings.ts';

interface Props {
	url: string;
}

const { url } = Astro.props;

const isSet = url.includes('/sets/');
const params = new URLSearchParams({
	color: 'a6dd47',
	hide_related: 'true',
	show_artwork: 'false',
	url,
	visual: 'false',
});

const src = `https://w.soundcloud.com/player/?${params.toString()}`;
const height = isSet ? 300 : 166;
---

<EmbedFrame height={height} src={src} title={t('embed.soundcloud.title')} />
