---
// fallow-ignore-file unused-component-prop -- fallow does not read attributes on an is:inline script
interface Props {
	umamiDomain: string;
	umamiId: string;
}

const { umamiDomain, umamiId } = Astro.props;
---

<script
	data-do-not-track="true"
	data-exclude-hash="true"
	data-performance="true"
	data-website-id={umamiId}
	defer
	is:inline
	src={`${umamiDomain}/script.js`}
></script>
