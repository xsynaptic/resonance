---
import MenuFooter from '#components/menu/menu-footer.astro';
import Anchor from '#components/parts/anchor.astro';
import { getPublishedMixes } from '#lib/collections/mixes/mixes-data.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { site } from '#lib/site.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

const publishedMixes = await getPublishedMixes();
const recentMixes = publishedMixes.slice(0, 5);
const year = new Date().getFullYear();
---

<footer
	class="maze bg-surface-900 bg-linear-to-b from-surface-800 to-transparent [--pattern-color:var(--color-surface-700)]"
>
	<div class="content-wide grid gap-8 py-12 text-sm text-ink-600 sm:grid-cols-3">
		<section>
			<h2 class="heading-label">
				{site.title}
			</h2>
			<p class="mt-3">
				{t('footer.about.lead')}{' '}<Anchor anchorColor="muted" href="/profile"
					>{t('footer.about.profileLink')}</Anchor
				>{t('footer.about.body')}{' '}<Anchor anchorColor="muted" href="/about"
					>{t('footer.about.aboutLink')}</Anchor
				>.
			</p>
			<p class="mt-3">
				{t('footer.support.lead')}{' '}<Anchor
					anchorColor="muted"
					href="https://www.patreon.com/ektoplazm">{t('footer.support.link')}</Anchor
				>.
			</p>
		</section>
		<MenuFooter />
		<section>
			<h2 class="heading-label">{t('footer.recentMixes.heading')}</h2>
			<ul class="mt-3">
				{
					recentMixes.map((mix) => (
						<li>
							<Anchor anchorColor="muted" href={`/mixes/${mix.id}`}>
								{mix.data.title}
							</Anchor>
						</li>
					))
				}
			</ul>
		</section>
	</div>
	<div class="content-wide border-t border-surface-700 py-6 text-xs text-ink-700">
		{formatStringTemplate(t('footer.copyright'), { year })} · {t('footer.poweredBy')}{' '}<a
			class="text-ink-600 hover:text-highlight-400 focus-visible:text-highlight-400"
			href="https://astro.build">{t('footer.astro')}</a
		>
	</div>
</footer>
