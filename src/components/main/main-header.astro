---
import MenuHeader from '#components/menu/menu-header.astro';
import Search from '#components/search/search.astro';
import { site } from '#lib/site.ts';
---

<header
	class="maze bg-surface-700 bg-linear-to-t from-surface-800 to-transparent [--pattern-color:var(--color-surface-500)]"
>
	<div class="content-wide flex flex-wrap items-center gap-x-8 gap-y-2 pt-8 pb-6">
		<a
			class="mr-auto font-display text-3xl font-semibold tracking-tight text-highlight-500 hover:text-highlight-400"
			href="/"
		>
			{site.title}
		</a>
		<Search class="md:order-1" />
		<MenuHeader class="w-full md:w-auto" />
	</div>
</header>
