---
import { OPEN_GRAPH_IMAGE_HEIGHT, OPEN_GRAPH_IMAGE_WIDTH } from '@xsynaptic/shared/constants';
import { Font } from 'astro:assets';
import { UMAMI_DOMAIN, UMAMI_ID } from 'astro:env/client';

import '#styles/main.css';
import MainAnalytics from '#components/main/main-analytics.astro';
import MainSprites from '#components/main/main-sprites.astro';
import MenuFooter from '#components/menu/menu-footer.astro';
import MenuHeader from '#components/menu/menu-header.astro';
import { site } from '#lib/site.ts';
import { getOpenGraphImageUrl } from '#lib/utils/seo.ts';

interface Props {
	description?: string;
	openGraphId?: string;
	openGraphType?: 'article' | 'website';
	title?: string;
}

const {
	description = site.description,
	openGraphId,
	openGraphType = 'website',
	title,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const openGraphImageUrl = getOpenGraphImageUrl(openGraphId, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width, initial-scale=1" name="viewport" />
		<link href="/favicon.svg" rel="icon" type="image/svg+xml" />
		<Font cssVariable="--font-manrope" preload />
		<Font cssVariable="--font-fira-sans" preload />
		<title>{pageTitle}</title>
		<meta content={description} name="description" />
		<meta content={openGraphType} property="og:type" />
		<meta content={pageTitle} property="og:title" />
		<meta content={description} property="og:description" />
		<meta content={pageUrl} property="og:url" />
		<meta content={site.title} property="og:site_name" />
		<meta content={openGraphImageUrl} property="og:image" />
		<meta content={String(OPEN_GRAPH_IMAGE_WIDTH)} property="og:image:width" />
		<meta content={String(OPEN_GRAPH_IMAGE_HEIGHT)} property="og:image:height" />
		<meta content="summary_large_image" name="twitter:card" />
		{
			UMAMI_ID && UMAMI_DOMAIN && import.meta.env.PROD ? (
				<MainAnalytics umamiDomain={UMAMI_DOMAIN} umamiId={UMAMI_ID} />
			) : undefined
		}
	</head>
	<body class="flex min-h-screen flex-col">
		<MainSprites />
		<MenuHeader />
		<main class="content-column w-full flex-1 py-12">
			<slot />
		</main>
		<MenuFooter />
	</body>
</html>
