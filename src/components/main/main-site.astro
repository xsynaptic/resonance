---
import { openGraphImageHeight, openGraphImageWidth } from '@xsynaptic/shared/constants';
import { Font } from 'astro:assets';
import { UMAMI_DOMAIN, UMAMI_ID } from 'astro:env/client';
import { ClientRouter } from 'astro:transitions';

import '#styles/main.css';
import type { Thing } from '#lib/utils/seo-structured-data.ts';

import MainAnalytics from '#components/main/main-analytics.astro';
import MainFooter from '#components/main/main-footer.astro';
import MainHeader from '#components/main/main-header.astro';
import MainProgressLoading from '#components/main/main-progress-loading.astro';
import MainSkipLink from '#components/main/main-skip-link.astro';
import MainSprites from '#components/main/main-sprites.astro';
import MainStructuredData from '#components/main/main-structured-data.astro';
import MainTopButton from '#components/main/main-top-button.astro';
import PlayerBar from '#components/player/player-bar.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { site } from '#lib/site.ts';
import { renderSlot } from '#lib/utils/astro.ts';
import { getSiteUrl } from '#lib/utils/routing.ts';
import { getOpenGraphImageUrl } from '#lib/utils/seo.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

interface Props {
	description?: string;
	noIndex?: boolean;
	openGraphId?: string;
	openGraphType?: 'article' | 'website';
	publishedTime?: Date | undefined;
	schemas?: Array<Thing> | undefined;
	title?: string;
}

const {
	description = site.description,
	noIndex = false,
	openGraphId,
	openGraphType = 'website',
	publishedTime,
	schemas,
	title,
} = Astro.props;
const pageTitle = title
	? formatStringTemplate(t('site.pageTitle'), { siteTitle: site.title, title })
	: site.title;

const pageUrl = getSiteUrl(Astro.url.pathname);
const openGraphImageUrl = getOpenGraphImageUrl(openGraphId, Astro.site);

// Without max-image-preview:large Google caps image previews at thumbnail size
const robots = noIndex
	? 'noindex, nofollow'
	: 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';

const heroSlot = await renderSlot(Astro.slots, 'hero');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width, initial-scale=1" name="viewport" />
		<meta content="dark" name="color-scheme" />
		<meta content="#2b3136" name="theme-color" />
		<link href="/favicon.ico" rel="icon" sizes="32x32" />
		<link href="/favicon-32x32.png" rel="icon" sizes="32x32" type="image/png" />
		<link href="/apple-touch-icon.png" rel="apple-touch-icon" />
		<link href={getSiteUrl('/sitemap-index.xml')} rel="sitemap" />
		<link
			href={getSiteUrl('/rss.xml')}
			rel="alternate"
			title={site.title}
			type="application/rss+xml"
		/>
		<Font cssVariable="--font-archivo" preload={[{ style: 'normal' }]} />
		<Font cssVariable="--font-fira-sans" preload={[{ style: 'normal' }]} />
		<link href={pageUrl} rel="canonical" />
		<title>{pageTitle}</title>
		<meta content={description} name="description" />
		<meta content={robots} name="robots" />
		<meta content={Astro.generator} name="generator" />
		<meta content={openGraphType} property="og:type" />
		<meta content={pageTitle} property="og:title" />
		<meta content={description} property="og:description" />
		<meta content={pageUrl} property="og:url" />
		<meta content={site.title} property="og:site_name" />
		<meta content="en_US" property="og:locale" />
		<meta content={openGraphImageUrl} property="og:image" />
		<meta content={String(openGraphImageWidth)} property="og:image:width" />
		<meta content={String(openGraphImageHeight)} property="og:image:height" />
		<meta content={pageTitle} property="og:image:alt" />
		{
			publishedTime ? (
				<meta content={publishedTime.toISOString()} property="article:published_time" />
			) : undefined
		}
		<meta content="summary_large_image" name="twitter:card" />
		<meta content="@djbasilisk" name="twitter:site" />
		{
			UMAMI_ID && UMAMI_DOMAIN && import.meta.env.PROD ? (
				<MainAnalytics umamiDomain={UMAMI_DOMAIN} umamiId={UMAMI_ID} />
			) : undefined
		}
		<ClientRouter />
	</head>
	<body class="relative flex min-h-screen flex-col">
		<MainProgressLoading />
		<MainSkipLink />
		<MainSprites />
		<MainHeader hero={Boolean(heroSlot)} />
		<main class="w-full flex-1 bg-surface-500 band-fade-content" id="main-content">
			{heroSlot ? <Fragment set:html={heroSlot} /> : undefined}
			<div class:list={['content-wide pb-12', heroSlot ? 'pt-5' : 'pt-12']}>
				<slot />
			</div>
		</main>
		<MainFooter />
		<div class="sticky bottom-0 z-player">
			<MainTopButton />
			<PlayerBar />
		</div>
		{schemas && schemas.length > 0 ? <MainStructuredData schemas={schemas} /> : undefined}
	</body>
</html>
