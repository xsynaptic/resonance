---
import { openGraphImageHeight, openGraphImageWidth } from '@xsynaptic/shared/constants';
import { Font } from 'astro:assets';
import { UMAMI_DOMAIN, UMAMI_ID } from 'astro:env/client';

import '#styles/main.css';
import MainAnalytics from '#components/main/main-analytics.astro';
import MainFooter from '#components/main/main-footer.astro';
import MainHeader from '#components/main/main-header.astro';
import MainSprites from '#components/main/main-sprites.astro';
import MainTopButton from '#components/main/main-top-button.astro';
import { site } from '#lib/site.ts';
import { renderSlot } from '#lib/utils/astro.ts';
import { getOpenGraphImageUrl } from '#lib/utils/seo.ts';

interface Props {
	description?: string;
	openGraphId?: string;
	openGraphType?: 'article' | 'website';
	title?: string;
}

const {
	description = site.description,
	openGraphId,
	openGraphType = 'website',
	title,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const openGraphImageUrl = getOpenGraphImageUrl(openGraphId, Astro.site);

const heroSlot = await renderSlot(Astro.slots, 'hero');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width, initial-scale=1" name="viewport" />
		<link href="/favicon.ico" rel="icon" sizes="32x32" />
		<link href="/favicon-32x32.png" rel="icon" sizes="32x32" type="image/png" />
		<link href="/apple-touch-icon.png" rel="apple-touch-icon" />
		<Font cssVariable="--font-archivo" preload />
		<Font cssVariable="--font-fira-sans" preload />
		<title>{pageTitle}</title>
		<meta content={description} name="description" />
		<meta content={openGraphType} property="og:type" />
		<meta content={pageTitle} property="og:title" />
		<meta content={description} property="og:description" />
		<meta content={pageUrl} property="og:url" />
		<meta content={site.title} property="og:site_name" />
		<meta content={openGraphImageUrl} property="og:image" />
		<meta content={String(openGraphImageWidth)} property="og:image:width" />
		<meta content={String(openGraphImageHeight)} property="og:image:height" />
		<meta content="summary_large_image" name="twitter:card" />
		{
			UMAMI_ID && UMAMI_DOMAIN && import.meta.env.PROD ? (
				<MainAnalytics umamiDomain={UMAMI_DOMAIN} umamiId={UMAMI_ID} />
			) : undefined
		}
	</head>
	<body class="relative flex min-h-screen flex-col">
		<MainSprites />
		<MainHeader hero={Boolean(heroSlot)} />
		<main class="w-full flex-1 bg-surface-500" id="main-content">
			{heroSlot ? <Fragment set:html={heroSlot} /> : undefined}
			<div class:list={['content-wide pb-12', heroSlot ? 'pt-5' : 'pt-12']}>
				<slot />
			</div>
		</main>
		<MainFooter />
		<MainTopButton />
	</body>
</html>
