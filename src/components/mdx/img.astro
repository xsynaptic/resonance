---
import MediaImage from '#components/parts/media-image.astro';
import { renderSlot } from '#lib/utils/astro.ts';

interface Props {
	alt?: string | undefined;
	src: string;
}

const { alt = '', src } = Astro.props;

const { isFeed } = Astro.locals;

// A caption is the slot content; WP recorded one on 23 attachments and nothing else
const caption = await renderSlot(Astro.slots);

// `none` emits a plain img with width and height, which is all a reader can lay out
const imageProps = isFeed
	? ({ layout: 'none', width: 900 } as const)
	: ({
			layout: 'constrained',
			// The column is min(900px, 100vw - 2 * gutter); the gutter steps at 30rem and 40rem
			sizes:
				'(min-width: 61.25rem) 900px, (min-width: 40rem) calc(100vw - 5rem), (min-width: 30rem) calc(100vw - 3rem), calc(100vw - 2rem)',
			width: 900,
		} as const);
---

{caption ? (
	<figure class="img-figure">
		<div class="media-frame overflow-hidden rounded">
			<MediaImage alt={alt} class="block" path={src} {...imageProps} />
		</div>
		<figcaption class="img-caption" set:html={caption} />
	</figure>
) : (
	<div class="media-frame overflow-hidden rounded">
		<MediaImage alt={alt} class="block" path={src} {...imageProps} />
	</div>
)}
