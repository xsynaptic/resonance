---
import type { HTMLAttributes } from 'astro/types';

import { getCatalog } from '#lib/catalog/catalog-data.ts';
import { renderSlot } from '#lib/utils/astro.ts';

// `id` names a catalog entry, not the anchor's HTML id
interface Props extends Omit<HTMLAttributes<'a'>, 'id'> {
	id: string | undefined;
}

const { id, ...props } = Astro.props;

const content = await renderSlot(Astro.slots, 'default');

const pathname = Astro.url.pathname;

if (!id) {
	throw new Error(`Link component requires an id; rendering path: ${pathname}`);
}

const catalog = await getCatalog();
const item = catalog.getById(id);
---

{item ? <a href={item.url} {...props} set:html={content} /> : <Fragment set:html={content} />}
