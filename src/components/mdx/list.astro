---
import type { ListItemValue } from '#lib/schemas/lists.ts';

import ListItem from '#components/parts/list-item.astro';

interface Props {
	items?: Array<ListItemValue> | undefined;
	order?: 'countdown' | 'ordered' | 'unordered' | undefined;
}

const { items, order = 'unordered' } = Astro.props;
const isOrdered = order === 'ordered' || order === 'countdown';
const Tag = isOrdered ? 'ol' : 'ul';

// Countdown lists are authored best-first but revealed best-last: reverse for display, number
// descending (N->1) via the CSS counter (see list.css); counter starts at count + 1 and steps down
const displayItems = order === 'countdown' && items ? items.toReversed() : items;
const countdownStyle =
	order === 'countdown' && items ? `counter-reset: c-list ${String(items.length + 1)}` : undefined;
---

{
	displayItems && displayItems.length > 0 ? (
		<Tag
			class:list={['c-list not-prose my-6 space-y-6', isOrdered && 'c-list-ordered']}
			data-order={order}
			style={countdownStyle}
		>
			{displayItems.map((item) => (
				<ListItem {...item} />
			))}
		</Tag>
	) : undefined
}
