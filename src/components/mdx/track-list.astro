---
import type { TrackValue } from '#lib/schemas/audio.ts';

import RefText from '#components/parts/ref-text.astro';
import { resolveRefUrl } from '#lib/utils/terms.ts';

interface Props {
	tracks?: Array<TrackValue> | undefined;
}

const { tracks } = Astro.props;

// Some extracted titles already carry the remix inline (e.g. "The 5th World (Ken Zo Remix)")
function getRemixer(track: TrackValue): string | undefined {
	if (!track.remixer) return undefined;

	return track.title.toLowerCase().includes(track.remixer.toLowerCase())
		? undefined
		: track.remixer;
}

// Resolve the optional linking ids to urls up front (title maps are cached, so this is cheap)
const links = await Promise.all(
	(tracks ?? []).map(async (track) => ({
		artistUrl: await resolveRefUrl('artists', track.artistId),
		labelUrl: await resolveRefUrl('labels', track.labelId),
		remixerUrl: await resolveRefUrl('artists', track.remixerId),
	})),
);
---

{
	tracks && tracks.length > 0 ? (
		<section class="not-prose my-8">
			<h2 class="mb-3 font-display text-lg font-bold text-accent-400">Tracklist</h2>
			<ol class="track-list">
				{tracks.map((track, index) => {
					const { artistUrl, labelUrl, remixerUrl } = links[index] ?? {};
					const remixer = getRemixer(track);

					return (
						<li class="track">
							<span aria-hidden="true" class="track-index">
								{index + 1}.
							</span>
							<span class="track-title-line">
								<strong class="text-ink-100">
									<RefText label={track.artist} url={artistUrl} />
								</strong>
								<span class="text-ink-600">{' - '}</span>
								<span class="font-medium">{track.title}</span>
								{remixer ? (
									<span>
										{' ('}
										<RefText label={remixer} url={remixerUrl} />
										{' remix)'}
									</span>
								) : undefined}
							</span>
							{track.label || track.year ? (
								<span class="track-label-year">
									{track.label ? <RefText label={track.label} url={labelUrl} /> : undefined}
									{track.label && track.year ? ', ' : ''}
									{track.year}
								</span>
							) : undefined}
							{track.time ? <span class="track-time">{track.time}</span> : undefined}
						</li>
					);
				})}
			</ol>
		</section>
	) : undefined
}
