---
import type { TrackValue } from '#lib/schemas/audio.ts';
import type { ResolvedRef } from '#lib/utils/terms.ts';

import RefList from '#components/parts/ref-list.astro';
import { resolveRefs } from '#lib/utils/terms.ts';

interface Props {
	tracks?: Array<TrackValue> | undefined;
}

const { tracks } = Astro.props;

// Some extracted titles already carry the remix inline (e.g. "The 5th World (Ken Zo Remix)")
// Suppress the credit only when every named artist appears, so a partial group still renders
function visibleMixArtists(title: string, mixArtists: Array<ResolvedRef>): Array<ResolvedRef> {
	if (mixArtists.length === 0) return [];

	const lowerTitle = title.toLowerCase();
	const allNamed = mixArtists.every((ref) => lowerTitle.includes(ref.label.toLowerCase()));

	return allNamed ? [] : mixArtists;
}

// Resolve the polymorphic refs up front (title maps are cached, so this is cheap)
const resolved = await Promise.all(
	(tracks ?? []).map(async (track) => ({
		artists: await resolveRefs('artists', track.artists),
		labels: await resolveRefs('labels', track.labels),
		mixArtists: await resolveRefs('artists', track.mixArtists),
	})),
);
---

{
	tracks && tracks.length > 0 ? (
		<section class="not-prose my-8">
			<h2 class="mb-3 font-display text-lg font-bold text-accent-400">Tracklist</h2>
			<ol class="track-list">
				{tracks.map((track, index) => {
					const { artists, labels, mixArtists } = resolved[index] ?? {};
					const trackArtists = artists ?? [];
					const trackLabels = labels ?? [];
					const remixCredit = visibleMixArtists(track.title, mixArtists ?? []);

					return (
						<li class="track">
							<span aria-hidden="true" class="track-index">
								{index + 1}.
							</span>
							<span class="track-title-line">
								{trackArtists.length > 0 ? (
									<Fragment>
										<strong class="text-ink-100">
											<RefList refs={trackArtists} />
										</strong>
										<span class="text-ink-600">{' - '}</span>
									</Fragment>
								) : undefined}
								<span class="font-medium">{track.title}</span>
								{remixCredit.length > 0 ? (
									<span>
										{' ('}
										<RefList refs={remixCredit} />
										{' remix)'}
									</span>
								) : undefined}
							</span>
							{trackLabels.length > 0 || track.year ? (
								<span class="track-label-year">
									<RefList refs={trackLabels} />
									{trackLabels.length > 0 && track.year ? ', ' : ''}
									{track.year}
								</span>
							) : undefined}
							{track.timestamp ? <span class="track-time">{track.timestamp}</span> : undefined}
						</li>
					);
				})}
			</ol>
		</section>
	) : undefined
}
