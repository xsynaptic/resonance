---
import type { TrackValue } from '#lib/schemas/audio.ts';
import type { ResolvedRef } from '#lib/utils/terms.ts';

import RefList from '#components/parts/ref-list.astro';
import { resolveRefs } from '#lib/utils/terms.ts';

interface Props {
	tracks?: Array<TrackValue> | undefined;
}

interface TrackRow {
	artists: Array<ResolvedRef>;
	hasMeta: boolean;
	labels: Array<ResolvedRef>;
	metaSeparator: string;
	position: number;
	remixCredit: Array<ResolvedRef>;
	timestamp: string | undefined;
	title: string;
	year: string | undefined;
}

const { tracks } = Astro.props;

async function buildRow(track: TrackValue, index: number): Promise<TrackRow> {
	const [artists, labels, mixArtists] = await Promise.all([
		resolveRefs('artists', track.artists),
		resolveRefs('labels', track.labels),
		resolveRefs('artists', track.mixArtists),
	]);

	return {
		artists,
		hasMeta: labels.length > 0 || Boolean(track.year),
		labels,
		metaSeparator: labels.length > 0 && track.year ? ', ' : '',
		position: index + 1,
		remixCredit: visibleMixArtists(track.title, mixArtists),
		timestamp: track.timestamp,
		title: track.title,
		year: track.year,
	};
}

// Some extracted titles already carry the remix inline (e.g. "The 5th World (Ken Zo Remix)")
// Suppress the credit only when every named artist appears, so a partial group still renders
function visibleMixArtists(title: string, mixArtists: Array<ResolvedRef>): Array<ResolvedRef> {
	if (mixArtists.length === 0) return [];

	const lowerTitle = title.toLowerCase();
	const allNamed = mixArtists.every((ref) => lowerTitle.includes(ref.label.toLowerCase()));

	return allNamed ? [] : mixArtists;
}

// Resolve the polymorphic refs up front (title maps are cached, so this is cheap)
const rows = await Promise.all((tracks ?? []).map(buildRow));
---

{
	rows.length > 0 ? (
		<section class="not-prose my-8">
			<h2 class="mb-3 text-h3">Tracklist</h2>
			<ol class="track-list">
				{rows.map((row) => (
					<li class="track">
						<span aria-hidden="true" class="track-index">
							{row.position}.
						</span>
						<span class="track-title-line">
							{row.artists.length > 0 ? (
								<Fragment>
									<strong class="text-ink-100">
										<RefList refs={row.artists} />
									</strong>
									<span class="text-ink-600">{' - '}</span>
								</Fragment>
							) : undefined}
							<span class="font-medium">{row.title}</span>
							{row.remixCredit.length > 0 ? (
								<span>
									{' ('}
									<RefList refs={row.remixCredit} />
									{' remix)'}
								</span>
							) : undefined}
						</span>
						{row.hasMeta ? (
							<span class="track-label-year">
								<RefList refs={row.labels} />
								{row.metaSeparator}
								{row.year}
							</span>
						) : undefined}
						{row.timestamp ? <span class="track-time">{row.timestamp}</span> : undefined}
					</li>
				))}
			</ol>
		</section>
	) : undefined
}
