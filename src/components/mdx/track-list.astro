---
import type { TracklistValue } from '#lib/schemas/audio.ts';

import TrackListFeed from '#components/mdx/track-list-feed.astro';
import TrackListGroup from '#components/mdx/track-list-group.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { toTrackGroups } from '#lib/utils/track-groups.ts';
import { buildTrackGroupRows } from '#lib/utils/track-rows.ts';

interface Props {
	tracks?: TracklistValue | undefined;
}

const { tracks } = Astro.props;

const { isFeed } = Astro.locals;

// The tag is auto-imported into MDX bodies and has no props naming its entry, so the route supplies it
// Off a mix detail page (feed, inventory) there is no slug and the cue half of a download drops out
const { slug } = Astro.params;

const groups = await Promise.all(
	toTrackGroups(tracks).map((group) => buildTrackGroupRows(group, slug)),
);

const hasRows = groups.some((group) => group.rows.length > 0);
---

{isFeed && hasRows ? <TrackListFeed groups={groups} /> : undefined}
{!isFeed && hasRows ? (
	<section class="my-8">
		<h2 class="heading-sub mb-3">{t('section.tracklist.heading')}</h2>
		{groups.map((group) => (
			<TrackListGroup group={group} />
		))}
	</section>
) : undefined}
