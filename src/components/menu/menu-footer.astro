---
import type { HTMLAttributes } from 'astro/types';

import { menuFooterItems } from '#components/menu/menu-footer.ts';
import { isActiveMenuPath } from '#components/menu/menu-utils.ts';

type Props = HTMLAttributes<'nav'>;

const props = Astro.props;

const { pathname } = Astro.url;
---

<nav aria-label="Explore" data-nosnippet {...props}>
	<h2 class="font-display text-sm font-bold tracking-wide text-accent-400 uppercase">Explore</h2>
	<ul class="mt-3">
		{
			menuFooterItems.map((item) => (
				<li>
					<a
						aria-current={isActiveMenuPath(item.url, pathname) ? 'page' : undefined}
						class="text-ink-400 hover:text-ink-300"
						href={item.url}
					>
						{item.title}
					</a>
				</li>
			))
		}
	</ul>
</nav>
