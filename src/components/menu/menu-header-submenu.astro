---
import type { HTMLAttributes } from 'astro/types';

import type { MenuItem } from '#components/menu/menu-types.ts';

import MenuHeaderSubmenuTrigger from '#components/menu/menu-header-submenu-trigger.astro';
import { MENU_DEPTH_MAX } from '#components/menu/menu-types.ts';
import { getMenuItemAriaLabel } from '#components/menu/menu-utils.ts';

interface Props extends HTMLAttributes<'ul'> {
	ariaLabel: string;
	depth: number;
	menuItems: Array<MenuItem>;
}

const { ariaLabel, depth, menuItems, ...props } = Astro.props;
---

<ul
	aria-label={ariaLabel}
	class:list={['nav-sub', depth === 1 ? 'nav-sub-d1' : 'nav-sub-d2']}
	{...props}
>
	{
		menuItems.map((item) => {
			const children = depth < MENU_DEPTH_MAX ? (item.children ?? []) : [];
			const hasChildren = children.length > 0;

			return (
				<li class="nav-sub-item">
					<MenuHeaderSubmenuTrigger hasChildren={hasChildren} item={item} />
					{hasChildren ? (
						<Astro.self
							ariaLabel={getMenuItemAriaLabel(item)}
							depth={depth + 1}
							menuItems={children}
						/>
					) : undefined}
				</li>
			);
		})
	}
</ul>
