---
import MenuNav from '#components/menu/menu-nav.astro';
import Search from '#components/search/search.astro';
import { site } from '#lib/site.ts';
---

<header
	class="maze bg-linear-to-t from-surface-800 to-transparent [--pattern-color:var(--color-surface-600)]"
>
	<div class="content-column flex flex-wrap items-center justify-between gap-4 py-8">
		<a
			class="font-display text-3xl font-bold tracking-tight text-highlight-500 hover:text-highlight-400"
			href="/"
		>
			{site.title}
		</a>
		<div class="flex flex-wrap items-center gap-3">
			<MenuNav />
			<Search />
		</div>
	</div>
</header>
