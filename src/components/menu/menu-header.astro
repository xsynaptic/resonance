---
import type { HTMLAttributes } from 'astro/types';

import MenuHeaderSubmenu from '#components/menu/menu-header-submenu.astro';
import MenuHeaderTrigger from '#components/menu/menu-header-trigger.astro';
import { menuHeaderItems } from '#components/menu/menu-header.ts';
import { getMenuItemAriaLabel } from '#components/menu/menu-utils.ts';

type Props = HTMLAttributes<'nav'>;

const props = Astro.props;
---

<menu-navigation>
	<nav aria-label="Primary" class="nav-menu" data-nosnippet {...props}>
		<ul class="nav-ul">
			{
				menuHeaderItems.map((item) => {
					const children = item.children ?? [];
					const hasChildren = children.length > 0;

					return (
						<li class="nav-item">
							<MenuHeaderTrigger hasChildren={hasChildren} item={item} />
							{hasChildren ? (
								<MenuHeaderSubmenu
									ariaLabel={getMenuItemAriaLabel(item)}
									depth={1}
									menuItems={children}
								/>
							) : undefined}
						</li>
					);
				})
			}
		</ul>
	</nav>
</menu-navigation>

<script>
	import '#components/menu/menu-navigation.ts';
</script>
