---
import MenuNav from '#components/menu/menu-nav.astro';
import { site } from '#lib/site.ts';
---

<header
	class="maze bg-linear-to-t from-surface-800 to-transparent [--pattern-color:var(--color-surface-600)]"
>
	<div class="content-column flex flex-wrap items-center justify-between gap-4 py-8">
		<a
			class="font-display text-3xl font-bold tracking-tight text-ink-50 hover:text-accent-400"
			href="/"
		>
			{site.title}
		</a>
		<MenuNav />
	</div>
</header>
