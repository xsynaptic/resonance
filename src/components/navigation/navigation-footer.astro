---
import type { HTMLAttributes } from 'astro/types';

import { navigationFooterItems } from '#components/navigation/navigation-footer.ts';
import Anchor from '#components/parts/anchor.astro';
import { t } from '#lib/i18n/i18n-strings.ts';

type Props = HTMLAttributes<'nav'>;

const props = Astro.props;
---

<nav aria-label={t('nav.footer.label')} {...props}>
	<h2 class="heading-label">{t('nav.footer.label')}</h2>
	<ul class="mt-3">
		{navigationFooterItems.map((item) => (
			<li>
				<Anchor anchorColor="muted" class="inline-block" href={item.url} rel={item.rel}>
					{item.title}
				</Anchor>
			</li>
		))}
	</ul>
</nav>
