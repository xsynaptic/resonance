---
import type { HTMLAttributes } from 'astro/types';

import type { NavigationItem } from '#components/navigation/navigation-types.ts';

import NavigationTrigger from '#components/navigation/navigation-trigger.astro';
import { navigationDepthMax } from '#components/navigation/navigation-types.ts';
import { getNavigationItemAriaLabel } from '#components/navigation/navigation-utils.ts';

interface Props extends HTMLAttributes<'ul'> {
	ariaLabel: string;
	depth: number;
	navigationItems: Array<NavigationItem>;
}

const { ariaLabel, depth, navigationItems, ...props } = Astro.props;
---

<ul
	aria-label={ariaLabel}
	class:list={['nav-sub', depth === 1 ? 'nav-sub-d1' : 'nav-sub-d2']}
	{...props}
>
	{navigationItems.map((item) => {
		const children = depth < navigationDepthMax ? (item.children ?? []) : [];
		const hasChildren = children.length > 0;

		return (
			<li class="nav-sub-item">
				<NavigationTrigger hasChildren={hasChildren} item={item} variant="submenu" />
				{hasChildren ? (
					<Astro.self
						ariaLabel={getNavigationItemAriaLabel(item)}
						depth={depth + 1}
						navigationItems={children}
					/>
				) : undefined}
			</li>
		);
	})}
</ul>
