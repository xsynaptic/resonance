---
import type { NavigationItem } from '#components/navigation/navigation-types.ts';

import {
	getNavigationItemAriaLabel,
	getNavigationItemTriggerType,
	isActiveNavigationItem,
	isCurrentNavigationPath,
} from '#components/navigation/navigation-utils.ts';

interface Props {
	hasChildren: boolean;
	item: NavigationItem;
}

const { hasChildren, item } = Astro.props;

const { pathname } = Astro.url;

const triggerType = getNavigationItemTriggerType(item);
---

<div
	class:list={['nav-trigger', isActiveNavigationItem(item, pathname) ? 'nav-current' : undefined]}
>
	{triggerType === 'anchor' ? (
		<a
			aria-current={isCurrentNavigationPath(item.url, pathname) ? 'page' : undefined}
			class="nav-link"
			href={item.url}
			{...(item.rel ? { rel: item.rel } : undefined)}
		>
			{item.title}
		</a>
	) : undefined}
	{triggerType === 'button' ? (
		<button class="nav-link" type="button">
			{item.title}
		</button>
	) : undefined}
	{triggerType === 'span' ? <span class="nav-link">{item.title}</span> : undefined}
	{hasChildren ? (
		<button
			aria-expanded="false"
			aria-label={getNavigationItemAriaLabel(item)}
			class="nav-toggle"
			data-nav-toggle
			type="button"
		>
			<svg aria-hidden="true" class="nav-icon">
				<use href="#icon:chevron-down" />
			</svg>
		</button>
	) : undefined}
</div>
