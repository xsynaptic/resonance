---
import type { HTMLAttributes } from 'astro/types';

import { renderSlot } from '#lib/utils/astro.ts';

type AnchorColor = 'highlight' | 'muted';

interface Props extends HTMLAttributes<'a'> {
	anchorColor?: AnchorColor | undefined;
}

const { anchorColor = 'highlight', class: className, href, ...props } = Astro.props;

const children = await renderSlot(Astro.slots, 'default');
---

<a class:list={['anchor', `anchor-${anchorColor}`, className]} href={href} {...props}
	><Fragment set:html={children} /></a
>
