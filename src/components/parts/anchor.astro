---
import type { HTMLAttributes } from 'astro/types';

import { renderSlot } from '#lib/utils/astro.ts';

type AnchorColor = 'highlight' | 'muted';

interface Props extends HTMLAttributes<'a'> {
	anchorColor?: AnchorColor | undefined;
	reload?: boolean | undefined;
}

// Prefetch ignores `data-astro-reload`, so a reload link opts out of prefetching separately
const { anchorColor = 'highlight', class: className, href, reload, ...props } = Astro.props;

const children = await renderSlot(Astro.slots, 'default');
---

<a
	class:list={['anchor', `anchor-${anchorColor}`, className]}
	data-astro-prefetch={reload ? 'false' : undefined}
	data-astro-reload={reload ? true : undefined}
	href={href}
	{...props}><Fragment set:html={children} /></a
>
