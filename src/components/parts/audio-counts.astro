---
import type { StringKey } from '#lib/i18n/i18n-strings.ts';

import CodaRow from '#components/parts/coda-row.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { formatNumber, formatStringTemplate } from '#lib/utils/text.ts';

interface Props {
	downloads?: number | undefined;
	listeningSeconds?: number | undefined;
	listens?: number | undefined;
	mixcloudPlays?: number | undefined;
	soundcloudPlays?: number | undefined;
	streams?: number | undefined;
}

const { downloads, listeningSeconds, listens, mixcloudPlays, soundcloudPlays, streams } =
	Astro.props;

function toDurationRow(unit: StringKey, count: number) {
	return {
		heading: t('audio.listeningTimeLabel'),
		value: formatStringTemplate(t(unit), { count: formatNumber({ number: count }) }),
	};
}

function toListeningTimeRow(seconds: number | undefined) {
	if (!seconds || seconds < 60) return;

	if (seconds < 3600) {
		const minutes = Math.floor(seconds / 60);

		return toDurationRow(minutes === 1 ? 'audio.minutes.one' : 'audio.minutes.other', minutes);
	}

	const hours = Math.round(seconds / 3600);

	return toDurationRow(hours === 1 ? 'audio.hours.one' : 'audio.hours.other', hours);
}

function toPlaysRow(heading: StringKey, value: number | undefined) {
	if (!value) return;

	return {
		heading: t(heading),
		value: formatStringTemplate(t(value === 1 ? 'audio.plays.one' : 'audio.plays.other'), {
			count: formatNumber({ number: value }),
		}),
	};
}

function toTotalRow(heading: StringKey, value: number | undefined) {
	if (!value) return;

	return { heading: t(heading), value: formatNumber({ number: value }) };
}

const rows = [
	toTotalRow('audio.downloadsLabel', downloads),
	toTotalRow('audio.listensLabel', listens),
	toListeningTimeRow(listeningSeconds),
	toTotalRow('audio.streamsLabel', streams),
	toPlaysRow('audio.mixcloud', mixcloudPlays),
	toPlaysRow('audio.soundcloud', soundcloudPlays),
].filter((row) => row !== undefined);
---

{rows.map((row) => (
	<CodaRow heading={row.heading}>
		<span class="text-ink-100">{row.value}</span>
	</CodaRow>
))}
