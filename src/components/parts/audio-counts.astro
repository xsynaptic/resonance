---
import type { StringKey } from '#lib/i18n/i18n-strings.ts';

import CodaRow from '#components/parts/coda-row.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { formatNumber, formatStringTemplate } from '#lib/utils/text.ts';

interface Props {
	downloads?: number | undefined;
	mixcloudPlays?: number | undefined;
	soundcloudPlays?: number | undefined;
	streams?: number | undefined;
}

const { downloads, mixcloudPlays, soundcloudPlays, streams } = Astro.props;

function toPlaysRow(heading: StringKey, value: number | undefined) {
	if (!value) return;

	return {
		heading: t(heading),
		value: formatStringTemplate(t(value === 1 ? 'audio.plays.one' : 'audio.plays.other'), {
			count: formatNumber({ number: value }),
		}),
	};
}

function toTotalRow(heading: StringKey, value: number | undefined) {
	if (!value) return;

	return { heading: t(heading), value: formatNumber({ number: value }) };
}

const rows = [
	toTotalRow('audio.downloadsLabel', downloads),
	toTotalRow('audio.streamsLabel', streams),
	toPlaysRow('audio.mixcloud', mixcloudPlays),
	toPlaysRow('audio.soundcloud', soundcloudPlays),
].filter((row) => row !== undefined);
---

{
	rows.map((row) => (
		<CodaRow heading={row.heading}>
			<span class="text-ink-300">{row.value}</span>
		</CodaRow>
	))
}
