---
import type { IconId } from '#lib/utils/icon-types.ts';

import ButtonSplit from '#components/parts/button-split.astro';
import Button from '#components/parts/button.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { downloadBaseUrl } from '#lib/site.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

interface Props {
	// Set only when the mix has timestamps; each file then gets a paired cue sheet link
	cueSlug?: string | undefined;
	files?: Array<string> | undefined;
	links?: Array<string> | undefined;
}

const { cueSlug, files, links } = Astro.props;

interface LinkMeta {
	icon?: IconId | undefined;
	label: string;
}

function getFileLabel(file: string): string {
	return file.slice(file.lastIndexOf('.') + 1).toUpperCase();
}

function getLinkMeta(url: string): LinkMeta {
	const { hostname } = new URL(url);

	if (hostname.endsWith('mixcloud.com')) return { icon: 'mixcloud', label: t('audio.mixcloud') };
	if (hostname.endsWith('soundcloud.com'))
		return { icon: 'soundcloud', label: t('audio.soundcloud') };

	return { label: hostname.replace(/^www\./, '') };
}

const hasLinks = links && links.length > 0;
const hasFiles = files && files.length > 0;
---

{hasLinks || hasFiles ? (
	<ul class="m-0 flex list-none flex-wrap gap-2 p-0" data-pagefind-ignore>
		{links?.map((link) => {
			const { icon, label } = getLinkMeta(link);

			return (
				<li class="m-0">
					<Button as="a" href={link} {...(icon ? { icon } : {})}>
						{label}
					</Button>
				</li>
			);
		})}
		{files?.map((file) => (
			<li class="m-0">
				<ButtonSplit>
					<Button as="a" href={`${downloadBaseUrl}${encodeURIComponent(file)}`} icon="download">
						{getFileLabel(file)}
					</Button>
					{cueSlug ? (
						<Button
							as="a"
							download={true}
							href={`/mixes/${cueSlug}/${encodeURIComponent(file)}.cue`}
							title={formatStringTemplate(t('audio.cueTitle'), { file })}
						>
							{t('audio.cue')}
						</Button>
					) : undefined}
				</ButtonSplit>
			</li>
		))}
	</ul>
) : undefined}
