---
import type { ResolvedRef } from '#lib/utils/terms.ts';

import DividedItem from '#components/parts/divided-item.astro';
import RefText from '#components/parts/ref-text.astro';
import { t } from '#lib/i18n/i18n-strings.ts';

interface Props {
	trail: Array<ResolvedRef>;
}

const { trail } = Astro.props;
---

<nav aria-label={t('nav.breadcrumb.label')} data-nosnippet data-pagefind-ignore>
	<ol class="title-eyebrow">
		{trail.map((breadcrumb) => (
			<DividedItem as="li" dividerContent="chevron">
				<RefText anchorColor="highlight" label={breadcrumb.label} url={breadcrumb.url} />
			</DividedItem>
		))}
	</ol>
</nav>
