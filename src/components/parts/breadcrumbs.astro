---
import type { LinkedName } from '#lib/utils/terms.ts';

import DividedItem from '#components/parts/divided-item.astro';
import LinkedNameText from '#components/parts/linked-name-text.astro';
import { t } from '#lib/i18n/i18n-strings.ts';

interface Props {
	trail: Array<LinkedName>;
}

const { trail } = Astro.props;
---

<div data-nosnippet>
	<nav aria-label={t('nav.breadcrumb.label')} data-pagefind-ignore>
		<ol class="title-eyebrow">
			{trail.map((breadcrumb) => (
				<DividedItem as="li" dividerContent="chevron">
					<LinkedNameText anchorColor="highlight" name={breadcrumb.name} url={breadcrumb.url} />
				</DividedItem>
			))}
		</ol>
	</nav>
</div>
