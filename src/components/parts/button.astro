---
import type { HTMLTag, Polymorphic } from 'astro/types';

import type { IconId } from '#lib/utils/icon-types.ts';

// Literal rather than interpolated, so the class family stays greppable
const variantClasses = {
	highlight: 'button-standard button-highlight',
	small: 'button-small',
	standard: 'button-standard',
} as const;

type Props<Tag extends Extract<HTMLTag, 'a' | 'button'> = 'button'> = Polymorphic<{
	as: Tag;
	icon?: IconId | undefined;
	variant?: keyof typeof variantClasses | undefined;
}>;

const {
	as: Tag = 'button',
	class: className,
	icon,
	type,
	variant = 'standard',
	...props
} = Astro.props;

let buttonType: 'button' | 'reset' | 'submit' | undefined;
if (Tag === 'button') buttonType = type === 'submit' || type === 'reset' ? type : 'button';
---

<Tag
	class:list={['button-x', 'prose-escape', variantClasses[variant], className]}
	type={buttonType}
	{...props}
>
	{icon ? (
		<svg aria-hidden="true" class="button-icon">
			<use href={`#icon:${icon}`} />
		</svg>
	) : undefined}
	<slot />
</Tag>
