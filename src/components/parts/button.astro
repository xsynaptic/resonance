---
import type { HTMLAttributes } from 'astro/types';

import type { IconId } from '#lib/utils/icon-types.ts';

type ButtonVariant = 'small' | 'standard';

interface Props extends HTMLAttributes<'button'> {
	icon?: IconId | undefined;
	variant?: ButtonVariant | undefined;
}

const { class: className, icon, type = 'button', variant = 'standard', ...props } = Astro.props;
---

<button
	class:list={['button-x', 'prose-escape', `button-${variant}`, className]}
	type={type}
	{...props}
>
	{
		icon ? (
			<svg aria-hidden="true" class="button-icon">
				<use href={`#icon:${icon}`} />
			</svg>
		) : undefined
	}
	<slot />
</button>
