---
import { t } from '#lib/i18n/i18n-strings.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

interface Props {
	label: string;
}

const { label } = Astro.props;
---

<carousel-slides class="carousel">
	<div class="carousel-controls">
		<button
			aria-label={formatStringTemplate(t('carousel.previous'), { label })}
			class="carousel-nav carousel-nav-prev"
			data-carousel-nav="prev"
			type="button"
		>
			<svg aria-hidden="true"><use href="#icon:chevron-left"></use></svg>
		</button>
		<button
			aria-label={formatStringTemplate(t('carousel.next'), { label })}
			class="carousel-nav carousel-nav-next"
			data-carousel-nav="next"
			type="button"
		>
			<svg aria-hidden="true"><use href="#icon:chevron-right"></use></svg>
		</button>
	</div>
	<ul class="carousel-track" data-carousel-track>
		<slot />
	</ul>
</carousel-slides>

<script>
	import '#components/parts/carousel.ts';
</script>
