---
import type { ContentCatalogItem } from '#lib/catalog/catalog-types.ts';

import EntryCard from '#components/parts/entry-card.astro';
import { collectionKinds } from '#lib/catalog/catalog-kind.ts';

interface Props {
	item: ContentCatalogItem;
	meta?: Array<'kind' | 'subtitle'> | undefined;
	priority?: boolean | undefined;
}

const { item, meta = ['subtitle'], priority = false } = Astro.props;
---

<li>
	<EntryCard
		date={item.date}
		href={item.url}
		image={item.image}
		kind={meta.includes('kind') ? collectionKinds[item.collection] : undefined}
		priority={priority}
		subtitle={meta.includes('subtitle') ? item.subtitle : undefined}
		title={item.title}
		work={item.work}
	/>
</li>
