---
import MediaImage from '#components/parts/media-image.astro';
import { formatDate } from '#lib/utils/date.ts';

interface Props {
	class?: string | undefined;
	date?: Date | undefined;
	href: string;
	image?: string | undefined;
	imageAspect?: '3/2' | 'square' | undefined;
	subtitle?: string | undefined;
	title: string;
}

const {
	class: className,
	date,
	href,
	image,
	imageAspect = 'square',
	subtitle,
	title,
} = Astro.props;

// Album artwork is square by default; opt into 3:2 per surface
const aspectClass = imageAspect === 'square' ? 'aspect-square' : 'aspect-[3/2]';
---

<div class:list={['h-full rounded-lg border border-surface-700 bg-surface-600 p-2', className]}>
	{/* The frame holds the card's shape when an original is missing, which is routine in dev */}
	{
		image ? (
			<a
				class:list={[
					'mb-2.5 block w-full overflow-hidden rounded-xs bg-surface-900 transition-opacity hover:opacity-85 focus-visible:opacity-85',
					aspectClass,
				]}
				href={href}
			>
				<MediaImage
					alt=""
					class="h-full w-full object-cover"
					layout="none"
					path={image}
					width={640}
				/>
			</a>
		) : undefined
	}
	<a
		class="block font-display text-xl font-bold text-ink-100 transition hover:text-ink-50 focus-visible:text-ink-50"
		href={href}>{title}</a
	>
	{subtitle ? <span class="mt-1 block text-sm text-ink-600">{subtitle}</span> : undefined}
	{
		date ? (
			<time class="mt-1 block text-xs text-ink-700" datetime={date.toISOString()}>
				{formatDate(date)}
			</time>
		) : undefined
	}
</div>
