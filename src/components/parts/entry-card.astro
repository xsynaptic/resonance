---
import type { LinkedName } from '#lib/utils/terms.ts';
import type { WorkTitle } from '#lib/utils/work-title.ts';

import LinkedNameText from '#components/parts/linked-name-text.astro';
import MediaImage from '#components/parts/media-image.astro';
import WorkTitleText from '#components/parts/work-title-text.astro';
import { formatDate } from '#lib/utils/date.ts';

interface Props {
	class?: string | undefined;
	date?: Date | undefined;
	href: string;
	image?: string | undefined;
	kind?: LinkedName | undefined;
	priority?: boolean | undefined;
	subtitle?: string | undefined;
	title: string;
	work?: undefined | WorkTitle;
}

const { class: className, date, href, image, kind, priority, subtitle, title, work } = Astro.props;

// The whole title is already a link and anchors cannot nest, so the Credit renders unlinked
const cardWork = work?.credit ? { credit: { name: work.credit.name }, title: work.title } : work;
---

<div class:list={['h-full rounded-lg border border-surface-700 bg-surface-600 p-2', className]}>
	<a
		aria-hidden="true"
		class="media-frame mb-2.5 block aspect-square w-full overflow-hidden rounded-xs transition-opacity hover:opacity-85"
		href={href}
		tabindex="-1"
	>
		{image ? (
			<MediaImage
				alt=""
				class="h-full w-full object-cover"
				path={image}
				sizes="auto, (min-width: 80rem) 288px, (min-width: 40rem) 50vw, 100vw"
				width={300}
				{...(priority ? { priority: true } : {})}
			/>
		) : undefined}
	</a>
	<a
		class="block font-display text-xl font-bold text-ink-100 transition hover:text-ink-50 focus-visible:text-ink-50"
		href={href}
	>
		{cardWork ? <WorkTitleText work={cardWork} /> : title}
	</a>
	{kind || subtitle ? (
		<span class="mt-1 block text-sm text-ink-600">
			{kind ? (
				<span class="font-bold text-highlight-500">
					<LinkedNameText anchorColor="highlight" name={kind.name} url={kind.url} />
				</span>
			) : undefined}
			{kind && subtitle ? (
				<span aria-hidden="true" class="mx-1">
					·
				</span>
			) : undefined}
			{subtitle}
		</span>
	) : undefined}
	{date ? (
		<time class="mt-1 block text-xs text-ink-700" datetime={date.toISOString()}>
			{formatDate(date)}
		</time>
	) : undefined}
</div>
