---
import MediaImage from '#components/parts/media-image.astro';
import { formatDate } from '#lib/utils/date.ts';
import { matchReleaseTitle } from '#lib/utils/entries.ts';

interface Props {
	class?: string | undefined;
	date?: Date | undefined;
	href: string;
	image?: string | undefined;
	priority?: boolean | undefined;
	releaseTitle?: string | undefined;
	subtitle?: string | undefined;
	title: string;
}

const {
	class: className,
	date,
	href,
	image,
	priority,
	releaseTitle,
	subtitle,
	title,
} = Astro.props;

const work = matchReleaseTitle(title, releaseTitle);
---

<div class:list={['h-full rounded-lg border border-surface-700 bg-surface-600 p-2', className]}>
	{image ? (
		<a
			aria-hidden="true"
			class="media-frame mb-2.5 block aspect-square w-full overflow-hidden rounded-xs bg-surface-900 transition-opacity hover:opacity-85"
			href={href}
			tabindex="-1"
		>
			<MediaImage
				alt=""
				class="h-full w-full object-cover"
				path={image}
				sizes="auto, (min-width: 80rem) 288px, (min-width: 40rem) 50vw, 100vw"
				width={300}
				{...(priority ? { priority: true } : {})}
			/>
		</a>
	) : undefined}
	<a
		class="block font-display text-xl font-bold text-ink-100 transition hover:text-ink-50 focus-visible:text-ink-50"
		href={href}
	>
		{work ? (
			<Fragment>
				{title.slice(0, -work.length)}
				<span class="font-semibold italic">{work}</span>
			</Fragment>
		) : (
			title
		)}
	</a>
	{subtitle ? <span class="mt-1 block text-sm text-ink-600">{subtitle}</span> : undefined}
	{date ? (
		<time class="mt-1 block text-xs text-ink-700" datetime={date.toISOString()}>
			{formatDate(date)}
		</time>
	) : undefined}
</div>
