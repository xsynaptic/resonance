---
import MediaFeatured from '#components/parts/media-featured.astro';
import { renderSlot } from '#lib/utils/astro.ts';

interface Props {
	alt: string;
	path?: string | undefined;
}

const { alt, path } = Astro.props;

const media = await renderSlot(Astro.slots, 'media');
const actions = await renderSlot(Astro.slots, 'actions');
const body = await renderSlot(Astro.slots, 'default');
const footer = await renderSlot(Astro.slots, 'footer');
---

<div class="featured-grid mt-4 sm:mt-6">
	{path ? (
		<div class="featured-grid-image">
			<MediaFeatured alt={alt} path={path} />
		</div>
	) : undefined}
	<div class="featured-grid-body">
		{media ? (
			<div class="mb-4">
				<Fragment set:html={media} />
			</div>
		) : undefined}
		{body ? (
			<div class="prose-x content-measure" data-pagefind-weight="2">
				<Fragment set:html={body} />
			</div>
		) : undefined}
		{actions ? (
			<div class="mt-8">
				<Fragment set:html={actions} />
			</div>
		) : undefined}
	</div>
	{footer ? (
		<div class="featured-grid-footer">
			<Fragment set:html={footer} />
		</div>
	) : undefined}
</div>
