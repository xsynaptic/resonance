---
import type { ComponentProps } from 'astro/types';

import Anchor from '#components/parts/anchor.astro';

interface Props {
	anchorColor?: ComponentProps<typeof Anchor>['anchorColor'];
	class?: string | undefined;
	name: string;
	url?: string | undefined;
}

const { anchorColor, class: className, name, url } = Astro.props;
---

{url ? (
	anchorColor ? (
		<Anchor anchorColor={anchorColor} class={className} href={url}>
			{name}
		</Anchor>
	) : (
		<a class:list={['anchor-x', className]} href={url}>
			{name}
		</a>
	)
) : (
	<span class={className}>{name}</span>
)}
