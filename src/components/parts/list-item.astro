---
import { Image } from 'astro:assets';

import type { ListItemValue } from '#lib/schemas/lists.ts';

import RefText from '#components/parts/ref-text.astro';
import { resolveSlugLink } from '#lib/utils/entries.ts';
import { renderMarkdown } from '#lib/utils/markdown.ts';
import { getMediaImage } from '#lib/utils/media.ts';
import { resolveRefs, resolveRefUrl } from '#lib/utils/terms.ts';

type Props = ListItemValue;

const {
	artist,
	artistId,
	description,
	imageFeatured,
	labels,
	link,
	linkDiscogs,
	linkId,
	linkSource,
	linkYoutubeSearch,
	releaseType,
	title,
	year,
} = Astro.props;

const reviewLink = linkId ? await resolveSlugLink(linkId) : undefined;
const titleHref = reviewLink?.url ?? link;
const image = imageFeatured ? getMediaImage(imageFeatured) : undefined;

// Artist links when its sibling id resolves, labels when the ref carries one; year stays plain
const artistUrl = await resolveRefUrl('artists', artistId);
const metaParts: Array<{ label: string; url?: string | undefined }> = [];
if (artist) metaParts.push({ label: artist, url: artistUrl });
if (year) metaParts.push({ label: String(year) });
metaParts.push(...(await resolveRefs('labels', labels)));
const descriptionHtml = description ? await renderMarkdown(description) : undefined;
const youtubeSearch =
	linkYoutubeSearch && (artist ?? title)
		? `https://www.youtube.com/results?search_query=${encodeURIComponent([artist, title].filter(Boolean).join(' '))}`
		: undefined;
---

<li class="c-list-item flex gap-4" data-release-type={releaseType}>
	{
		image ? (
			<Image
				alt={title}
				class="h-20 w-20 shrink-0 rounded object-cover"
				height={80}
				src={image}
				width={80}
			/>
		) : undefined
	}
	<div class="min-w-0">
		<div class="font-medium text-ink-100">
			{
				titleHref ? (
					<a class="text-accent-400 hover:text-accent-300" href={titleHref}>
						{title}
					</a>
				) : (
					title
				)
			}
		</div>
		{
			metaParts.length > 0 ? (
				<div class="text-sm text-ink-500">
					{metaParts.map((part, index) => (
						<Fragment>
							{index > 0 ? ' · ' : ''}
							<RefText label={part.label} url={part.url} />
						</Fragment>
					))}
				</div>
			) : undefined
		}
		{descriptionHtml ? <div class="prose-x mt-1 text-sm" set:html={descriptionHtml} /> : undefined}
		{
			linkSource || linkDiscogs || youtubeSearch ? (
				<div class="mt-1 flex gap-3 text-xs">
					{linkSource ? (
						<a class="text-accent-400 hover:text-accent-300" href={linkSource}>
							Download
						</a>
					) : undefined}
					{linkDiscogs ? (
						<a class="text-accent-400 hover:text-accent-300" href={linkDiscogs}>
							Discogs
						</a>
					) : undefined}
					{youtubeSearch ? (
						<a class="text-accent-400 hover:text-accent-300" href={youtubeSearch}>
							YouTube
						</a>
					) : undefined}
				</div>
			) : undefined
		}
	</div>
</li>
