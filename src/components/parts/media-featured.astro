---
import MediaImage from '#components/parts/media-image.astro';
import { getMediaImage } from '#lib/utils/media.ts';

interface Props {
	alt: string;
	path: string;
}

const { alt, path } = Astro.props;

// A failed image sizes to its alt text inside the fitted figure, so the frame holds the width
// 556px is 36rem less the mat; the figure itself only caps at its column
const frameWidth = Math.min(556, getMediaImage(path)?.width ?? 556);
---

<figure class="content-bleed bg-surface-600 sm:w-fit sm:max-w-full sm:rounded-md sm:p-2.5">
	<div
		class="media-frame block w-full max-w-full overflow-hidden sm:w-(--media-featured-width) sm:rounded-sm"
		style={`--media-featured-width: ${frameWidth}px`}
	>
		<MediaImage
			alt={alt}
			class="block w-full"
			path={path}
			priority={true}
			sizes="(min-width: 64rem) 35rem, (min-width: 40rem) 32rem, 100vw"
			width={560}
		/>
	</div>
</figure>
