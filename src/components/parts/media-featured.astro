---
import MediaImage from '#components/parts/media-image.astro';

interface Props {
	alt: string;
	path: string;
}

const { alt, path } = Astro.props;
---

<figure class="w-fit max-w-xl rounded-md bg-surface-800 p-2.5">
	<MediaImage
		alt={alt}
		class="block rounded-sm"
		path={path}
		sizes="(min-width: 64rem) 35rem, (min-width: 40rem) 32rem, 100vw"
		width={928}
	/>
</figure>
