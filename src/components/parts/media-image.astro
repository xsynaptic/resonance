---
import { Image } from 'astro:assets';

import { getMediaImage, getMediaLqip } from '#lib/utils/media.ts';

interface Props {
	alt: string;
	class?: string | undefined;
	layout?: 'constrained' | 'full-width' | 'none' | undefined;
	path: string;
	priority?: boolean | undefined;
	sizes?: string | undefined;
	width: number;
}

const { alt, class: className, layout = 'constrained', path, priority, sizes, width } = Astro.props;

const image = getMediaImage(path);

// astro:assets upscales whatever width it is handed; most source artwork is only ~600px wide
const intrinsicWidth = image ? Math.min(width, image.width) : width;

const lqip = getMediaLqip(path);
---

{image ? (
	<Image
		alt={alt}
		class:list={[className, lqip ? 'bg-cover bg-center text-transparent' : undefined]}
		layout={layout}
		priority={priority ?? false}
		src={image}
		width={intrinsicWidth}
		{...(lqip ? { style: `background-image:url(${lqip})` } : {})}
		{...(sizes ? { sizes } : {})}
	/>
) : undefined}
