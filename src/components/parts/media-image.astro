---
import { Image } from 'astro:assets';

import { getMediaImage } from '#lib/utils/media.ts';

interface Props {
	alt: string;
	class?: string | undefined;
	layout?: 'constrained' | 'none' | undefined;
	path: string;
	priority?: boolean | undefined;
	sizes?: string | undefined;
	width: number;
}

const { alt, class: className, layout = 'constrained', path, priority, sizes, width } = Astro.props;

const image = getMediaImage(path);

// astro:assets upscales whatever width it is handed; most source artwork is only ~600px wide
const intrinsicWidth = image ? Math.min(width, image.width) : width;
---

{
	image ? (
		<Image
			alt={alt}
			layout={layout}
			priority={priority ?? false}
			src={image}
			width={intrinsicWidth}
			{...(className ? { class: className } : {})}
			{...(sizes ? { sizes } : {})}
		/>
	) : undefined
}
