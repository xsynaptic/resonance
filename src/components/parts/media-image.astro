---
import { getPlaceholder } from '@xsynaptic/astro-image-pipeline/node';
import { Image } from 'astro:assets';

import { getMediaImage } from '#lib/utils/media.ts';

interface Props {
	alt: string;
	class?: string | undefined;
	layout?: 'constrained' | 'full-width' | 'none' | undefined;
	path: string;
	priority?: boolean | undefined;
	sizes?: string | undefined;
	width: number;
}

const {
	alt,
	class: className,
	layout = 'constrained',
	path,
	priority = false,
	sizes,
	width,
} = Astro.props;

const image = getMediaImage(path);

// astro:assets upscales whatever width it is handed; most source artwork is only ~600px wide
const intrinsicWidth = image ? Math.min(width, image.width) : width;

const placeholder = image
	? await getPlaceholder({ height: image.height, id: path, width: image.width })
	: undefined;
---

{image ? (
	<Image
		alt={alt}
		class:list={[className, placeholder ? 'bg-cover bg-center text-transparent' : undefined]}
		layout={layout}
		priority={priority}
		src={image}
		width={intrinsicWidth}
		{...(placeholder ? { style: `background-image:url(${placeholder})` } : {})}
		{...(sizes ? { sizes } : {})}
	/>
) : undefined}
