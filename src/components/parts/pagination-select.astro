---
import type { Page } from 'astro';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'nav'> {
	page: Page;
}

const { class: className, page, ...props } = Astro.props;

const { currentPage, lastPage, url } = page;

// Root-relative base for client-built URLs: strip the trailing slash and page number, re-add slash
const trimmed = url.current.replace(/\/$/, '');
const pageBasePath = `${
	currentPage === 1 ? trimmed : trimmed.replace(new RegExp(`/${String(currentPage)}$`), '')
}/`;
---

{
	lastPage > 1 ? (
		<pagination-select
			class="block"
			data-base-path={pageBasePath}
			data-current-page={String(currentPage)}
			data-last-page={String(lastPage)}
		>
			<nav
				aria-label="Pagination"
				class:list={[
					'flex items-center justify-between gap-4 text-sm font-medium tabular-nums select-none',
					className,
				]}
				{...props}
			>
				<div class="flex items-center">
					<span class="text-ink-500" data-pagination-counter>
						Page {currentPage} of {lastPage}
					</span>
					<form class="relative flex items-center" data-pagination-form hidden>
						<span class="relative inline-flex items-center">
							<select
								aria-label="Go to page"
								class="p-control rounded-sm border border-surface-600 bg-surface-800 py-1 pr-7 pl-2 text-ink-100 transition-colors hover:border-surface-500 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-highlight-500"
								data-pagination-control
							/>
							<span
								aria-hidden="true"
								class="p-arrow pointer-events-none absolute flex items-center text-highlight-500"
							>
								<svg
									fill="none"
									height="16"
									stroke="currentColor"
									stroke-width="2"
									viewBox="0 0 24 24"
									width="16"
								>
									<path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</span>
						</span>
						<button
							class="p-button ml-2 cursor-pointer rounded px-2 py-1 font-medium text-highlight-500 hover:text-highlight-400 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-highlight-500"
							data-pagination-submit
							type="submit"
						>
							Go
						</button>
					</form>
				</div>
				<div class="flex items-center gap-6">
					{url.prev ? (
						<span class="flex flex-wrap gap-1">
							<span class="text-highlight-500 select-none">&lsaquo;</span>
							<a
								aria-label="Previous page"
								class="text-highlight-500 transition-colors hover:text-highlight-400"
								href={url.prev}
							>
								Previous
							</a>
						</span>
					) : undefined}
					{url.next ? (
						<span class="flex flex-wrap gap-1">
							<a
								aria-label="Next page"
								class="text-highlight-500 transition-colors hover:text-highlight-400"
								href={url.next}
							>
								Next
							</a>
							<span class="text-highlight-500 select-none">&rsaquo;</span>
						</span>
					) : undefined}
				</div>
			</nav>
		</pagination-select>
	) : undefined
}

<script>
	import '#components/parts/pagination-select.ts';
</script>
