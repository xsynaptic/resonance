---
import type { Page } from 'astro';
import type { HTMLAttributes } from 'astro/types';

import Anchor from '#components/parts/anchor.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

interface Props extends HTMLAttributes<'nav'> {
	page: Page;
}

const { class: className, page, ...props } = Astro.props;

const { currentPage, lastPage, url } = page;

// Root-relative base for client-built URLs: strip the trailing slash and page number, re-add slash
const trimmed = url.current.replace(/\/$/, '');
const pageBasePath = `${
	currentPage === 1 ? trimmed : trimmed.replace(new RegExp(`/${String(currentPage)}$`), '')
}/`;
---

{
	lastPage > 1 ? (
		<pagination-select
			class="block"
			data-base-path={pageBasePath}
			data-current-page={String(currentPage)}
			data-last-page={String(lastPage)}
			data-nosnippet
			data-page-label={t('pagination.pageNumber')}
			data-pagefind-ignore
		>
			<nav
				aria-label={t('pagination.label')}
				class:list={[
					'flex items-center justify-between gap-4 text-sm font-medium tabular-nums select-none',
					className,
				]}
				{...props}
			>
				<div class="flex items-center">
					<span class="text-ink-500" data-pagination-counter>
						{formatStringTemplate(t('pagination.counter'), {
							current: currentPage,
							total: lastPage,
						})}
					</span>
					<form class="relative flex items-center" data-pagination-form hidden>
						<span class="relative inline-flex items-center">
							<select
								aria-label={t('pagination.selectLabel')}
								class="pg-control rounded-sm border border-surface-700 bg-surface-600 py-1 pr-7 pl-2 text-ink-100 transition-colors hover:border-surface-400 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-highlight-500"
								data-pagination-control
								name="page"
							/>
							<span
								aria-hidden="true"
								class="pg-arrow pointer-events-none absolute flex items-center text-highlight-500"
							>
								<svg
									fill="none"
									height="16"
									stroke="currentColor"
									stroke-width="2"
									viewBox="0 0 24 24"
									width="16"
								>
									<path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</span>
						</span>
						<button
							class="pg-button ml-2 cursor-pointer rounded px-2 py-1 font-medium text-highlight-500 hover:text-highlight-400 focus-visible:text-highlight-400 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-highlight-500"
							data-pagination-submit
							type="submit"
						>
							{t('pagination.submit')}
						</button>
					</form>
				</div>
				<div class="flex items-center gap-6">
					{url.prev ? (
						<span class="flex flex-wrap gap-1">
							<span class="text-highlight-500 select-none">&lsaquo;</span>
							<Anchor aria-label={t('pagination.previousPage')} href={url.prev}>
								{t('pagination.previous')}
							</Anchor>
						</span>
					) : undefined}
					{url.next ? (
						<span class="flex flex-wrap gap-1">
							<Anchor aria-label={t('pagination.nextPage')} href={url.next}>
								{t('pagination.next')}
							</Anchor>
							<span class="text-highlight-500 select-none">&rsaquo;</span>
						</span>
					) : undefined}
				</div>
			</nav>
		</pagination-select>
	) : undefined
}

<script>
	import '#components/parts/pagination-select.ts';
</script>
