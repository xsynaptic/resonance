---
// Renders a resolved reference: a link when a url is present, plain text otherwise
interface Props {
	class?: string | undefined;
	label: string;
	url?: string | undefined;
}

const { class: className, label, url } = Astro.props;
---

{
	url ? (
		<a class:list={['text-highlight-500 hover:text-highlight-400', className]} href={url}>
			{label}
		</a>
	) : (
		<span class={className}>{label}</span>
	)
}
