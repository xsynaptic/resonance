---
import type { ResolvedSelection } from '#lib/collections/selections/selections-resolve.ts';
import type { IconId } from '#lib/utils/icon-types.ts';

import Button from '#components/parts/button.astro';
import LinkedNameList from '#components/parts/linked-name-list.astro';
import MediaImage from '#components/parts/media-image.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { renderSlot } from '#lib/utils/astro.ts';
import { getLinkSourceLabel } from '#lib/utils/links.ts';

interface Props {
	rank?: number | undefined;
	selection: ResolvedSelection;
}

interface SelectionLink {
	href: string;
	icon?: IconId | undefined;
	label: string;
}

const { rank, selection } = Astro.props;
const { anchor, artists, discogsUrl, href, imagePath, labels, linkYoutube, title, year } =
	selection;

// Every outbound link on a selection is a place to get the release, so all of them read as one
const buttons: Array<SelectionLink> = selection.links.map((url) => ({
	href: url,
	icon: 'download' as const,
	label: getLinkSourceLabel(url),
}));

if (discogsUrl) buttons.push({ href: discogsUrl, label: 'Discogs' });
if (linkYoutube) buttons.push({ href: linkYoutube, icon: 'youtube', label: 'YouTube' });

const body = await renderSlot(Astro.slots);

// A row carrying prose takes a heading and the wider spacing; a bare credits line stays tight
const hasProse = body !== undefined;
const Heading = hasProse ? 'h3' : 'div';

const hasMeta = labels.length > 0 || Boolean(year);
const yearText = year && labels.length > 0 ? `, ${year}` : (year ?? '');
---

<li class:list={['selection-item', hasProse && 'selection-prose']} id={anchor}>
	{imagePath ? (
		<figure class="selection-thumb">
			<MediaImage
				alt={title}
				class="rounded-sm"
				path={imagePath}
				sizes="(width >= 64rem) 360px, (width >= 40rem) 40vw, 100vw"
				width={360}
			/>
		</figure>
	) : undefined}
	<Heading class="selection-header">
		{rank ? <span class="selection-rank">{rank}</span> : undefined}
		<span>
			{artists.length > 0 ? (
				<Fragment>
					<span class="selection-artist">
						<LinkedNameList names={artists} />
					</span>
					<span class="selection-divider"> - </span>
				</Fragment>
			) : undefined}
			<span class="selection-title">{href ? <a href={href}>{title}</a> : title}</span>
		</span>
	</Heading>
	{hasMeta ? (
		<div class="selection-meta">
			<LinkedNameList names={labels} />
			{yearText}
		</div>
	) : undefined}
	{body ? <div class="selection-description" set:html={body} /> : undefined}
	{buttons.length > 0 ? (
		<div class="selection-links">
			<span>{t('section.selection.links')}</span>
			{buttons.map((button) => (
				<Button
					as="a"
					href={button.href}
					variant="small"
					{...(button.icon ? { icon: button.icon } : {})}
				>
					{button.label}
				</Button>
			))}
		</div>
	) : undefined}
</li>
