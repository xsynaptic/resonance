---
interface Props {
	terms: Array<Term>;
}

interface Term {
	title: string;
	url: string;
}

const { terms } = Astro.props;
---

<ul class="flex flex-wrap gap-x-4 gap-y-2">
	{
		terms.map((term) => (
			<li>
				<a class="text-highlight-500 hover:text-highlight-400" href={term.url}>
					{term.title}
				</a>
			</li>
		))
	}
</ul>
