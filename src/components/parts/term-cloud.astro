---
import Anchor from '#components/parts/anchor.astro';

interface Props {
	terms: Array<Term>;
}

interface Term {
	title: string;
	url: string;
}

const { terms } = Astro.props;
---

<ul class="flex flex-wrap gap-x-4 gap-y-2">
	{
		terms.map((term) => (
			<li>
				<Anchor href={term.url}>{term.title}</Anchor>
			</li>
		))
	}
</ul>
