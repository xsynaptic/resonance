---
import type { ResolvedRef } from '#lib/utils/terms.ts';

interface Props {
	heading: string;
	terms: Array<ResolvedRef>;
}

const { heading, terms } = Astro.props;
---

{
	terms.length > 0 ? (
		<div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm">
			<span class="font-medium text-ink-500">{heading}:</span>
			{terms.map((term) =>
				term.url ? (
					<a class="text-accent-400 hover:text-accent-300" href={term.url}>
						{term.label}
					</a>
				) : (
					<span class="text-ink-300">{term.label}</span>
				),
			)}
		</div>
	) : undefined
}
