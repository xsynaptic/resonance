---
import { PlayerIsland } from '#components/player/player-island.tsx';
import { getPlayerLabels, skipSeconds } from '#components/player/player-labels.ts';
import { isPlayerEnabled, isPlayerOverlayEnabled } from '#lib/site.ts';

const labels = getPlayerLabels();
---

{isPlayerEnabled ? (
	<PlayerIsland
		client:idle
		isOverlayEnabled={isPlayerOverlayEnabled}
		labels={labels}
		skipSeconds={skipSeconds}
		transition:persist="player"
	/>
) : undefined}
