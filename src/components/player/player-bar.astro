---
import { getPlayerLabels, seekSeconds } from '#components/player/player-labels.ts';
import { getPlayerLibraryUrl } from '#lib/collections/mixes/mixes-library.ts';
import playerStylesheetUrl from '#styles/player.css?url';

// Escaped so no label can close the script early
const config = JSON.stringify({
	labels: getPlayerLabels(),
	libraryUrl: await getPlayerLibraryUrl(),
	seekSeconds,
	stylesheetUrl: playerStylesheetUrl,
}).replaceAll('<', String.raw`\u003c`);
---

<div data-pzm-host transition:persist="player">
	<script is:inline set:html={config} type="application/json"></script>
</div>
<script>
	import { startAstroPlayer } from '@xsynaptic/plazmoid-player/astro';

	import { configurePlayer } from '#components/player/player-host.ts';

	startAstroPlayer(configurePlayer);
</script>
