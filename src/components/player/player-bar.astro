---
import { PlayerIsland } from '#components/player/player-island.tsx';
import { getPlayerLabels, seekSeconds } from '#components/player/player-labels.ts';
import { isPlayerEnabled, isPlayerOverlayEnabled } from '#lib/site.ts';
import playerStylesheetUrl from '#styles/player.css?url';

const labels = getPlayerLabels();
---

{isPlayerEnabled ? (
	<PlayerIsland
		client:player={playerStylesheetUrl}
		isOverlayEnabled={isPlayerOverlayEnabled}
		labels={labels}
		seekSeconds={seekSeconds}
		transition:persist="player"
	/>
) : undefined}
