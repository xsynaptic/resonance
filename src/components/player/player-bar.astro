---
import { getPlayerLabels, seekSeconds } from '#components/player/player-labels.ts';
import { isPlayerScopeEnabled } from '#lib/site.ts';
import playerStylesheetUrl from '#styles/player.css?url';

// Escaped so no label can close the script early
const config = JSON.stringify({
	isScopeEnabled: isPlayerScopeEnabled,
	labels: getPlayerLabels(),
	seekSeconds,
	stylesheetUrl: playerStylesheetUrl,
}).replaceAll('<', String.raw`\u003c`);
---

<div data-player-host transition:persist="player">
	<script is:inline set:html={config} type="application/json"></script>
</div>
<script>
	import { startPlayer } from '#components/player/player-host.ts';

	startPlayer();
	document.addEventListener('astro:page-load', startPlayer);
</script>
