---
import ButtonSplit from '#components/parts/button-split.astro';
import Button from '#components/parts/button.astro';
import { t } from '#lib/i18n/i18n-strings.ts';

interface Props {
	itemId: string;
}

const { itemId } = Astro.props;

// One button carries both verbs, so focus survives the swap; the island's row state picks which shows
// The queue half only adds; a Mix comes off the Playlist in the tray
---

<div data-nosnippet data-pagefind-ignore data-track-id={itemId}>
	<ButtonSplit>
		<Button data-play-track={itemId}>
			<span class="player-controls-play">
				<svg aria-hidden="true" class="button-icon">
					<use href="#icon:play"></use>
				</svg>
				{t('player.play')}
			</span>
			<span class="player-controls-pause">
				<svg aria-hidden="true" class="button-icon">
					<use href="#icon:pause"></use>
				</svg>
				{t('player.pause')}
			</span>
		</Button>
		<Button data-queue-track={itemId}>{t('player.queue')}</Button>
	</ButtonSplit>
</div>
