---
import Button from '#components/parts/button.astro';
import { t } from '#lib/i18n/i18n-strings.ts';

interface Props {
	trackId: string;
}

const { trackId } = Astro.props;
---

<div class="mb-4" data-track-id={trackId}>
	<Button data-play-track={trackId} icon="play">{t('player.play')}</Button>
</div>
