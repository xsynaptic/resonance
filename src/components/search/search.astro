---
import type { HTMLAttributes } from 'astro/types';

import { pagefindResultTemplate } from '#components/search/search-result-template.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import pagefindCssUrl from '#styles/pagefind-component.css?url';

type Props = HTMLAttributes<'div'>;

const { class: className, ...props } = Astro.props;

const bundlePath = `${import.meta.env.BASE_URL}pagefind/`;
---

<script>
	import '#components/search/search-toggle.ts';

	// Pagefind cannot deregister, so search-toggle would keep opening the first page's detached modal
	document.addEventListener('astro:before-swap', () => {
		const modal = document.querySelector('pagefind-modal') as
			| (Element & {
					instance?: {
						components: Array<unknown>;
						componentsByType: Record<string, Array<unknown>>;
					};
			  })
			| null;
		const instance = modal?.instance;

		if (instance) {
			instance.components = [];
			instance.componentsByType = {};
		}
	});
</script>

<pagefind-config bundle-path={bundlePath} preload={false}></pagefind-config>

<search-toggle
	class:list={['flex cursor-pointer items-center justify-center', className]}
	data-pagefind-css-url={pagefindCssUrl}
	data-shortcut-description={t('search.shortcut.description')}
	{...props}
>
	<button
		aria-expanded="false"
		aria-haspopup="dialog"
		aria-label={t('search.toggle.label')}
		class="text-ink-600 transition-colors hover:text-highlight-400 focus-visible:text-highlight-400"
		title={t('search.toggle.title')}
	>
		<svg aria-hidden="true" class="size-5">
			<use href="#icon:magnifying-glass"></use>
		</svg>
	</button>
</search-toggle>
<pagefind-modal data-nosnippet reset-on-close={true}>
	<pagefind-modal-header>
		<pagefind-input placeholder={t('search.input.placeholder')}></pagefind-input>
	</pagefind-modal-header>
	<pagefind-modal-body>
		<pagefind-summary></pagefind-summary>
		<pagefind-results max-sub-results="3" set:html={pagefindResultTemplate} show-images={true} />
	</pagefind-modal-body>
	<pagefind-modal-footer>
		<pagefind-keyboard-hints></pagefind-keyboard-hints>
	</pagefind-modal-footer>
</pagefind-modal>
