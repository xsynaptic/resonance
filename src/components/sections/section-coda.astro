---
import { renderSlot } from '#lib/utils/astro.ts';

interface Props {
	class?: string | undefined;
}

const { class: className } = Astro.props;

const content = await renderSlot(Astro.slots);
---

{
	content ? (
		<div
			class:list={[
				'content-bleed space-y-2 border-y border-surface-700 bg-surface-600 content-bleed-inset py-4 text-sm sm:rounded-lg sm:border sm:px-5',
				className,
			]}
			data-nosnippet
			data-pagefind-ignore
		>
			<Fragment set:html={content} />
		</div>
	) : undefined
}
