---
import type { LinkedName } from '#lib/utils/terms.ts';

import Breadcrumbs from '#components/parts/breadcrumbs.astro';
import DividedItem from '#components/parts/divided-item.astro';
import LinkedNameList from '#components/parts/linked-name-list.astro';
import LinkedNameText from '#components/parts/linked-name-text.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { formatDate } from '#lib/utils/date.ts';

const headerStyleLimit = 3;

interface Props {
	artist?: LinkedName | undefined;
	breadcrumbTrail?: Array<LinkedName> | undefined;
	date?: Date | undefined;
	kind?: LinkedName | undefined;
	labels?: Array<LinkedName> | undefined;
	releaseTitle?: string | undefined;
	releaseYear?: string | undefined;
	styles?: Array<LinkedName> | undefined;
	title: string;
}

const { artist, breadcrumbTrail, date, kind, labels, releaseTitle, releaseYear, styles, title } =
	Astro.props;

// Frontmatter order is the author's own ranking; the coda carries the rest, sorted by content count
const styleTerms = (styles ?? []).slice(0, headerStyleLimit);
const releaseLabels = labels ?? [];
const hasRelease = Boolean(releaseYear) || releaseLabels.length > 0;
const releaseLead = t(releaseLabels.length > 0 ? 'detail.releasedBy' : 'detail.released');
const releaseYearText =
	releaseYear && releaseLabels.length > 0 ? `, ${releaseYear}` : (releaseYear ?? '');
---

<header>
	{breadcrumbTrail && breadcrumbTrail.length > 0 ? (
		<Breadcrumbs trail={breadcrumbTrail} />
	) : undefined}
	{styleTerms.length > 0 ? (
		<div class="title-eyebrow">
			{styleTerms.map((term) => (
				<DividedItem as="span">
					<LinkedNameText anchorColor="highlight" name={term.name} url={term.url} />
				</DividedItem>
			))}
		</div>
	) : undefined}
	<h1 class="title-main">
		{releaseTitle ? (
			<Fragment>
				{artist ? (
					<Fragment>
						<LinkedNameText name={artist.name} url={artist.url} />
						<span class="title-divider"> - </span>
					</Fragment>
				) : undefined}
				<span class="font-semibold italic">{releaseTitle}</span>
			</Fragment>
		) : (
			title
		)}
	</h1>
	{kind || hasRelease || date ? (
		<div class="title-meta">
			{kind ? (
				<DividedItem as="span" dividerContent="slash">
					<span class="title-kind">
						<LinkedNameText anchorColor="highlight" name={kind.name} url={kind.url} />
					</span>
				</DividedItem>
			) : undefined}
			{hasRelease ? (
				<DividedItem as="span" dividerContent="slash">
					{releaseLead}
					<LinkedNameList names={releaseLabels} />
					{releaseYearText}
				</DividedItem>
			) : undefined}
			{date ? (
				<DividedItem as="span" dividerContent="slash">
					{t('detail.posted')}
					<time datetime={date.toISOString()}>{formatDate(date)}</time>
				</DividedItem>
			) : undefined}
		</div>
	) : undefined}
</header>
