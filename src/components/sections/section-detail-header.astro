---
import type { LinkedName } from '#lib/utils/terms.ts';
import type { WorkTitle } from '#lib/utils/work-title.ts';

import Breadcrumbs from '#components/parts/breadcrumbs.astro';
import DividedItem from '#components/parts/divided-item.astro';
import LinkedNameList from '#components/parts/linked-name-list.astro';
import LinkedNameText from '#components/parts/linked-name-text.astro';
import WorkTitleText from '#components/parts/work-title-text.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
import { formatDate } from '#lib/utils/date.ts';

const headerStyleLimit = 3;

interface Props {
	breadcrumbTrail?: Array<LinkedName> | undefined;
	date?: Date | undefined;
	kind?: LinkedName | undefined;
	labels?: Array<LinkedName> | undefined;
	releaseYear?: string | undefined;
	styles?: Array<LinkedName> | undefined;
	title: string | WorkTitle;
}

const { breadcrumbTrail, date, kind, labels, releaseYear, styles, title } = Astro.props;

// Frontmatter order is the author's own ranking; the coda carries the rest, sorted by content count
const styleTerms = (styles ?? []).slice(0, headerStyleLimit);
const labelTerms = labels ?? [];
const hasReleasedLine = Boolean(releaseYear) || labelTerms.length > 0;
const releasedLead = t(labelTerms.length > 0 ? 'detail.releasedBy' : 'detail.released');
const hasBreadcrumbs = breadcrumbTrail !== undefined && breadcrumbTrail.length > 0;
const hasMeta = Boolean(kind) || hasReleasedLine || Boolean(date);
const releasedYearText =
	releaseYear && labelTerms.length > 0 ? `, ${releaseYear}` : (releaseYear ?? '');
---

<header>
	{hasBreadcrumbs ? <Breadcrumbs trail={breadcrumbTrail} /> : undefined}
	{styleTerms.length > 0 ? (
		<div class="title-eyebrow">
			{styleTerms.map((term) => (
				<DividedItem as="div">
					<LinkedNameText anchorColor="highlight" name={term.name} url={term.url} />
				</DividedItem>
			))}
		</div>
	) : undefined}
	<h1 class="title-main">{typeof title === 'string' ? title : <WorkTitleText work={title} />}</h1>
	{hasMeta ? (
		<div class="title-meta">
			{kind ? (
				<DividedItem as="div" dividerContent="slash">
					<span class="title-kind">
						<LinkedNameText anchorColor="highlight" name={kind.name} url={kind.url} />
					</span>
				</DividedItem>
			) : undefined}
			{hasReleasedLine ? (
				<DividedItem as="div" dividerContent="slash">
					<span data-pagefind-ignore>{releasedLead}</span>
					<LinkedNameList names={labelTerms} />
					{releasedYearText}
				</DividedItem>
			) : undefined}
			{date ? (
				<DividedItem as="div" dividerContent="slash">
					<span data-pagefind-ignore>{t('detail.posted')}</span>
					<time data-pagefind-ignore datetime={date.toISOString()}>
						{formatDate(date)}
					</time>
				</DividedItem>
			) : undefined}
		</div>
	) : undefined}
</header>
