---
import type { LinkedName } from '#lib/utils/terms.ts';

import MediaImage from '#components/parts/media-image.astro';
import SectionDetailHeader from '#components/sections/section-detail-header.astro';

interface Props {
	breadcrumbTrail?: Array<LinkedName> | undefined;
	date?: Date | undefined;
	kind?: LinkedName | undefined;
	path: string;
	styles?: Array<LinkedName> | undefined;
	title: string;
}

const { breadcrumbTrail, date, kind, path, styles, title } = Astro.props;
---

<div class="hero">
	<MediaImage alt={title} layout="none" path={path} priority sizes="100vw" width={1600} />
	<div class="hero-overlay">
		<div class="content-wide">
			<SectionDetailHeader
				breadcrumbTrail={breadcrumbTrail}
				date={date}
				kind={kind}
				styles={styles}
				title={title}
			/>
		</div>
	</div>
</div>
