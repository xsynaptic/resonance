---
import { getCollectionPath } from '@xsynaptic/shared/routing';

import type { ContentCatalogItem } from '#lib/catalog/catalog-types.ts';

import Anchor from '#components/parts/anchor.astro';
import EntryCardItem from '#components/parts/entry-card-item.astro';
import { t } from '#lib/i18n/i18n-strings.ts';

interface Props {
	collection: 'mixes' | 'posts' | 'reviews';
	items: Array<ContentCatalogItem>;
	priority?: boolean | undefined;
}

const { collection, items, priority = false } = Astro.props;
---

<section class="mb-12">
	<div class="mb-4 flex items-baseline justify-between">
		<h2 class="heading-section">{t(`home.${collection}.heading`)}</h2>
		<Anchor class="text-sm" href={getCollectionPath(collection)}>
			{t(`home.${collection}.link`)}
		</Anchor>
	</div>
	<ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
		{items.map((item, index) => (
			<EntryCardItem item={item} priority={priority && index === 0} />
		))}
	</ul>
</section>
