---
import type { ContentItem } from '#lib/catalog/catalog-data.ts';

import EntryCard from '#components/parts/entry-card.astro';

interface Props {
	heading: string;
	items: Array<ContentItem>;
	listHref: string;
	listLabel: string;
}

const { heading, items, listHref, listLabel } = Astro.props;
---

<section class="mb-12">
	<div class="mb-4 flex items-baseline justify-between">
		<h2 class="text-2xl">{heading}</h2>
		<a class="text-sm text-highlight-500 hover:text-highlight-400" href={listHref}>{listLabel}</a>
	</div>
	<ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
		{
			items.map((item) => (
				<li>
					<EntryCard
						date={item.date}
						href={item.url}
						image={item.image}
						subtitle={item.subtitle}
						title={item.title}
					/>
				</li>
			))
		}
	</ul>
</section>
