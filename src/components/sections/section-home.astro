---
import type { ContentItem } from '#lib/catalog/catalog-data.ts';

import Anchor from '#components/parts/anchor.astro';
import EntryCard from '#components/parts/entry-card.astro';

interface Props {
	heading: string;
	items: Array<ContentItem>;
	listHref: string;
	listLabel: string;
	priority?: boolean | undefined;
}

const { heading, items, listHref, listLabel, priority = false } = Astro.props;
---

<section class="mb-12">
	<div class="mb-4 flex items-baseline justify-between">
		<h2 class="heading-section">{heading}</h2>
		<Anchor class="text-sm" href={listHref}>{listLabel}</Anchor>
	</div>
	<ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
		{
			items.map((item, index) => (
				<li>
					<EntryCard
						date={item.date}
						href={item.url}
						image={item.image}
						priority={priority && index === 0}
						subtitle={item.subtitle}
						title={item.title}
					/>
				</li>
			))
		}
	</ul>
</section>
