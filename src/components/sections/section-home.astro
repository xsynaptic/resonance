---
import type { ContentCatalogItem } from '#lib/catalog/catalog-types.ts';

import Anchor from '#components/parts/anchor.astro';
import EntryCardItem from '#components/parts/entry-card-item.astro';

interface Props {
	heading: string;
	items: Array<ContentCatalogItem>;
	listHref: string;
	listLabel: string;
	priority?: boolean | undefined;
}

const { heading, items, listHref, listLabel, priority = false } = Astro.props;
---

<section class="mb-12">
	<div class="mb-4 flex items-baseline justify-between">
		<h2 class="heading-section">{heading}</h2>
		<Anchor class="text-sm" href={listHref}>
			{listLabel}
		</Anchor>
	</div>
	<ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
		{items.map((item, index) => (
			<EntryCardItem item={item} priority={priority && index === 0} />
		))}
	</ul>
</section>
