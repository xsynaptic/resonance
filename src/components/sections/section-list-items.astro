---
interface ListItem {
	description?: string | undefined;
	label?: string | undefined;
	link?: string | undefined;
	project?: string | undefined;
	title?: string | undefined;
	year?: string | undefined;
}

interface Props {
	items: Array<ListItem> | undefined;
	ordered?: boolean | undefined;
}

const { items, ordered = false } = Astro.props;

const ListTag = ordered ? 'ol' : 'ul';
---

{
	items && items.length > 0 ? (
		<ListTag class:list={['space-y-3', ordered ? 'list-decimal pl-6' : '']}>
			{items.map((item) => (
				<li>
					<div class="font-medium text-ink-100">
						{item.link ? (
							<a class="text-accent-400 hover:text-accent-300" href={item.link}>
								{item.title}
							</a>
						) : (
							item.title
						)}
					</div>
					{item.project || item.year || item.label ? (
						<div class="text-sm text-ink-500">
							{[item.project, item.year, item.label].filter(Boolean).join(' · ')}
						</div>
					) : undefined}
					{item.description ? (
						<p class="mt-1 text-sm text-ink-300">{item.description}</p>
					) : undefined}
				</li>
			))}
		</ListTag>
	) : undefined
}
