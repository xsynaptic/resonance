---
import Anchor from '#components/parts/anchor.astro';
import DividedItem from '#components/parts/divided-item.astro';
import { contentExcerptMarker } from '#constants.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { renderSlot } from '#lib/utils/astro.ts';
import { formatDate } from '#lib/utils/date.ts';

interface Props {
	date: Date;
	href: string;
	title: string;
}

const { date, href, title } = Astro.props;

const body = await renderSlot(Astro.slots);
const [excerpt, ...remainder] = body?.split(contentExcerptMarker) ?? [];

const isTruncated = remainder.length > 0;
---

<article class="mb-16">
	<header class="mb-4">
		<h2 class="title-main">
			<a href={href}>{title}</a>
		</h2>
		<div class="title-meta">
			<DividedItem as="span" dividerContent="slash">
				{t('detail.posted')}
				<time datetime={date.toISOString()}>{formatDate(date)}</time>
			</DividedItem>
		</div>
	</header>
	<div class="prose-x content-measure">
		<Fragment set:html={excerpt} />
	</div>
	{isTruncated ? (
		<p class="mt-6 italic text-right content-measure">
			<Anchor class="font-semibold" href={href}>
				{t('detail.continueReading')}
			</Anchor>{' '}
			<span class="text-highlight-600">›</span>
		</p>
	) : undefined}
</article>
