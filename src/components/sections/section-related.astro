---
import type { ContentCatalogItem } from '#lib/catalog/catalog-types.ts';

import Carousel from '#components/parts/carousel.astro';
import EntryCardItem from '#components/parts/entry-card-item.astro';
import { t } from '#lib/i18n/i18n-strings.ts';

interface Props {
	items: Array<ContentCatalogItem>;
}

const { items } = Astro.props;
---

{items.length > 0 ? (
	<section class="mt-16" data-nosnippet data-pagefind-ignore>
		<h2 class="heading-section mb-4">{t('section.related.heading')}</h2>
		<Carousel label={t('section.related.carouselLabel')}>
			{items.map((item) => (
				<EntryCardItem item={item} meta={['kind', 'subtitle']} />
			))}
		</Carousel>
	</section>
) : undefined}
