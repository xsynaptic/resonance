---
import type { ContentItem } from '#lib/catalog/catalog-data.ts';

import Carousel from '#components/parts/carousel.astro';
import EntryCard from '#components/parts/entry-card.astro';
import { t } from '#lib/i18n/i18n-strings.ts';

interface Props {
	items: Array<ContentItem>;
}

const { items } = Astro.props;
---

{
	items.length > 0 ? (
		<section class="mt-16" data-nosnippet data-pagefind-ignore>
			<h2 class="heading-section mb-4">{t('section.related.heading')}</h2>
			<Carousel label={t('section.related.carouselLabel')}>
				{items.map((item) => (
					<li class="carousel-slide">
						<EntryCard
							date={item.date}
							href={item.url}
							image={item.image}
							subtitle={item.subtitle}
							title={item.title}
						/>
					</li>
				))}
			</Carousel>
		</section>
	) : undefined
}
