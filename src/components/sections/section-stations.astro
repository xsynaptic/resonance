---
import type { Station } from '#lib/collections/stations/stations-data.ts';

import Carousel from '#components/parts/carousel.astro';
import StationCard from '#components/parts/station-card.astro';
import PlayerPayload from '#components/player/player-payload.astro';
import { t } from '#lib/i18n/i18n-strings.ts';

interface Props {
	stations: Array<Station>;
}

const { stations } = Astro.props;

const items = [
	...new Map(
		stations.flatMap((station) => station.items).map((item) => [item.itemId, item]),
	).values(),
];
---

<section class="mb-12">
	<h2 class="mb-4 heading-section">{t('home.stations.heading')}</h2>
	<p class="mb-4 text-ink-300">{t('home.stations.lead')}</p>
	<Carousel label={t('home.stations.carouselLabel')}>
		{stations.map((station, index) => (
			<li>
				<StationCard priority={index === 0} station={station} />
			</li>
		))}
	</Carousel>
	<PlayerPayload items={items} />
</section>
