---
// Temporary colour picker for the player's tokens; delete it and its Specimen once the palette is chosen

const ramps = ['surface', 'ink', 'accent', 'highlight', 'flair'];
const steps = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];

const tokenGroups = [
	{ label: 'Surface', tokens: ['surface', 'panel-well', 'popover', 'hover', 'border'] },
	{ label: 'Text', tokens: ['title', 'meta', 'hint'] },
	{ label: 'Clock', tokens: ['clock', 'clock-hover'] },
	{
		label: 'Control',
		tokens: [
			'control',
			'control-hover',
			'control-active',
			'control-active-hover',
			'control-inert',
			'play-fill',
			'play-fill-hover',
			'play-glyph',
			'play-glyph-hover',
			'loader',
			'loader-track',
			'drag-handle',
		],
	},
	{ label: 'Current and focus', tokens: ['current', 'focus-ring'] },
	{ label: 'Waveform', tokens: ['waveform-base', 'waveform-played', 'waveform-scrub'] },
	{
		label: 'Panel',
		tokens: [
			'panel-wave',
			'panel-wave-peak',
			'panel-ghost',
			'panel-grid',
			'panel-ends',
			'panel-cue',
			'panel-placeholder',
			'playhead',
		],
	},
	{ label: 'Cues', tokens: ['cue-dot', 'cue-artist', 'cue-title'] },
	{ label: 'Fader', tokens: ['fader-slot', 'fader-cap', 'fader-cap-hover'] },
];
---

<div data-inventory-palette>
	<player-root class="player block" data-inventory-queue="palette">
		<player-bar></player-bar>
	</player-root>
	<div class="mt-6 grid grid-cols-[repeat(auto-fill,minmax(18rem,1fr))] gap-6">
		{tokenGroups.map((group) => (
			<fieldset class="grid gap-1.5">
				<legend class="mb-2 text-ink-400">{group.label}</legend>
				{group.tokens.map((name) => (
					<label class="grid grid-cols-[1.25rem_1fr_auto] items-center gap-2">
						<span
							class="h-5 rounded-sm border border-surface-300"
							style={`background: var(--player-${name})`}
						/>
						<span class="font-mono text-xs text-ink-500 data-picked:text-highlight-400">
							{name}
						</span>
						<select
							class="rounded-sm border border-surface-400 bg-surface-800 px-1 py-0.5 text-xs"
							data-palette-token={`--player-${name}`}
						>
							<option value="">sheet: ?</option>
							{ramps.map((ramp) => (
								<optgroup label={ramp}>
									{steps.map((step) => (
										<option value={`${ramp}-${String(step)}`}>{`${ramp}-${String(step)}`}</option>
									))}
								</optgroup>
							))}
						</select>
					</label>
				))}
			</fieldset>
		))}
	</div>
	<div class="mt-6 flex items-center gap-4">
		<button class="rounded-sm border border-surface-300 px-3 py-1" data-palette-reset type="button">
			Reset all
		</button>
		<span class="text-sm text-ink-600" data-palette-count>
			0 changed
		</span>
	</div>
	<pre
		class="mt-3 overflow-x-auto bg-surface-800 px-4 py-3 text-[0.8125rem] select-all"
		data-palette-output
		hidden={true}
	></pre>
</div>
<script>
	interface PaletteParts {
		count: HTMLElement;
		output: HTMLElement;
		selects: Array<HTMLSelectElement>;
	}

	type Picks = Record<string, string>;

	const storageKey = 'inventory:player-tokens';

	function applyPicks(parts: PaletteParts, picks: Picks): void {
		const root = document.documentElement;
		const changed: Array<string> = [];

		for (const select of parts.selects) {
			const token = select.dataset.paletteToken ?? '';
			const step = picks[token];

			select.value = step ?? '';
			select.previousElementSibling?.toggleAttribute('data-picked', step !== undefined);

			if (step === undefined) {
				root.style.removeProperty(token);
				continue;
			}

			root.style.setProperty(token, `var(--color-${step})`);
			changed.push(`${token}: var(--color-${step});`);
		}

		// The canvases re-read their tokens only when `data-theme` changes, so a flip and restore repaints them
		root.dataset.theme = 'inventory-palette';
		delete root.dataset.theme;

		parts.count.textContent = `${String(changed.length)} changed`;
		parts.output.hidden = changed.length === 0;
		parts.output.textContent = changed.join('\n');

		try {
			localStorage.setItem(storageKey, JSON.stringify(picks));
		} catch {
			// Storage refused; the picks still apply for this visit
		}
	}

	// Each token's computed colour matched back to the ramp step it resolves to, read before any pick lands
	function readDefaults(selects: Array<HTMLSelectElement>): void {
		const styles = getComputedStyle(document.documentElement);
		const stepByColour = new Map<string, string>();
		const steps = selects[0]?.querySelectorAll<HTMLOptionElement>(':scope optgroup option') ?? [];

		for (const option of steps) {
			stepByColour.set(styles.getPropertyValue(`--color-${option.value}`).trim(), option.value);
		}

		for (const select of selects) {
			const colour = styles.getPropertyValue(select.dataset.paletteToken ?? '').trim();
			const sheetOption = select.options[0];

			if (sheetOption) sheetOption.textContent = `sheet: ${stepByColour.get(colour) ?? colour}`;
		}
	}

	function readPicks(): Picks {
		try {
			return JSON.parse(localStorage.getItem(storageKey) ?? '{}') as Picks;
		} catch {
			return {};
		}
	}

	function setUpPalette(): void {
		const palette = document.querySelector<HTMLElement>('[data-inventory-palette]');
		const count = palette?.querySelector<HTMLElement>('[data-palette-count]');
		const output = palette?.querySelector<HTMLElement>('[data-palette-output]');
		const reset = palette?.querySelector('[data-palette-reset]');
		if (!palette || !count || !output || !reset) return;

		const selects = [...palette.querySelectorAll<HTMLSelectElement>('select[data-palette-token]')];
		const parts = { count, output, selects };
		let picks = readPicks();

		readDefaults(selects);
		applyPicks(parts, picks);

		palette.addEventListener('change', (event) => {
			const select = event.target;
			if (!(select instanceof HTMLSelectElement)) return;

			const token = select.dataset.paletteToken;
			if (token === undefined) return;

			const { [token]: _previous, ...rest } = picks;

			picks = select.value === '' ? rest : { ...rest, [token]: select.value };
			applyPicks(parts, picks);
		});
		reset.addEventListener('click', () => {
			picks = {};
			applyPicks(parts, picks);
		});
	}

	setUpPalette();
</script>
