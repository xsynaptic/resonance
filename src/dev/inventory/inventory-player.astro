---
import type { PlayerLabels } from '@xsynaptic/player';

import type { PlayerPayloadItem } from '#lib/collections/mixes/mixes-queue.ts';

import InventoryPalette from '#dev/inventory/inventory-palette.astro';
import Section from '#dev/inventory/inventory-section.astro';
import Specimen from '#dev/inventory/inventory-specimen.astro';

interface Props {
	items: Array<PlayerPayloadItem>;
	labels: PlayerLabels;
	seekSeconds: number;
}

const { items, labels, seekSeconds } = Astro.props;

// Escaped so no title can close the script early
const specimenData = JSON.stringify({ items, labels, seekSeconds }).replaceAll(
	'<',
	String.raw`\u003c`,
);
---

<Section
	note="The player's custom elements, composed as the site's bar composes them and then part by part. Plain tags defined by one script; each root holds a store of its own on a silent engine, so nothing plays."
	title="Player"
>
	<Specimen
		name="Palette (temporary)"
		note="Pick a ramp step for any <code>--player-*</code> colour token. Picks land on <code>:root</code>, so every bar on the page follows, and persist in this browser until reset. Hold on the waveform to see the scrub colour. Changed lines print below for pasting into <code>src/styles/main/components/player.css</code>."
		source="src/dev/inventory/inventory-palette.astro"
	>
		<InventoryPalette />
	</Specimen>
