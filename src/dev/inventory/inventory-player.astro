<script id="inventory-player" is:inline set:html={specimenData} type="application/json"></script>
<script>
	import type { PlayerLabels, PlayerUrls, QueueItem } from '@xsynaptic/player';

	import { createPlayerStore, definePlayerElements } from '@xsynaptic/player';

	import type { PlayerPayloadItem } from '#lib/collections/mixes/mixes-queue.ts';

	import {
		createLoadingEngine,
		createSilentEngine,
		cueFirstPaused,
		failingUrls,
		marqueed,
		pendingPanelQueue,
		pendingUrls,
		queuedUrls,
		trayQueue,
		withoutArtwork,
	} from '#dev/inventory/inventory-player-specimens.ts';

	interface SpecimenData {
		items: Array<PlayerPayloadItem>;
		labels: PlayerLabels;
		seekSeconds: number;
	}

	type SpecimenStore = ReturnType<typeof createPlayerStore>;

	// Roots that show a control rather than an item hold no queue
	const unqueued = new Set(['empty', 'muted', 'volume']);

	const openPanelQueues = new Set(['palette', 'panel']);

	function createSpecimenStore(queue: string): SpecimenStore {
		const store = createPlayerStore({
			createEngine: queue === 'loading' ? createLoadingEngine : createSilentEngine,
			isPersistent: false,
		});

		if (queue === 'muted') {
			store.getState().setVolume(0.3);
			store.getState().toggleMuted();
		}

		return store;
	}

	// The error and loading roots play, so the rejection and the held load are what they show
	function seedSpecimen(store: SpecimenStore, queue: string): void {
		if (queue === 'idle') return;
		if (queue === 'error' || queue === 'loading') {
			store.getState().playAt(0);
			return;
		}

		cueFirstPaused(store);
		if (queue.startsWith('tray')) {
			store.getState().setTrayOpen(true);
			return;
		}

		store.getState().seek((store.getState().durationSeconds ?? 0) / 3);
		if (openPanelQueues.has(queue)) store.getState().setPanelOpen(true);
	}

	// Only this page sets properties before the tags are defined or the page is swapped in, so it alone exercises `upgradeProperty`
	function setUpSpecimens(page: Document): void {
		const source = page.querySelector('#inventory-player')?.textContent;
		if (!source) return;

		const { items, labels, seekSeconds } = JSON.parse(source) as SpecimenData;

		for (const root of page.querySelectorAll('player-root')) {
			const queue = root.dataset.inventoryQueue;
			if (queue === undefined || root.store) continue;

			const store = createSpecimenStore(queue);
			const urls = specimenUrls(items, queue);

			root.isOverlayEnabled = root.dataset.inventoryOverlay !== 'off';
			root.labels = labels;
			root.seekSeconds = seekSeconds;
			root.store = store;
			root.urls = urls;

			if (!unqueued.has(queue)) {
				store.getState().configure({ urls });
				store.getState().loadQueue(specimenItems(items, queue));
				seedSpecimen(store, queue);
			}

			// A first visit by soft navigation lands after the host defined the tags, so each root connected storeless
			if (root.isConnected) root.replaceWith(root);
		}

		definePlayerElements();
	}

	function specimenItems(items: Array<PlayerPayloadItem>, queue: string): Array<QueueItem> {
		if (queue === 'marquee') return marqueed(items);
		if (queue === 'no-artwork') return withoutArtwork(items);
		if (queue === 'no-peaks') return items.filter((item) => item.waveformOverview === undefined);
		if (queue === 'panel') return pendingPanelQueue(items);
		if (queue === 'tray') return trayQueue(items);

		return items;
	}

	function specimenUrls(items: Array<PlayerPayloadItem>, queue: string): PlayerUrls {
		if (queue === 'error') return failingUrls;
		if (queue === 'panel') return pendingUrls(items);

		return queuedUrls(items);
	}

	setUpSpecimens(document);
	document.addEventListener('astro:before-swap', ({ newDocument }) => {
		setUpSpecimens(newDocument);
	});
</script>
