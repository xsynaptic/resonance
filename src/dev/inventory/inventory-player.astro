---
import type { PlayerLabels } from '@xsynaptic/player';

import type { PlayerPayloadItem } from '#lib/collections/mixes/mixes-queue.ts';

import InventoryPalette from '#dev/inventory/inventory-palette.astro';
import Section from '#dev/inventory/inventory-section.astro';
import Specimen from '#dev/inventory/inventory-specimen.astro';

interface Props {
	items: Array<PlayerPayloadItem>;
	labels: PlayerLabels;
	seekSeconds: number;
}

const { items, labels, seekSeconds } = Astro.props;

// Escaped so no title can close the script early
const specimenData = JSON.stringify({ items, labels, seekSeconds }).replaceAll(
	'<',
	String.raw`\u003c`,
);

// Each variation is nothing but tokens on the wrapper, which the renderer reads when it paints
const waveformVariations = [
	{ className: undefined, label: '2px bar, 1px gap, 1px radius (the default)' },
	{ className: 'inventory-waveform-square', label: '2px bar, 1px gap, no radius' },
	{ className: 'inventory-waveform-chunky', label: '3px bar, 1px gap, 1px radius' },
];
---

