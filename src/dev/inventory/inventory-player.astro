---
import type { PlayerLabels } from '@xsynaptic/player';

import type { MixQueueItem } from '#lib/collections/mixes/mixes-queue.ts';

import InventoryPalette from '#dev/inventory/inventory-palette.astro';
import Section from '#dev/inventory/inventory-section.astro';
import Specimen from '#dev/inventory/inventory-specimen.astro';
import Variant from '#dev/inventory/inventory-variant.astro';

interface Props {
	items: Array<MixQueueItem>;
	labels: PlayerLabels;
	seekSeconds: number;
}

const { items, labels, seekSeconds } = Astro.props;

// Escaped so no title can close the script early
const specimenData = JSON.stringify({ items, labels, seekSeconds }).replaceAll(
	'<',
	String.raw`\u003c`,
);
---

<Section note="Every root holds its own store on a silent engine, so nothing plays." title="Player">
	<Specimen
		name="player-bar"
		note="The tier follows the bar's width, not the viewport; Expand opens the real overlay."
		source="packages/player/src/elements/player-bar.ts"
	>
		<Variant label="full width">
			<player-root class="block" data-inventory-queue="bar">
				<player-bar></player-bar>
			</player-root>
		</Variant>
		<Variant label="no artwork">
			<player-root class="block" data-inventory-queue="no-artwork">
				<player-bar></player-bar>
			</player-root>
		</Variant>
		<Variant label="32rem, artwork dropped">
			<player-root class="block max-w-lg" data-inventory-queue="bar">
				<player-bar></player-bar>
			</player-root>
		</Variant>
		<Variant label="320px mini, marquee">
			<player-root class="block max-w-xs" data-inventory-queue="marquee">
				<player-bar></player-bar>
			</player-root>
		</Variant>
		<Variant label="320px mini, isOverlayEnabled=false">
			<div class="pt-96">
				<player-root
					class="block max-w-xs"
					data-inventory-overlay="off"
					data-inventory-queue="marquee"
				>
					<player-bar></player-bar>
				</player-root>
			</div>
		</Variant>
	</Specimen>
	<Specimen
		name="player-bar states"
		note="Emulate <code>prefers-reduced-motion</code> for the loader and panel fallbacks."
		source="packages/player/src/store/selectors.ts"
	>
		<Variant label="idle">
			<player-root class="block" data-inventory-queue="idle">
				<player-bar></player-bar>
			</player-root>
		</Variant>
		<Variant label="empty, hidden on the site">
			<div class="inventory-player-empty">
				<player-root class="block" data-inventory-queue="empty">
					<player-bar></player-bar>
				</player-root>
			</div>
		</Variant>
		<Variant label="error">
			<player-root class="block" data-inventory-queue="error">
				<player-bar></player-bar>
			</player-root>
		</Variant>
		<Variant label="loading; a press cancels">
			<player-root class="block" data-inventory-queue="loading">
				<player-bar></player-bar>
			</player-root>
		</Variant>
		<Variant label="no peaks, a plain groove">
			<player-root class="block" data-inventory-queue="no-peaks">
				<player-bar></player-bar>
			</player-root>
		</Variant>
		<Variant label="panel open; hover a cue dot for its label">
			<div class="pt-32">
				<player-root class="block" data-inventory-queue="panel">
					<player-bar></player-bar>
				</player-root>
			</div>
		</Variant>
		<Variant label="panel pending">
			<div class="pt-32">
				<player-root class="block" data-inventory-queue="panel-pending">
					<player-bar></player-bar>
				</player-root>
			</div>
		</Variant>
	</Specimen>
	<Specimen name="player-overlay-content" source="packages/player/src/elements/overlay/">
		<Variant label="390x844 phone">
			<player-root
				class="block h-211 w-97.5 max-w-full border border-surface-400"
				data-inventory-queue="overlay"
			>
				<player-overlay-content></player-overlay-content>
			</player-root>
		</Variant>
		<Variant label="844x390 phone landscape">
			<player-root
				class="block h-97.5 w-211 max-w-full border border-surface-400"
				data-inventory-queue="overlay"
			>
				<player-overlay-content></player-overlay-content>
			</player-root>
		</Variant>
		<Variant label="900x800 columns">
			<player-root
				class="block h-200 w-225 max-w-full border border-surface-400"
				data-inventory-queue="overlay"
			>
				<player-overlay-content></player-overlay-content>
			</player-root>
		</Variant>
	</Specimen>
	<Specimen name="player-volume" source="packages/player/src/elements/volume.ts">
		<Variant label="default">
			<player-root class="flex bg-surface-900 px-4 py-2.5" data-inventory-queue="volume">
				<player-volume></player-volume>
			</player-root>
		</Variant>
		<Variant label="muted at 30%">
			<player-root class="flex bg-surface-900 px-4 py-2.5" data-inventory-queue="muted">
				<player-volume></player-volume>
			</player-root>
		</Variant>
	</Specimen>
	<Specimen
		name="player-tray"
		note="Drag a handle, or Alt+ArrowUp/Down on a focused one."
		source="packages/player/src/elements/tray/"
	>
		<div class="pt-96">
			<player-root class="block" data-inventory-queue="tray">
				<player-bar></player-bar>
			</player-root>
		</div>
	</Specimen>
	<Specimen
		name="Palette (temporary)"
		note="Picks land on <code>:root</code> and persist in this browser until reset; hold on the waveform for the scrub colour. Changed lines print below for <code>src/styles/main/components/player.css</code>."
		source="src/dev/inventory/inventory-palette.astro"
	>
		<InventoryPalette />
	</Specimen>
</Section>
<script id="inventory-player" is:inline set:html={specimenData} type="application/json"></script>
<script>
	import type { PlayerLabels, PlayerStoreApi, PlayerUrls, QueueItem } from '@xsynaptic/player';

	import { createMemoryStorage, createPlayerStore, definePlayerElements } from '@xsynaptic/player';

	import type { MixQueueItem } from '#lib/collections/mixes/mixes-queue.ts';

	import {
		createLoadingEngine,
		createSilentEngine,
		cueFirstPaused,
		failingUrls,
		marqueed,
		pendingUrls,
		queuedUrls,
		trayQueue,
		withoutArtwork,
	} from '#dev/inventory/inventory-player-specimens.ts';

	interface SpecimenData {
		items: Array<MixQueueItem>;
		labels: PlayerLabels;
		seekSeconds: number;
	}

	const unqueued = new Set(['empty', 'muted', 'volume']);

	const openPanelQueues = new Set(['palette', 'panel', 'panel-pending']);

	function createSpecimenStore(queue: string): PlayerStoreApi {
		const store = createPlayerStore({
			createEngine: queue === 'loading' ? createLoadingEngine : createSilentEngine,
			storage: createMemoryStorage(),
		});

		if (queue === 'muted') {
			store.getState().setVolume(0.3);
			store.getState().toggleMuted();
		}

		return store;
	}

	function seedSpecimen(store: PlayerStoreApi, queue: string): void {
		if (queue === 'idle') return;
		if (queue === 'error' || queue === 'loading') {
			store.getState().playAt(0);
			return;
		}

		cueFirstPaused(store);
		if (queue === 'tray') {
			store.getState().setTrayOpen(true);
			return;
		}

		store.getState().seek((store.getState().durationSeconds ?? 0) / 3);
		if (openPanelQueues.has(queue)) store.getState().setPanelOpen(true);
	}

	// Only this page sets properties before the tags are defined or the page is swapped in, so it alone exercises `upgradeProperty`
	function setUpSpecimens(page: Document): void {
		const source = page.querySelector('#inventory-player')?.textContent;
		if (!source) return;

		const { items, labels, seekSeconds } = JSON.parse(source) as SpecimenData;

		for (const root of page.querySelectorAll('player-root')) {
			const queue = root.dataset.inventoryQueue;
			if (queue === undefined || root.store) continue;

			const store = createSpecimenStore(queue);
			const urls = specimenUrls(items, queue);

			root.isOverlayEnabled = root.dataset.inventoryOverlay !== 'off';
			root.isScopeEnabled = true;
			root.labels = labels;
			root.store = store;
			store.getState().configure({ seekSeconds, urls });

			if (!unqueued.has(queue)) {
				store.getState().loadQueue(specimenItems(items, queue));
				seedSpecimen(store, queue);
			}

			// A first visit by soft navigation lands after the host defined the tags, so each root connected storeless
			if (root.isConnected) root.replaceWith(root);
		}

		definePlayerElements();
	}

	function specimenItems(items: Array<MixQueueItem>, queue: string): Array<QueueItem> {
		const rows = items.map(({ press }) => press);

		if (queue === 'marquee') return marqueed(rows);
		if (queue === 'no-artwork') return withoutArtwork(rows);
		if (queue === 'tray') return trayQueue(rows);

		if (queue === 'no-peaks') {
			return items
				.filter(({ detail }) => detail.waveformOverview === undefined)
				.map(({ press }) => press);
		}

		return rows;
	}

	function specimenUrls(items: Array<MixQueueItem>, queue: string): PlayerUrls {
		if (queue === 'error') return failingUrls;
		if (queue === 'panel-pending') return pendingUrls(items);

		return queuedUrls(items);
	}

	setUpSpecimens(document);
	document.addEventListener('astro:before-swap', ({ newDocument }) => {
		setUpSpecimens(newDocument);
	});
</script>
