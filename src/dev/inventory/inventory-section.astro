---
import { toSlug } from '@xsynaptic/shared/routing';

interface Props {
	note?: string | undefined;
	title: string;
}

const { note, title } = Astro.props;

const id = toSlug(title);
---

<section class="mb-20 scroll-mt-8 border-t-2 border-surface-400 pt-6" id={id}>
	<h2 class="mb-2 font-display text-2xl font-semibold text-ink-100">{title}</h2>
	{note ? (
		<p class="content-measure text-sm leading-relaxed text-ink-600" set:html={note} />
	) : undefined}
	<slot />
</section>
