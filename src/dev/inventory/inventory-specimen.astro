---
interface Props {
	name: string;
	note?: string | undefined;
	source?: string | undefined;
}

const { name, note, source } = Astro.props;
---

<div class="mt-8 border-t border-surface-600 pt-4">
	<div class="mb-5">
		<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
			<h3 class="font-mono text-base font-bold text-ink-200">{name}</h3>
			{source ? <code class="font-mono text-xs text-ink-700">{source}</code> : undefined}
		</div>
		{note ? (
			<p class="mt-1 content-measure text-sm leading-relaxed text-ink-600" set:html={note} />
		) : undefined}
	</div>
	<slot />
</div>
