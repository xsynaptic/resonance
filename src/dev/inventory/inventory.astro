---
import type { Page } from 'astro';

import type { ContentCatalogItem } from '#lib/catalog/catalog-types.ts';
import type { SelectionValue } from '#lib/schemas/selections.ts';
import type { LinkedName } from '#lib/utils/terms.ts';

import EmbedMixcloud from '#components/embed/embed-mixcloud.astro';
import EmbedSoundcloud from '#components/embed/embed-soundcloud.astro';
import MainSite from '#components/main/main-site.astro';
import EmbedYoutube from '#components/mdx/embed-youtube.astro';
import ImgGroup from '#components/mdx/img-group.astro';
import Img from '#components/mdx/img.astro';
import Quotation from '#components/mdx/quotation.astro';
import Selections from '#components/mdx/selections.astro';
import TrackList from '#components/mdx/track-list.astro';
import Anchor from '#components/parts/anchor.astro';
import AudioCounts from '#components/parts/audio-counts.astro';
import AudioLinks from '#components/parts/audio-links.astro';
import Breadcrumbs from '#components/parts/breadcrumbs.astro';
import ButtonSplit from '#components/parts/button-split.astro';
import Button from '#components/parts/button.astro';
import DividedItem from '#components/parts/divided-item.astro';
import EntryCard from '#components/parts/entry-card.astro';
import LinkedNameList from '#components/parts/linked-name-list.astro';
import LinkedNameText from '#components/parts/linked-name-text.astro';
import ListGroupHeading from '#components/parts/list-group-heading.astro';
import MediaFeatured from '#components/parts/media-featured.astro';
import MediaImage from '#components/parts/media-image.astro';
import PaginationSelect from '#components/parts/pagination-select.astro';
import TermDirectory from '#components/parts/term-directory.astro';
import TermLinks from '#components/parts/term-links.astro';
import PlayerControls from '#components/player/player-controls.astro';
import { seekSeconds } from '#components/player/player-labels.ts';
import SectionCoda from '#components/sections/section-coda.astro';
import SectionDetailHeader from '#components/sections/section-detail-header.astro';
import SectionDetailHero from '#components/sections/section-detail-hero.astro';
import SectionHome from '#components/sections/section-home.astro';
import SectionPostExcerpt from '#components/sections/section-post-excerpt.astro';
import SectionRelated from '#components/sections/section-related.astro';
import { getInventoryFixtures } from '#dev/inventory/inventory-fixtures.ts';
import PlayerSection from '#dev/inventory/inventory-player.astro';
import ProseSample from '#dev/inventory/inventory-prose-sample.mdx';
import Section from '#dev/inventory/inventory-section.astro';
import Specimen from '#dev/inventory/inventory-specimen.astro';
import Variant from '#dev/inventory/inventory-variant.astro';
import { getArchiveYearPagination } from '#lib/archive/archive-data.ts';
import { collectionKinds } from '#lib/catalog/catalog-kind.ts';
import { getPagination } from '#lib/utils/pagination.ts';
import { toSlug } from '#lib/utils/text.ts';
import '#dev/inventory/inventory.css';

const {
	artists,
	card,
	cardWork,
	excerpt,
	groupedTracks,
	heroPath,
	iconIds,
	imagePaths,
	labels,
	mix,
	mixcloudUrl,
	mixItems,
	openGraphCards,
	playerItems,
	playerLabels,
	regionTree,
	relatedItems,
	review,
	selections,
	soundcloudUrl,
	styles,
	themes,
	vocabulary,
	youtubeUrl,
} = await getInventoryFixtures();

// Hand-kept mirror of the Section titles below, which the nav links to by derived anchor
const sectionTitles = [
	'Foundations',
	'Prose',
	'Content blocks',
	'Buttons, icons and dividers',
	'Credits and terms',
	'Cards and listings',
	'Detail pages',
	'Media',
	'Audio',
	'Player',
	'Open Graph',
	'Empty states',
];

const hasHero = !Astro.url.pathname.replace(/\/$/, '').endsWith('/no-hero');

// Mirrors the ramps in styles/main/parts/theme.css, which define every step for all five
const rampSteps = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];
const rampNames = ['surface', 'ink', 'accent', 'highlight', 'flair'];

const fontFamilies = [
	{ name: 'font-display', note: 'Fira Sans, for headings and navigation' },
	{ name: 'font-body', note: 'Archivo, for body copy and chrome' },
	{ name: 'font-mono', note: "System mono, for this page's own labels" },
];

function toDirectoryTerms(terms: Array<LinkedName>) {
	return terms.flatMap((term) =>
		term.url === undefined ? [] : [{ id: term.url, title: term.name, url: term.url }],
	);
}

const vocabularyTerms = toDirectoryTerms(vocabulary);
const shortVocabularyTerms = toDirectoryTerms([...styles, ...themes, ...labels]);

const mixedCredits = [...artists.slice(0, 2), { name: 'An Uncatalogued Artist' }];

const breadcrumbTrail = [{ name: 'Styles', url: '/styles/' }, ...styles.slice(0, 2)];

// Astro's own Page interface type-checks this, so a new required field surfaces here as a tsc error
const paginationPage: Page<ContentCatalogItem> = {
	currentPage: 3,
	data: [],
	end: 29,
	lastPage: 8,
	size: 10,
	start: 20,
	total: 76,
	url: {
		current: '/reviews/3',
		first: '/reviews',
		last: '/reviews/8',
		next: '/reviews/4',
		prev: '/reviews/2',
	},
};

const paginationYears = ['2013', '2011', '2009'];

// A selection's anchor id comes from its entry, so each order variant takes its own rows
const unorderedSelections = selections.slice(0, 3);
const orderedSelections = selections.slice(3, 6);
const countdownSelections = selections.slice(6, 9);

// Every field written inline, the authoring mode that needs no entry behind it
const inlineSelection: SelectionValue = {
	artists: 'A Free-Text Artist',
	discogsUrl: 'https://www.discogs.com/',
	labels: ['An Uncatalogued Label'],
	title: 'A Release Named Inline',
	year: '2003',
};
---

<MainSite title="Inventory">
	{heroPath && hasHero ? (
		<SectionDetailHero
			date={new Date()}
			kind={{ name: 'Development' }}
			path={heroPath}
			slot="hero"
			styles={styles.slice(0, 2)}
			title="Component gallery"
		/>
	) : undefined}
	<p class="mb-6 content-measure text-sm leading-relaxed text-ink-600">
		The header is in its {hasHero ? 'overlay' : 'normal'} variant:{' '}
		<Anchor href={hasHero ? '/inventory/no-hero' : '/inventory'}>
			{hasHero ? 'drop the hero band' : 'restore the hero band'}
		</Anchor>{' '}
		to see the other.
	</p>
	<nav
		aria-label="Gallery sections"
		class="mb-12 flex flex-wrap gap-x-5 gap-y-2 rounded-md bg-surface-600 px-5 py-4 font-mono text-xs leading-relaxed"
	>
		{sectionTitles.map((title) => (
			<a class="text-ink-500" href={`#${toSlug(title)}`}>
				{title}
			</a>
		))}
	</nav>
	<Section title="Foundations">
		<Specimen
			name="Colour tokens"
			note="Includes steps the site never uses."
			source="src/styles/main/parts/theme.css"
		>
			<div class="flex flex-col gap-5">
				{rampNames.map((name) => (
					<div>
						<div class="font-mono text-xs text-ink-600">--color-{name}-*</div>
						<div class="mt-2 grid grid-cols-[repeat(auto-fill,minmax(4rem,1fr))] gap-1">
							{rampSteps.map((step) => (
								<div>
									<div
										class="h-12 rounded-xs border border-ink-700"
										style={`background-color: var(--color-${name}-${String(step)})`}
									/>
									<div class="mt-1 font-mono text-[0.6875rem] text-ink-600">{step}</div>
								</div>
							))}
						</div>
					</div>
				))}
			</div>
		</Specimen>
		<Specimen name="Typefaces" source="src/styles/main/parts/theme.css">
			<div class="flex flex-col gap-4">
				{fontFamilies.map((family) => (
					<div class="border-t border-surface-400 pt-4 first:border-0 first:pt-0">
						<div class="font-mono text-xs text-ink-700">
							--{family.name}, {family.note}
						</div>
						<div class="mt-1 text-2xl" style={`font-family: var(--${family.name})`}>
							Basilisk 0123456789 <em>italic</em> <strong>bold</strong>
						</div>
					</div>
				))}
			</div>
		</Specimen>
		<Specimen
			name="Heading roles"
			note="Roles, not a type scale; outside prose a heading level carries no styling."
			source="src/styles/main/components/headings.css"
		>
			<div class="space-y-3">
				<h1 class="title-main">title-main, a Detail Page or List Page title</h1>
				<h2 class="title-main">title-main on h2, an excerpt or hero title, a step down</h2>
				<h2 class="heading-section">heading-section, a band on Home or Related</h2>
				<h2 class="heading-sub">heading-sub, a Tracklist</h2>
				<h2 class="heading-label">heading-label, a footer band</h2>
			</div>
		</Specimen>
		<Specimen
			name="Link roles"
			note="Tab through for the focus treatment."
			source="src/styles/main/parts/base.css"
		>
			<div class="space-y-2">
				<div class="prose-x">
					<p>
						Prose claims a link with <a href="/mixes/">an underline and a lift to ink-200</a>.
					</p>
				</div>
				<p>
					<Anchor href="/mixes/">anchorColor=&quot;highlight&quot;</Anchor>, the default, for
					taxonomy, meta and navigation.
				</p>
				<p>
					<Anchor anchorColor="muted" href="/mixes/">
						anchorColor=&quot;muted&quot;
					</Anchor>
					, a step dimmer, for the footer.
				</p>
				<p class="title-meta">
					<span>
						<a href="/mixes/">A meta line link</a>, ink-300 against the ink-600 around it.
					</span>
				</p>
				<p>
					And the base, <a href="/mixes/">a bare anchor</a>, which no page reaches for.
				</p>
			</div>
		</Specimen>
		<Specimen
			name="pattern-maze-*"
			note="--pattern-maze-opacity and --pattern-maze-size are the knobs, defaulting to 0.2 and 60px."
			source="src/styles/main/parts/utilities.css"
		>
			<div class="pattern-maze-surface-300 rounded-md bg-surface-800 p-5">
				The header and footer bands both sit on this.
			</div>
		</Specimen>
		<Specimen name="content-measure" source="src/styles/main/parts/utilities.css">
			<p class="content-measure">
				This paragraph stops at 50rem however wide the column around it gets, which keeps an
				introduction readable on a large screen without pulling it out of the grid.
			</p>
		</Specimen>
		<Specimen
			name="content-bleed / content-bleed-inset"
			note="Visible under 640px."
			source="src/styles/main/parts/utilities.css"
		>
			<div class="content-bleed bg-surface-700 content-bleed-inset py-3 sm:px-3">
				Bled and inset together, so this text stays on the column while the band behind it runs to
				the edge.
			</div>
			<div class="content-bleed mt-2 bg-surface-600 py-3 text-center">Bled on its own.</div>
		</Specimen>
	</Section>
	<Section title="Prose">
		<Specimen name=".prose-x" source="src/styles/main/components/prose.css">
			<div class="prose-x">
				<ProseSample />
			</div>
		</Specimen>
	</Section>
	<Section title="Content blocks">
		<Specimen name="Img" note="Below 40rem a float stacks." source="src/components/mdx/img.astro">
			<Variant label="align='right' size='small'">
				<div class="prose-x content-measure">
					{imagePaths[0] ? <Img align="right" size="small" src={imagePaths[0]} /> : undefined}
					<Quotation author="Erik Davis" title="Hedonic Tantra" year="2004">
						Whether or not Goa is the core source of rave spirituality, the freak colony has grown
						into a spiritual origin, a source. But this does not make it simply another myth.
					</Quotation>
					<p>
						A paragraph after the quotation runs beside the image until it clears the bottom edge,
						then takes the full measure again. It needs to be long enough to wrap beneath the float,
						which is the case a single quotation never shows: body copy continuing past a small
						illustration rather than ending beside it. The float is capped at half the column and at
						the width of its source, so a narrow original never stretches to fill its size. Past the
						bottom edge the lines lengthen back to the full column, which is the point of a float:
						the image illustrates a passage without claiming a whole row of the page. Two full lines
						down here are what show the measure returning, because a single short line below the
						float could as easily be the paragraph ending where the image happens to end.
					</p>
				</div>
			</Variant>
			<Variant label="align='left' size='medium', captioned">
				<div class="prose-x content-measure">
					{imagePaths[1] ? (
						<Img align="left" size="medium" src={imagePaths[1]}>
							A caption wraps to the width of the image it sits under.
						</Img>
					) : undefined}
					<Quotation author="Goa Gil">
						We're delving to the same place and trying to bring the same thing forth, but with the
						technology of the 21st century.
					</Quotation>
					<p>
						On the left the float pushes body copy toward the right edge, and the gap sits on its
						inline end instead. A caption travels with the frame, so it takes the same width as the
						image above it. Once the text passes the bottom of the figure it returns to the full
						measure, and the entry contains the float however short the copy beside it runs. The
						caption counts toward the height the copy has to clear, so a captioned float holds a
						narrow column of text beside it for longer than a bare image of the same size. Short
						copy beside a tall figure is the common case in older Posts, where one paragraph
						introduces a record sleeve and the next begins below it, so the specimen runs long
						enough to show both. Below the figure these last lines run the full column again. A
						float with nothing after it would leave that case untested, which is why the paragraph
						keeps going past the caption.
					</p>
				</div>
			</Variant>
			<Variant label="no align, captioned">
				<div class="prose-x">
					{heroPath ? (
						<Img src={heroPath}>A caption, written as the tag's children.</Img>
					) : undefined}
				</div>
			</Variant>
		</Specimen>
		<Specimen
			name="ImgGroup"
			note="Columns follow the image count: 4, then 3, then 2."
			source="src/components/mdx/img-group.astro"
		>
			<div class="prose-x">
				<ImgGroup imageCount={imagePaths.length}>
					{imagePaths.map((path) => (
						<Img src={path} />
					))}
				</ImgGroup>
			</div>
		</Specimen>
		<Specimen
			name="Quotation"
			note="<code>url</code> links the title and sets <code>cite</code>."
			source="src/components/mdx/quotation.astro"
		>
			<Variant label="author, title, year, url">
				<div class="prose-x">
					<Quotation
						author="Erik Davis"
						title="Hedonic Tantra"
						url="/inventory/#content-blocks"
						year="2004"
					>
						Whether or not Goa is the core source of rave spirituality, the freak colony has grown
						into a spiritual origin, a source.
					</Quotation>
				</div>
			</Variant>
			<Variant label="author alone">
				<div class="prose-x">
					<Quotation author="Goa Gil">
						We're delving to the same place and trying to bring the same thing forth.
					</Quotation>
				</div>
			</Variant>
		</Specimen>
		<Specimen
			name="TrackList"
			note="Numeral and time columns appear from 40rem; a Mix's <code>timestamp</code> never renders."
			source="src/components/mdx/track-list.astro"
		>
			<Variant label="from a Mix">
				<div class="prose-x">
					<TrackList tracks={mix?.tracks.slice(0, 6)} />
				</div>
			</Variant>
			<Variant label="grouped, hand-built; the filenames are fictional">
				<div class="prose-x">
					<TrackList tracks={groupedTracks} />
				</div>
			</Variant>
		</Specimen>
		<Specimen name="Selections" source="src/components/mdx/selections.astro">
			<Variant label="order='unordered' (default)">
				<div class="prose-x">
					<Selections items={unorderedSelections} />
				</div>
			</Variant>
			<Variant label="order='ordered'">
				<div class="prose-x">
					<Selections items={orderedSelections} order="ordered" />
				</div>
			</Variant>
			<Variant label="order='countdown'">
				<div class="prose-x">
					<Selections items={countdownSelections} order="countdown" />
				</div>
			</Variant>
			<Variant label="every field inline, no entryId">
				<div class="prose-x">
					<Selections items={[inlineSelection]} />
				</div>
			</Variant>
		</Specimen>
		<Specimen name="YouTube" source="src/components/mdx/embed-youtube.astro">
			{youtubeUrl ? <EmbedYoutube url={youtubeUrl} /> : undefined}
		</Specimen>
		<Specimen name="Mixcloud" source="src/components/embed/embed-mixcloud.astro">
			{mixcloudUrl ? (
				<>
					<Variant label="default">
						<EmbedMixcloud url={mixcloudUrl} />
					</Variant>
					<Variant label="mini">
						<EmbedMixcloud mini url={mixcloudUrl} />
					</Variant>
				</>
			) : undefined}
		</Specimen>
		<Specimen name="Soundcloud" source="src/components/embed/embed-soundcloud.astro">
			{soundcloudUrl ? <EmbedSoundcloud url={soundcloudUrl} /> : undefined}
		</Specimen>
	</Section>
	<Section title="Buttons, icons and dividers">
		<Specimen name="Button" source="src/components/parts/button.astro">
			<Variant label="as='a'">
				<div class="flex flex-wrap items-center gap-4">
					<Button as="a" href="/mixes/">
						standard
					</Button>
					<Button as="a" href="/mixes/" icon="download">
						standard, icon
					</Button>
					<Button as="a" href="/mixes/" variant="small">
						small
					</Button>
					<Button as="a" href="/mixes/" icon="youtube" variant="small">
						small, icon
					</Button>
				</div>
			</Variant>
			<Variant label="button (default)">
				<div class="flex flex-wrap items-center gap-4">
					<Button>standard</Button>
					<Button icon="download">standard, icon</Button>
					<Button variant="small">small</Button>
					<Button disabled>disabled</Button>
				</div>
			</Variant>
		</Specimen>
		<Specimen
			name="ButtonSplit"
			note="A lone child keeps both ends rounded."
			source="src/components/parts/button-split.astro"
		>
			<div class="flex flex-wrap items-center gap-4">
				<ButtonSplit>
					<Button as="a" href="/mixes/" icon="download">
						FLAC
					</Button>
					<Button as="a" href="/mixes/">
						CUE
					</Button>
				</ButtonSplit>
				<ButtonSplit>
					<Button as="a" href="/mixes/" icon="download">
						FLAC
					</Button>
				</ButtonSplit>
			</div>
		</Specimen>
		<Specimen
			name="Icon sprite"
			note="A symbol shows once its id is in the fixtures."
			source="src/components/main/main-sprites.astro"
		>
			<div class="flex flex-wrap gap-4">
				{iconIds.map((id) => (
					<span class="flex w-28 flex-col items-center gap-2 rounded-sm bg-surface-600 px-1 py-3 text-center font-mono text-[0.625rem] text-ink-600">
						<svg aria-hidden="true" class="size-6 text-highlight-400">
							<use href={`#icon:${id}`} />
						</svg>
						{id}
					</span>
				))}
			</div>
		</Specimen>
		<Specimen name="DividedItem" source="src/components/parts/divided-item.astro">
			<div class="flex flex-col gap-2">
				<div class="flex flex-wrap gap-x-1">
					<DividedItem as="span">dividerContent=&quot;dot&quot; (default)</DividedItem>
					<DividedItem as="span">three items</DividedItem>
					<DividedItem as="span">two glyphs</DividedItem>
				</div>
				<div class="flex flex-wrap gap-x-1">
					<DividedItem as="span" dividerContent="slash">
						dividerContent=&quot;slash&quot;
					</DividedItem>
					<DividedItem as="span" dividerContent="slash">
						available, unused today
					</DividedItem>
				</div>
				<div class="flex flex-wrap gap-x-1">
					<DividedItem as="span" dividerContent="chevron">
						dividerContent=&quot;chevron&quot;
					</DividedItem>
					<DividedItem as="span" dividerContent="chevron">
						for a trail
					</DividedItem>
				</div>
				<div class="flex flex-wrap gap-x-1">
					<DividedItem as="span" dividerColor="muted">
						dividerColor=&quot;muted&quot;
					</DividedItem>
					<DividedItem as="span" dividerWeight="thin">
						dividerWeight=&quot;thin&quot;
					</DividedItem>
					<DividedItem as="span">and the default, for comparison</DividedItem>
					<DividedItem as="span">last, no glyph</DividedItem>
				</div>
			</div>
		</Specimen>
	</Section>
	<Section title="Credits and terms">
		<Specimen name="LinkedNameText" source="src/components/parts/linked-name-text.astro">
			<div class="flex flex-wrap items-center gap-4">
				<LinkedNameText name={mixedCredits[0]?.name ?? 'Linked'} url={mixedCredits[0]?.url} />
				<LinkedNameText anchorColor="highlight" name='anchorColor="highlight"' url="/styles/" />
				<LinkedNameText name="Unlinked, no url" />
			</div>
		</Specimen>
		<Specimen name="LinkedNameList" source="src/components/parts/linked-name-list.astro">
			<LinkedNameList names={mixedCredits} />
		</Specimen>
		<Specimen name="TermLinks" source="src/components/parts/term-links.astro">
			<div class="flex flex-col items-start gap-4">
				<TermLinks heading="Styles" terms={styles} />
				<TermLinks heading="Themes" terms={themes} />
				<TermLinks heading="Artists" terms={mixedCredits} />
			</div>
		</Specimen>
		<Specimen name="TermDirectory" source="src/components/parts/term-directory.astro">
			<Variant label="20+ roots, bucketed by initial">
				<TermDirectory terms={vocabularyTerms} />
			</Variant>
			<Variant label="under 20, no headings">
				<TermDirectory terms={shortVocabularyTerms} />
			</Variant>
			<Variant label="hierarchical, children nest under their parent">
				<TermDirectory terms={regionTree} />
			</Variant>
		</Specimen>
	</Section>
	<Section title="Cards and listings">
		<Specimen
			name="EntryCard"
			note="The frame keeps its square when the image is missing."
			source="src/components/parts/entry-card.astro"
		>
			{card ? (
				<ul class="entry-grid">
					<li>
						<EntryCard
							date={card.date}
							href={card.url}
							image={card.image}
							subtitle={card.subtitle}
							title={card.title}
						/>
					</li>
					<li>
						<EntryCard href={card.url} image={card.image} title="No subtitle, no date" />
					</li>
					<li>
						<EntryCard
							date={card.date}
							href={card.url}
							image={card.image}
							kind={collectionKinds[card.collection]}
							title={card.title}
						/>
					</li>
					<li>
						<EntryCard
							date={card.date}
							href={card.url}
							image={card.image}
							kind={collectionKinds[card.collection]}
							subtitle={card.subtitle}
							title={card.title}
						/>
					</li>
					<li>
						<EntryCard date={card.date} href={card.url} subtitle="No image" title="Title only" />
					</li>
					{cardWork ? (
						<li>
							<EntryCard
								date={cardWork.date}
								href={cardWork.url}
								image={cardWork.image}
								subtitle={cardWork.subtitle}
								title={cardWork.title}
								work={cardWork.work}
							/>
						</li>
					) : undefined}
				</ul>
			) : undefined}
		</Specimen>
		<Specimen
			name="ListGroupHeading"
			note="The <code>heading-group</code> role."
			source="src/components/parts/list-group-heading.astro"
		>
			<ListGroupHeading label={String(new Date().getFullYear())} />
		</Specimen>
		<Specimen
			name="SectionPostExcerpt"
			note="Truncates at the <code>More</code> fold."
			source="src/components/sections/section-post-excerpt.astro"
		>
			{excerpt ? (
				<SectionPostExcerpt date={excerpt.date} href={excerpt.href} title={excerpt.title}>
					<excerpt.Content />
				</SectionPostExcerpt>
			) : undefined}
		</Specimen>
		<Specimen
			name="PaginationSelect"
			note="The counter becomes a select once the custom element upgrades."
			source="src/components/parts/pagination-select.astro"
		>
			<div class="flex flex-col gap-4">
				<PaginationSelect pagination={getPagination(paginationPage)} />
				<PaginationSelect pagination={getArchiveYearPagination(paginationYears)} />
				<PaginationSelect pagination={getArchiveYearPagination(paginationYears, '2011')} />
			</div>
		</Specimen>
		<Specimen name="SectionHome" source="src/components/sections/section-home.astro">
			<SectionHome collection="mixes" items={mixItems.slice(0, 4)} />
		</Specimen>
		<Specimen
			name="SectionRelated"
			note="Chevrons arrive with the custom element; the track scrolls without it."
			source="src/components/sections/section-related.astro"
		>
			<SectionRelated items={relatedItems} />
		</Specimen>
	</Section>
	<Section note="SectionDetailHero is the band at the top of this page." title="Detail pages">
		<Specimen name="Breadcrumbs" source="src/components/parts/breadcrumbs.astro">
			<Breadcrumbs trail={breadcrumbTrail} />
		</Specimen>
		<Specimen
			name="SectionDetailHeader"
			source="src/components/sections/section-detail-header.astro"
		>
			<Variant label="bare">
				<SectionDetailHeader title="A title on its own" />
			</Variant>
			<Variant label="breadcrumb trail">
				<SectionDetailHeader breadcrumbTrail={breadcrumbTrail} title="Under a vocabulary" />
			</Variant>
			<Variant label="five styles in, three shown">
				<SectionDetailHeader
					date={new Date()}
					kind={{ name: 'Mixes', url: '/mixes/' }}
					styles={styles}
					title={{ credit: { name: 'An Alias' }, title: 'A Mix' }}
				/>
			</Variant>
			<Variant label="Review, cited Release">
				{review ? (
					<SectionDetailHeader
						date={review.date}
						kind={{ name: 'Reviews', url: '/reviews/' }}
						labels={review.labels}
						releaseYear={review.releaseYear}
						styles={styles.slice(0, 1)}
						title={review.work}
					/>
				) : undefined}
			</Variant>
		</Specimen>
		<Specimen
			name="SectionCoda"
			note="Renders only when a row returns something."
			source="src/components/sections/section-coda.astro"
		>
			<SectionCoda>
				<TermLinks heading="Themes" terms={themes} />
				<TermLinks heading="Labels" terms={labels} />
			</SectionCoda>
		</Specimen>
	</Section>
	<Section note="Originals are gitignored; a missing file renders nothing." title="Media">
		<Specimen
			name="MediaImage"
			note="Never upscales past the original."
			source="src/components/parts/media-image.astro"
		>
			{heroPath ? <MediaImage alt="" path={heroPath} width={400} /> : undefined}
		</Specimen>
		<Specimen
			name="media-frame"
			note="Shown empty; the LQIP covers it in use."
			source="src/styles/main/parts/utilities.css"
		>
			<div class="media-frame aspect-square w-40 rounded-xs"></div>
		</Specimen>
		<Specimen name="MediaFeatured" source="src/components/parts/media-featured.astro">
			{review?.image ? <MediaFeatured alt={review.title} path={review.image} /> : undefined}
		</Specimen>
	</Section>
	<Section title="Audio">
		<Specimen
			name="AudioLinks"
			note="The Queued state is set by the site host, so it shows on a Mix Detail Page only."
			source="src/components/parts/audio-links.astro"
		>
			<Variant label="with PlayerControls">
				{mix?.queueItem ? (
					<AudioLinks cueSlug={mix.cueSlug} files={mix.files} links={mix.links}>
						<PlayerControls itemId={mix.queueItem.itemId} />
					</AudioLinks>
				) : undefined}
			</Variant>
			<Variant label="with cueSlug">
				{mix ? <AudioLinks cueSlug={mix.cueSlug} files={mix.files} links={mix.links} /> : undefined}
			</Variant>
			<Variant label="no cueSlug">{mix ? <AudioLinks files={mix.files} /> : undefined}</Variant>
			<Variant label="links only">
				<AudioLinks links={mix?.links} />
			</Variant>
		</Specimen>
		<Specimen
			name="AudioCounts"
			note="Only downloads is real data."
			source="src/components/parts/audio-counts.astro"
		>
			<Variant label="fixtures">
				{mix ? (
					<AudioCounts
						downloads={mix.downloads}
						listeningSeconds={2400}
						listens={642}
						mixcloudPlays={38_216}
						soundcloudPlays={9412}
						streams={1204}
					/>
				) : undefined}
			</Variant>
			<Variant label="singulars">
				<AudioCounts
					downloads={1}
					listeningSeconds={3600}
					listens={1}
					mixcloudPlays={1}
					soundcloudPlays={1}
					streams={1}
				/>
			</Variant>
		</Specimen>
	</Section>
	<PlayerSection items={playerItems} labels={playerLabels} seekSeconds={seekSeconds} />
	<Section
		note="Drawn per request from <code>element.tsx</code>, so edit and reload. Half size."
		title="Open Graph"
	>
		<Specimen name="Cards" source="packages/scripts/src/og-image/element.tsx">
			{openGraphCards.length > 0 ? (
				<ul class="grid gap-6 sm:grid-cols-2">
					{openGraphCards.map((card) => (
						<li>
							<img
								alt={card.label}
								class="w-full rounded-sm border border-surface-700"
								height={315}
								loading="lazy"
								src={`/inventory/og/${card.key}.jpg`}
								width={600}
							/>
							<div class="mt-2 font-mono text-xs text-ink-600">{card.label}</div>
							<div class="font-mono text-[0.6875rem] text-ink-700">{card.entry.outputId}</div>
						</li>
					))}
				</ul>
			) : (
				<p class="text-sm text-ink-600">No entries to sample a card from.</p>
			)}
		</Specimen>
	</Section>
	<Section title="Empty states">
		<Specimen
			name="Components that render nothing"
			note="TermLinks, SectionRelated, Selections and TrackList handed an empty array, AudioLinks handed nothing; each returns <code>undefined</code>. The dashed frame is this page's."
		>
			<div class="rounded-sm border border-dashed border-ink-700 p-4">
				<TermLinks heading="Styles" terms={[]} />
				<SectionRelated items={[]} />
				<Selections items={[]} />
				<TrackList tracks={[]} />
				<AudioLinks />
			</div>
		</Specimen>
	</Section>
</MainSite>
