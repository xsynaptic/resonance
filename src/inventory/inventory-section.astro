---
import { toSlug } from '#lib/utils/text.ts';

interface Props {
	note?: string | undefined;
	title: string;
}

const { note, title } = Astro.props;

const id = toSlug(title);
---

<section class="mb-14 scroll-mt-8 border-t border-surface-400 pt-10" id={id}>
	<p class="mb-1 font-mono text-xs font-bold tracking-[0.12em] text-ink-700 uppercase">{title}</p>
	{
		note ? (
			<p class="mb-6 content-measure text-sm leading-relaxed text-ink-600" set:html={note} />
		) : undefined
	}
	<slot />
</section>
