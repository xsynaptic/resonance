---
import type { Page } from 'astro';

import type { ContentCatalogItem } from '#lib/catalog/catalog-types.ts';
import type { LinkedName } from '#lib/utils/terms.ts';

import MainSite from '#components/main/main-site.astro';
import Anchor from '#components/parts/anchor.astro';
import EntryCard from '#components/parts/entry-card.astro';
import PaginationSelect from '#components/parts/pagination-select.astro';
import SectionDetailHeader from '#components/sections/section-detail-header.astro';
import { collectionLabels } from '#lib/catalog/catalog-labels.ts';
import { getArchivePath, getArchiveYearPath } from '#lib/collections/archive/archive-data.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getAbsoluteUrl } from '#lib/utils/routing.ts';
import { buildCollectionGraph } from '#lib/utils/seo-structured-data.ts';
import { getOpenGraphId } from '#lib/utils/seo.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';

interface Props {
	newerYear?: number | undefined;
	olderYear?: number | undefined;
	page: Page<ContentCatalogItem>;
	year: number;
}

const { newerYear, olderYear, page, year } = Astro.props;

const title = String(year);

const breadcrumbTrail: Array<LinkedName> = [
	{ name: t('collection.archive.title'), url: getArchivePath() },
];

const pageUrl = getAbsoluteUrl(Astro.url.pathname);
const schemas =
	page.currentPage === 1
		? buildCollectionGraph({ description: undefined, title, trail: breadcrumbTrail, url: pageUrl })
		: undefined;
---

<MainSite
	noIndex={page.currentPage > 1}
	openGraphId={getOpenGraphId('index', 'archive')}
	schemas={schemas}
	title={title}
>
	<div class="mb-6">
		<SectionDetailHeader breadcrumbTrail={breadcrumbTrail} title={title} />
		<nav
			aria-label={t('archive.yearsLabel')}
			class="mt-3 flex items-center gap-6 text-sm font-medium tabular-nums select-none"
			data-nosnippet
		>
			{olderYear === undefined ? undefined : (
				<span class="flex gap-1">
					<span class="text-highlight-500">&lsaquo;</span>
					<Anchor
						aria-label={formatStringTemplate(t('archive.olderYear'), { year: olderYear })}
						href={getArchiveYearPath(olderYear)}
					>
						{olderYear}
					</Anchor>
				</span>
			)}
			{newerYear === undefined ? undefined : (
				<span class="flex gap-1">
					<Anchor
						aria-label={formatStringTemplate(t('archive.newerYear'), { year: newerYear })}
						href={getArchiveYearPath(newerYear)}
					>
						{newerYear}
					</Anchor>
					<span class="text-highlight-500">&rsaquo;</span>
				</span>
			)}
		</nav>
	</div>
	<ul class="entry-grid">
		{page.data.map((item, index) => (
			<li>
				<EntryCard
					date={item.date}
					href={item.url}
					image={item.image}
					priority={index === 0}
					releaseTitle={item.releaseTitle}
					subtitle={collectionLabels[item.collection]}
					title={item.title}
				/>
			</li>
		))}
	</ul>
	<PaginationSelect class="mt-8" page={page} />
</MainSite>
