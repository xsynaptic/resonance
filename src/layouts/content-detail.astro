---
import type { ResolvedRef } from '#lib/utils/terms.ts';

import MainSite from '#components/main/main-site.astro';
import { formatDate } from '#lib/utils/date.ts';

interface Props {
	date?: Date | undefined;
	description?: string | undefined;
	kind?: ResolvedRef | undefined;
	openGraphId: string;
	title: string;
}

const { date, description, kind, openGraphId, title } = Astro.props;
---

<MainSite
	openGraphId={openGraphId}
	openGraphType="article"
	title={title}
	{...description ? { description } : {}}
>
	<article>
		<header class="mb-10">
			<h1 class="text-h1">{title}</h1>
			{
				kind || date ? (
					<div class="meta-row mt-3">
						{kind ? (
							<span>
								<a class="text-highlight-400 hover:text-highlight-300" href={kind.url}>
									{kind.label}
								</a>
							</span>
						) : undefined}
						{date ? (
							<span>
								Posted: <time datetime={date.toISOString()}>{formatDate(date)}</time>
							</span>
						) : undefined}
					</div>
				) : undefined
			}
		</header>
		<div class="prose-x">
			<slot />
		</div>
		<slot name="sections" />
	</article>
</MainSite>
