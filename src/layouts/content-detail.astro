---
import type { Thing } from '#lib/utils/seo-structured-data.ts';
import type { ResolvedRef } from '#lib/utils/terms.ts';

import MainSite from '#components/main/main-site.astro';
import SearchThumbnail from '#components/search/search-thumbnail.astro';
import SectionDetailHeader from '#components/sections/section-detail-header.astro';
import SectionDetailHero from '#components/sections/section-detail-hero.astro';

interface Props {
	date?: Date | undefined;
	description?: string | undefined;
	imageFeatured?: string | undefined;
	imageHero?: string | undefined;
	kind?: ResolvedRef | undefined;
	openGraphId: string;
	schemas?: Array<Thing> | undefined;
	styles?: Array<ResolvedRef> | undefined;
	title: string;
}

const { date, description, imageFeatured, imageHero, kind, openGraphId, schemas, styles, title } =
	Astro.props;
---

<MainSite
	openGraphId={openGraphId}
	openGraphType="article"
	publishedTime={date}
	schemas={schemas}
	title={title}
	{...(description ? { description } : {})}
>
	{imageHero ? (
		<SectionDetailHero
			date={date}
			kind={kind}
			path={imageHero}
			slot="hero"
			styles={styles}
			title={title}
		/>
	) : undefined}
	<article data-pagefind-body>
		<SearchThumbnail path={imageFeatured} />
		{imageHero ? undefined : (
			<div class="mb-10 content-measure">
				<SectionDetailHeader date={date} kind={kind} styles={styles} title={title} />
			</div>
		)}
		<div class="prose-x content-measure">
			<slot />
		</div>
		<slot name="sections" />
		<slot name="comments" />
	</article>
</MainSite>
