---
import type { ResolvedRef } from '#lib/utils/terms.ts';

import MainSite from '#components/main/main-site.astro';
import SectionDetailHeader from '#components/sections/section-detail-header.astro';
import SectionDetailHero from '#components/sections/section-detail-hero.astro';

interface Props {
	date?: Date | undefined;
	description?: string | undefined;
	imageHero?: string | undefined;
	kind?: ResolvedRef | undefined;
	openGraphId: string;
	styles?: Array<ResolvedRef> | undefined;
	title: string;
}

const { date, description, imageHero, kind, openGraphId, styles, title } = Astro.props;
---

<MainSite
	openGraphId={openGraphId}
	openGraphType="article"
	title={title}
	{...description ? { description } : {}}
>
	{
		imageHero ? (
			<SectionDetailHero
				date={date}
				kind={kind}
				path={imageHero}
				slot="hero"
				styles={styles}
				title={title}
			/>
		) : undefined
	}
	<article>
		{
			imageHero ? undefined : (
				<div class="mb-10 content-measure">
					<SectionDetailHeader date={date} kind={kind} styles={styles} title={title} />
				</div>
			)
		}
		<div class="prose-x">
			<slot />
		</div>
		<slot name="sections" />
	</article>
</MainSite>
