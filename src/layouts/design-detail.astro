---
import type { CollectionEntry } from 'astro:content';

import { render } from 'astro:content';

import TermLinks from '#components/parts/term-links.astro';
import ContentDetail from '#layouts/content-detail.astro';
import { resolveLabelLinks } from '#lib/utils/terms.ts';

interface Props {
	entry: CollectionEntry<'designs'>;
}

const { entry } = Astro.props;

const { Content } = await render(entry);

const labelTerms = await resolveLabelLinks(entry.data.labels);
---

<ContentDetail
	date={entry.data.date}
	image={entry.data.imageFeatured}
	kind="Album Artwork"
	title={entry.data.title}
	{...entry.data.description ? { description: entry.data.description } : {}}
>
	<Content />
	<Fragment slot="sections">
		<div class="mt-8 space-y-2">
			<TermLinks heading="Labels" terms={labelTerms} />
		</div>
	</Fragment>
</ContentDetail>
