---
import type { Page } from 'astro';

import type { ContentItem } from '#lib/catalog/catalog-data.ts';

import MainSite from '#components/main/main-site.astro';
import EntryCard from '#components/parts/entry-card.astro';
import ListYearHeading from '#components/parts/list-year-heading.astro';
import PaginationSelect from '#components/parts/pagination-select.astro';
import { groupByYear } from '#lib/utils/group-by-year.ts';

interface Props {
	page: Page<ContentItem>;
	title: string;
}

const { page, title } = Astro.props;

const groups = groupByYear(page.data);
---

<MainSite title={title}>
	<h1 class="mb-6 text-4xl">{title}</h1>
	{
		groups.map((group) => (
			<section class="mb-8">
				<ListYearHeading year={group.year} />
				<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
					{group.items.map((item) => (
						<li>
							<EntryCard
								date={item.date}
								href={item.url}
								image={item.image}
								subtitle={item.subtitle}
								title={item.title}
							/>
						</li>
					))}
				</ul>
			</section>
		))
	}
	<PaginationSelect class="mt-8" page={page} />
</MainSite>
