---
import type { Page } from 'astro';

import type { ContentCatalogItem, ContentCollectionKey } from '#lib/catalog/catalog-types.ts';

import MainSite from '#components/main/main-site.astro';
import EntryCardItem from '#components/parts/entry-card-item.astro';
import ListGroupHeading from '#components/parts/list-group-heading.astro';
import PageTitle from '#components/parts/page-title.astro';
import PaginationSelect from '#components/parts/pagination-select.astro';
import { toExcerpt } from '#lib/utils/markdown.ts';
import { getAbsoluteUrl } from '#lib/utils/routing.ts';
import { buildCollectionGraph } from '#lib/utils/seo-structured-data.ts';
import { getOpenGraphId } from '#lib/utils/seo.ts';
import { getYearGroups } from '#lib/utils/year-groups.ts';

interface Props {
	collection: ContentCollectionKey;
	description?: string | undefined;
	groupByYear?: boolean | undefined;
	page: Page<ContentCatalogItem>;
	title: string;
}

const { collection, description, groupByYear = false, page, title } = Astro.props;

const metaDescription = description ? await toExcerpt(description) : undefined;

const pageUrl = getAbsoluteUrl(Astro.url.pathname);
const schemas =
	page.currentPage === 1
		? buildCollectionGraph({ description: metaDescription, title, url: pageUrl })
		: undefined;

const groups: Array<{ items: Array<ContentCatalogItem>; year?: number }> = groupByYear
	? getYearGroups(page.data)
	: [{ items: page.data }];
---

<MainSite
	noIndex={page.currentPage > 1}
	openGraphId={getOpenGraphId('index', collection)}
	schemas={schemas}
	title={title}
	{...(metaDescription ? { description: metaDescription } : {})}
>
	<PageTitle title={title} {...(description ? { description } : {})} />
	{groups.map((group, groupIndex) => (
		<section class="mb-8">
			{group.year === undefined ? undefined : <ListGroupHeading label={String(group.year)} />}
			<ul class="entry-grid">
				{group.items.map((item, itemIndex) => (
					<EntryCardItem item={item} priority={groupIndex === 0 && itemIndex === 0} />
				))}
			</ul>
		</section>
	))}
	<PaginationSelect class="mt-8" page={page} />
</MainSite>
