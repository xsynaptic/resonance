---
import type { Page } from 'astro';

import type { ContentCatalogItem } from '#lib/catalog/catalog-types.ts';

import MainSite from '#components/main/main-site.astro';
import EntryCard from '#components/parts/entry-card.astro';
import ListGroupHeading from '#components/parts/list-group-heading.astro';
import PageTitle from '#components/parts/page-title.astro';
import PaginationSelect from '#components/parts/pagination-select.astro';
import { toExcerpt } from '#lib/utils/text.ts';
import { getYearGroups } from '#lib/utils/year-groups.ts';

interface Props {
	description?: string | undefined;
	groupByYear?: boolean | undefined;
	page: Page<ContentCatalogItem>;
	title: string;
}

const { description, groupByYear = false, page, title } = Astro.props;

const metaDescription = description ? await toExcerpt(description) : undefined;

const groups: Array<{ items: Array<ContentCatalogItem>; year?: number }> = groupByYear
	? getYearGroups(page.data)
	: [{ items: page.data }];
---

<MainSite
	noIndex={page.currentPage > 1}
	title={title}
	{...metaDescription ? { description: metaDescription } : {}}
>
	<PageTitle title={title} {...description ? { description } : {}} />
	{
		groups.map((group, groupIndex) => (
			<section class="mb-8">
				{group.year === undefined ? undefined : <ListGroupHeading label={String(group.year)} />}
				<ul class="entry-grid">
					{group.items.map((item, itemIndex) => (
						<li>
							<EntryCard
								date={item.date}
								href={item.url}
								image={item.image}
								priority={groupIndex === 0 && itemIndex === 0}
								releaseTitle={item.releaseTitle}
								subtitle={item.subtitle}
								title={item.title}
							/>
						</li>
					))}
				</ul>
			</section>
		))
	}
	<PaginationSelect class="mt-8" page={page} />
</MainSite>
