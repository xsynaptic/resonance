---
import type { CollectionEntry } from 'astro:content';

import { render } from 'astro:content';

import CommentsSection from '#components/comments/comments-section.astro';
import EmbedAudio from '#components/embed/embed-audio.astro';
import AudioCounts from '#components/parts/audio-counts.astro';
import AudioLinks from '#components/parts/audio-links.astro';
import TermLinks from '#components/parts/term-links.astro';
import SectionCoda from '#components/sections/section-coda.astro';
import SectionRelated from '#components/sections/section-related.astro';
import ReleaseDetail from '#layouts/release-detail.astro';
import { getRelatedItems } from '#lib/catalog/catalog-related.ts';
import { getDownloadCount } from '#lib/collections/downloads/downloads-data.ts';
import { hasMixTimestamps } from '#lib/collections/mixes/mixes-cue.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getImageFeaturedId } from '#lib/image/image-featured.ts';
import { getMixcloudPlayCount } from '#lib/mixcloud/mixcloud-stats.ts';
import { getEntryDescription } from '#lib/utils/description.ts';
import { getOpenGraphId } from '#lib/utils/seo.ts';
import { resolveRefs, resolveTermLinks } from '#lib/utils/terms.ts';

interface Props {
	entry: CollectionEntry<'mixes'>;
}

const { entry } = Astro.props;

const { Content } = await render(entry);

const aliasTerms = await resolveTermLinks(
	'artists',
	entry.data.alias ? [entry.data.alias] : undefined,
);
const styleTerms = await resolveTermLinks('styles', entry.data.styles);
const themeTerms = await resolveTermLinks('themes', entry.data.themes);
const labelTerms = await resolveRefs('labels', entry.data.labels);
const downloads = await getDownloadCount(entry.data.files);
const mixcloudPlays = await getMixcloudPlayCount(entry.data.mixcloudEmbed);
const relatedItems = await getRelatedItems(entry);
const description = await getEntryDescription(entry);

const [alias] = aliasTerms;
const imageFeaturedId = getImageFeaturedId(entry.data.imageFeatured);
---

<ReleaseDetail
	date={entry.data.dateCreated}
	kind={{ label: t('collection.mixes.title'), url: '/mixes/' }}
	labels={labelTerms}
	openGraphId={getOpenGraphId(entry.collection, entry.id)}
	releaseTitle={entry.data.title}
	styles={styleTerms}
	title={entry.data.title}
	{...alias ? { artist: alias } : {}}
	{...imageFeaturedId ? { image: imageFeaturedId } : {}}
	{...description ? { description } : {}}
>
	<Content />
	<EmbedAudio
		mixcloudEmbed={entry.data.mixcloudEmbed}
		slot="media"
		soundcloudEmbed={entry.data.soundcloudEmbed}
	/>
	<Fragment slot="links">
		<AudioLinks
			files={entry.data.files}
			links={entry.data.links}
			{...hasMixTimestamps(entry) ? { cueSlug: entry.id } : {}}
		/>
		<AudioCounts downloads={downloads} mixcloudPlays={mixcloudPlays} />
	</Fragment>
	<Fragment slot="sections">
		<SectionCoda>
			<TermLinks heading={t('collection.themes.title')} terms={themeTerms} />
		</SectionCoda>
	</Fragment>
	<SectionRelated items={relatedItems} slot="related" />
	{
		entry.data.commentsEnabled === false ? undefined : (
			<CommentsSection
				collection="mixes"
				entryId={entry.id}
				formerIds={entry.data.formerIds}
				slot="comments"
			/>
		)
	}
</ReleaseDetail>
