---
import type { CollectionEntry } from 'astro:content';

import { render } from 'astro:content';

import EmbedAudio from '#components/embed/embed-audio.astro';
import AudioLinks from '#components/parts/audio-links.astro';
import TermLinks from '#components/parts/term-links.astro';
import ContentDetail from '#layouts/content-detail.astro';
import { resolveLabelLinks, resolveTermLinks } from '#lib/utils/terms.ts';

interface Props {
	entry: CollectionEntry<'mixes'>;
}

const { entry } = Astro.props;

const { Content } = await render(entry);

const artistTerms = await resolveTermLinks('artists', entry.data.artists);
const styleTerms = await resolveTermLinks('styles', entry.data.styles);
const labelTerms = await resolveLabelLinks(entry.data.labels);
---

<ContentDetail
	date={entry.data.dateCreated}
	kind="Mix"
	title={entry.data.title}
	{...entry.data.description ? { description: entry.data.description } : {}}
>
	<Content />
	<EmbedAudio
		mixcloudEmbed={entry.data.mixcloudEmbed}
		slot="media"
		soundcloudEmbed={entry.data.soundcloudEmbed}
	/>
	<Fragment slot="sections">
		<div class="mt-8">
			<AudioLinks links={entry.data.links} />
		</div>
		<div class="mt-8 space-y-2">
			<TermLinks heading="Artists" terms={artistTerms} />
			<TermLinks heading="Styles" terms={styleTerms} />
			<TermLinks heading="Labels" terms={labelTerms} />
		</div>
	</Fragment>
</ContentDetail>
