---
import type { CollectionEntry } from 'astro:content';

import { getCollectionPath } from '@xsynaptic/shared/routing';
import { render } from 'astro:content';

import EmbedAudio from '#components/embed/embed-audio.astro';
import AudioCounts from '#components/parts/audio-counts.astro';
import AudioLinks from '#components/parts/audio-links.astro';
import EntryTermLinks from '#components/parts/entry-term-links.astro';
import PlayerControls from '#components/player/player-controls.astro';
import PlayerPayload from '#components/player/player-payload.astro';
import WorkDetail from '#layouts/work-detail.astro';
import { getDownloadCount } from '#lib/collections/downloads/downloads-data.ts';
import { hasMixTimestamps } from '#lib/collections/mixes/mixes-cue.ts';
import { getMixQueueItem } from '#lib/collections/mixes/mixes-queue.ts';
import { getMixSchemas } from '#lib/collections/mixes/mixes-schema.ts';
import { resolveEntryTerms } from '#lib/collections/terms/term-ranking.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getMixcloudPlayCount } from '#lib/platform-stats/mixcloud-stats.ts';
import { getSoundcloudPlayCount } from '#lib/platform-stats/soundcloud-stats.ts';
import { isPlayerEnabled, site } from '#lib/site.ts';
import { getEntryDescription } from '#lib/utils/description.ts';
import { getAbsoluteUrl } from '#lib/utils/routing.ts';
import { getOpenGraphId, getOpenGraphImageUrl } from '#lib/utils/seo.ts';
import { toTrackGroups } from '#lib/utils/track-groups.ts';
import { getWorkTitle } from '#lib/utils/work-title.ts';

interface Props {
	entry: CollectionEntry<'mixes'>;
}

const { entry } = Astro.props;

const { Content } = await render(entry);

const work = await getWorkTitle(entry);
const { labelTerms, styleTerms, styleTermsRanked, themeTerms } = await resolveEntryTerms(
	entry.data,
);
const downloads = await getDownloadCount(entry.data);
const mixcloudPlays = await getMixcloudPlayCount(entry.data.mixcloudLink);
const soundcloudPlays = await getSoundcloudPlayCount(entry.data.soundcloudLink);
const description = await getEntryDescription(entry);

const openGraphId = getOpenGraphId(entry.collection, entry.id);

const kind = { name: t('collection.mixes.title'), url: getCollectionPath('mixes') };
const pageUrl = getAbsoluteUrl(Astro.url.pathname);
const schemas = getMixSchemas(entry, {
	description,
	imageUrl: getOpenGraphImageUrl(openGraphId, Astro.site),
	kind,
	url: pageUrl,
});

const queueItem = isPlayerEnabled
	? await getMixQueueItem(entry, work.credit?.name ?? site.title)
	: undefined;

if (queueItem) Astro.locals.playerMixId = entry.id;

// A group naming its own files renders those downloads inline, so the header would otherwise offer them twice
const hasGroupFiles = toTrackGroups(entry.data.tracks).some((group) => group.files !== undefined);
---

<WorkDetail
	description={description}
	entry={entry}
	kind={kind}
	labels={labelTerms}
	schemas={schemas}
	styles={styleTerms}
	work={work}
>
	<Content />
	<Fragment slot="media">
		<EmbedAudio mixcloudLink={entry.data.mixcloudLink} soundcloudLink={entry.data.soundcloudLink} />
		{queueItem ? <PlayerControls trackId={entry.id} /> : undefined}
		<PlayerPayload items={queueItem ? [queueItem] : []} />
	</Fragment>
	<Fragment slot="actions">
		<AudioLinks
			links={entry.data.links}
			{...(hasGroupFiles ? {} : { files: entry.data.files })}
			{...(hasMixTimestamps(entry) ? { cueSlug: entry.id } : {})}
		/>
	</Fragment>
	<Fragment slot="coda">
		<AudioCounts
			downloads={downloads}
			mixcloudPlays={mixcloudPlays}
			soundcloudPlays={soundcloudPlays}
		/>
		<EntryTermLinks styles={styleTermsRanked} themes={themeTerms} />
	</Fragment>
</WorkDetail>
