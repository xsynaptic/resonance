---
import type { CollectionEntry } from 'astro:content';

import ProseDetail from '#layouts/prose-detail.astro';
import { getPageSchemas } from '#lib/collections/pages/pages-schema.ts';
import { getEntryDescription } from '#lib/utils/description.ts';
import { getAbsoluteUrl } from '#lib/utils/routing.ts';

interface Props {
	entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;

const description = await getEntryDescription(entry);

const pageUrl = getAbsoluteUrl(Astro.url.pathname);
const schemas = getPageSchemas(entry, {
	description,
	url: pageUrl,
});
---

<ProseDetail description={description} entry={entry} schemas={schemas} />
