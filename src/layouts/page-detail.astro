---
import type { CollectionEntry } from 'astro:content';

import { render } from 'astro:content';

import { menuHeaderItems } from '#components/menu/menu-header.ts';
import { getMenuIdentityLinks } from '#components/menu/menu-utils.ts';
import ContentDetail from '#layouts/content-detail.astro';
import { getPageSchemas } from '#lib/collections/pages/pages-schema.ts';
import { getImageFeaturedId, getImageHeroId } from '#lib/image/image-featured.ts';
import { getEntryDescription } from '#lib/utils/description.ts';
import { getOpenGraphId } from '#lib/utils/seo.ts';

interface Props {
	entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;

const { Content } = await render(entry);

const description = await getEntryDescription(entry);
const imageFeaturedId = getImageFeaturedId(entry.data.imageFeatured);
const imageHeroId = getImageHeroId(entry.data.imageFeatured);
const openGraphId = getOpenGraphId(entry.collection, entry.id);

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const schemas = getPageSchemas(entry, {
	description,
	sameAs: getMenuIdentityLinks(menuHeaderItems),
	url: pageUrl,
});
---

<ContentDetail
	openGraphId={openGraphId}
	schemas={schemas}
	title={entry.data.title}
	{...imageFeaturedId ? { imageFeatured: imageFeaturedId } : {}}
	{...imageHeroId ? { imageHero: imageHeroId } : {}}
	{...description ? { description } : {}}
>
	<Content />
</ContentDetail>
