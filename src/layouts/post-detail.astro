---
import type { CollectionEntry } from 'astro:content';

import { render } from 'astro:content';

import TermLinks from '#components/parts/term-links.astro';
import SectionCoda from '#components/sections/section-coda.astro';
import ContentDetail from '#layouts/content-detail.astro';
import { getOpenGraphId } from '#lib/utils/seo.ts';
import { resolveRefs, resolveTermLinks } from '#lib/utils/terms.ts';

interface Props {
	entry: CollectionEntry<'posts'>;
}

const { entry } = Astro.props;

const { Content } = await render(entry);

const formatTerms = await resolveTermLinks(
	'formats',
	entry.data.format ? [entry.data.format] : undefined,
);
const styleTerms = await resolveTermLinks('styles', entry.data.styles);
const themeTerms = await resolveTermLinks('themes', entry.data.themes);
const labelTerms = await resolveRefs('labels', entry.data.labels);
---

<ContentDetail
	date={entry.data.dateCreated}
	kind={{ label: 'Blog', url: '/blog/' }}
	openGraphId={getOpenGraphId(entry.collection, entry.id)}
	styles={styleTerms}
	title={entry.data.title}
	{...entry.data.imageHero ? { imageHero: entry.data.imageHero } : {}}
	{...entry.data.description ? { description: entry.data.description } : {}}
>
	<Content />
	<Fragment slot="sections">
		<SectionCoda class="mt-10 content-measure">
			<TermLinks heading="Format" terms={formatTerms} />
			<TermLinks heading="Themes" terms={themeTerms} />
			<TermLinks heading="Labels" terms={labelTerms} />
		</SectionCoda>
	</Fragment>
</ContentDetail>
