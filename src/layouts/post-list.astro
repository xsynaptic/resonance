---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';

import { getContentPath } from '@xsynaptic/shared/routing';
import { render } from 'astro:content';

import MainSite from '#components/main/main-site.astro';
import ListPageTitle from '#components/parts/list-page-title.astro';
import PaginationSelect from '#components/parts/pagination-select.astro';
import SectionPostExcerpt from '#components/sections/section-post-excerpt.astro';
import { getPagination } from '#lib/utils/pagination.ts';
import { getAbsoluteUrl } from '#lib/utils/routing.ts';
import { buildCollectionGraph } from '#lib/utils/seo-structured-data.ts';
import { getOpenGraphId } from '#lib/utils/seo.ts';

interface Props {
	page: Page<CollectionEntry<'posts'>>;
	title: string;
}

const { page, title } = Astro.props;

const posts = await Promise.all(
	page.data.map(async (entry) => {
		const { Content } = await render(entry);

		return { Content, entry };
	}),
);

const pageUrl = getAbsoluteUrl(Astro.url.pathname);
const schemas =
	page.currentPage === 1
		? buildCollectionGraph({ description: undefined, title, url: pageUrl })
		: undefined;
---

<MainSite
	noIndex={page.currentPage > 1}
	openGraphId={getOpenGraphId('index', 'posts')}
	schemas={schemas}
	title={title}
>
	<ListPageTitle title={title} />
	{posts.map(({ Content, entry }) => (
		<SectionPostExcerpt
			date={entry.data.dateCreated}
			href={getContentPath('posts', entry.id)}
			title={entry.data.title}
		>
			<Content />
		</SectionPostExcerpt>
	))}
	<PaginationSelect class="mt-8" pagination={getPagination(page)} />
</MainSite>
