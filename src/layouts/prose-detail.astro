---
import type { PageOpenGraphCard } from '@xsynaptic/shared/open-graph';
import type { CollectionEntry } from 'astro:content';

import { render } from 'astro:content';

import type { Thing } from '#lib/utils/seo-structured-data.ts';
import type { LinkedName } from '#lib/utils/terms.ts';

import MainSite from '#components/main/main-site.astro';
import SearchThumbnail from '#components/search/search-thumbnail.astro';
import SectionDetailHeader from '#components/sections/section-detail-header.astro';
import SectionDetailHero from '#components/sections/section-detail-hero.astro';
import { getImageFeaturedId, getImageHeroId } from '#lib/image/image-featured.ts';

interface Props {
	date?: Date | undefined;
	description: string | undefined;
	entry: CollectionEntry<'pages' | 'posts'>;
	kind?: LinkedName | undefined;
	openGraphCard: PageOpenGraphCard;
	schemas: Array<Thing>;
	styles?: Array<LinkedName> | undefined;
}

const { date, description, entry, kind, openGraphCard, schemas, styles } = Astro.props;

const { Content } = await render(entry);

const imageFeaturedId = getImageFeaturedId(entry.data.imageFeatured);
const imageHeroId = getImageHeroId(entry.data.imageFeatured);
---

<MainSite
	description={description}
	openGraphCard={openGraphCard}
	openGraphType="article"
	publishedTime={date}
	schemas={schemas}
	title={entry.data.title}
>
	{imageHeroId ? (
		<SectionDetailHero
			date={date}
			kind={kind}
			path={imageHeroId}
			slot="hero"
			styles={styles}
			title={entry.data.title}
		/>
	) : undefined}
	<article data-pagefind-body>
		<SearchThumbnail kind={kind?.name} path={imageFeaturedId} />
		{imageHeroId ? undefined : (
			<div class="mb-4 content-measure">
				<SectionDetailHeader date={date} kind={kind} styles={styles} title={entry.data.title} />
			</div>
		)}
		<div class="prose-x content-measure" data-pagefind-weight="2">
			<Content />
		</div>
		<slot />
	</article>
</MainSite>
