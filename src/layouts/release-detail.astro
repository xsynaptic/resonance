---
import type { ResolvedRef } from '#lib/utils/terms.ts';

import MainSite from '#components/main/main-site.astro';
import MediaFeatured from '#components/parts/media-featured.astro';
import SectionDetailHeader from '#components/sections/section-detail-header.astro';
import { renderSlot } from '#lib/utils/astro.ts';

interface Props {
	artist?: ResolvedRef | undefined;
	date?: Date | undefined;
	description?: string | undefined;
	image?: string | undefined;
	kind: ResolvedRef;
	labels?: Array<ResolvedRef> | undefined;
	openGraphId: string;
	// The title half of the split heading; equals `title` when there is no artist prefix to split off
	releaseTitle: string;
	releaseYear?: string | undefined;
	styles?: Array<ResolvedRef> | undefined;
	title: string;
}

const {
	artist,
	date,
	description,
	image,
	kind,
	labels,
	openGraphId,
	releaseTitle,
	releaseYear,
	styles,
	title,
} = Astro.props;

const media = await renderSlot(Astro.slots, 'media');
const links = await renderSlot(Astro.slots, 'links');
const body = await renderSlot(Astro.slots, 'default');
const sections = await renderSlot(Astro.slots, 'sections');
---

<MainSite
	openGraphId={openGraphId}
	openGraphType="article"
	title={title}
	{...description ? { description } : {}}
>
	<article>
		<SectionDetailHeader
			date={date}
			kind={kind}
			labels={labels}
			releaseTitle={releaseTitle}
			releaseYear={releaseYear}
			styles={styles}
			title={title}
			{...artist ? { artist } : {}}
		/>
		<div class="release-grid mt-10">
			{
				image ? (
					<div class="release-cover">
						<MediaFeatured alt={title} path={image} />
					</div>
				) : undefined
			}
			<div class="release-body">
				{
					media ? (
						<div class="mb-4">
							<Fragment set:html={media} />
						</div>
					) : undefined
				}
				{
					links ? (
						<div class="mb-8">
							<Fragment set:html={links} />
						</div>
					) : undefined
				}
				{
					body ? (
						<div class="prose-x">
							<Fragment set:html={body} />
						</div>
					) : undefined
				}
			</div>
			{
				sections ? (
					<div class="release-footer">
						<Fragment set:html={sections} />
					</div>
				) : undefined
			}
		</div>
		<slot name="related" />
		<slot name="comments" />
	</article>
</MainSite>
