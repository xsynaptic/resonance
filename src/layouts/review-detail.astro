---
import type { CollectionEntry } from 'astro:content';

import { getCollectionPath } from '@xsynaptic/shared/routing';
import { render } from 'astro:content';

import type { IconId } from '#lib/utils/icon-types.ts';

import Button from '#components/parts/button.astro';
import EntryTermLinks from '#components/parts/entry-term-links.astro';
import TermLinks from '#components/parts/term-links.astro';
import WorkDetail from '#layouts/work-detail.astro';
import { getReviewSchemas } from '#lib/collections/reviews/reviews-schema.ts';
import { resolveEntryTerms } from '#lib/collections/terms/term-ranking.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getEntryDescription } from '#lib/utils/description.ts';
import { getLinkSourceLabel } from '#lib/utils/links.ts';
import { getAbsoluteUrl } from '#lib/utils/routing.ts';
import { resolveCredits, resolveTermLinks } from '#lib/utils/terms.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';
import { getWorkTitle } from '#lib/utils/work-title.ts';
import { getYoutubeSearchUrl } from '#lib/utils/youtube.ts';

interface Props {
	entry: CollectionEntry<'reviews'>;
}

interface ReviewAction {
	href: string;
	icon?: IconId | undefined;
	label: string;
}

const { entry } = Astro.props;

const { Content } = await render(entry);

const artistTerms = await resolveCredits('artists', entry.data.artists);
const { labelTerms, styleTerms, styleTermsRanked, themeTerms } = await resolveEntryTerms(
	entry.data,
);
const regionTerms = await resolveTermLinks('regions', entry.data.regions);
const eraTerms = await resolveTermLinks('eras', entry.data.eras);
const description = await getEntryDescription(entry);

const { discogsUrl, rating, releaseYear } = entry.data;

const work = await getWorkTitle(entry);

const youtubeUrl = getYoutubeSearchUrl(
	entry.data.youtubeSearch,
	work.credit ? [work.credit] : [],
	work.title,
);

// Every outbound link is a place to hear or buy the release, so all of them read as one row
const actions: Array<ReviewAction> = (entry.data.links ?? []).map((url) => ({
	href: url,
	label: getLinkSourceLabel(url),
}));

if (discogsUrl) actions.push({ href: discogsUrl, label: t('detail.discogs') });
if (youtubeUrl) actions.push({ href: youtubeUrl, icon: 'youtube', label: t('detail.youtube') });

const kind = { name: t('collection.reviews.title'), url: getCollectionPath('reviews') };
const pageUrl = getAbsoluteUrl(Astro.url.pathname);
const schemas = getReviewSchemas(entry, {
	artists: artistTerms,
	kind,
	labels: labelTerms,
	releaseTitle: work.title,
	url: pageUrl,
});
---

<WorkDetail
	description={description}
	entry={entry}
	kind={kind}
	labels={labelTerms}
	releaseYear={releaseYear}
	schemas={schemas}
	styles={styleTerms}
	work={work}
>
	<Content />
	<Fragment slot="actions">
		{actions.length > 0 ? (
			<ul class="flex flex-wrap gap-2" data-pagefind-ignore>
				{actions.map((action) => (
					<li>
						<Button
							as="a"
							href={action.href}
							rel="noreferrer"
							target="_blank"
							{...(action.icon ? { icon: action.icon } : {})}
						>
							{action.label}
						</Button>
					</li>
				))}
			</ul>
		) : undefined}
	</Fragment>
	<Fragment slot="coda">
		{rating ? (
			<p>
				{t('detail.rating.label')}{' '}
				<span class="text-ink-300">
					{formatStringTemplate(t('detail.rating.value'), { rating })}
				</span>
			</p>
		) : undefined}
		<TermLinks heading={t('collection.artists.title')} terms={artistTerms} />
		<TermLinks heading={t('collection.regions.title')} terms={regionTerms} />
		<TermLinks heading={t('collection.eras.title')} terms={eraTerms} />
		<EntryTermLinks styles={styleTermsRanked} themes={themeTerms} />
	</Fragment>
</WorkDetail>
