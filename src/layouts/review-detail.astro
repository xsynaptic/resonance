---
import type { CollectionEntry } from 'astro:content';

import { render } from 'astro:content';

import type { IconId } from '#lib/utils/icon-types.ts';

import CommentsSection from '#components/comments/comments-section.astro';
import ButtonLink from '#components/parts/button-link.astro';
import TermLinks from '#components/parts/term-links.astro';
import SectionCoda from '#components/sections/section-coda.astro';
import SectionRelated from '#components/sections/section-related.astro';
import ReleaseDetail from '#layouts/release-detail.astro';
import { getRelatedItems } from '#lib/catalog/catalog-related.ts';
import { getReviewSchemas } from '#lib/collections/reviews/reviews-schema.ts';
import { resolveStylesRanked } from '#lib/collections/terms/term-ranking.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getImageFeaturedId } from '#lib/image/image-featured.ts';
import { getEntryDescription } from '#lib/utils/description.ts';
import { splitReleaseTitle } from '#lib/utils/entries.ts';
import { getLinkSourceLabel } from '#lib/utils/links.ts';
import { getCollectionUrl, getSiteUrl } from '#lib/utils/routing.ts';
import { getOpenGraphId } from '#lib/utils/seo.ts';
import { resolveRefs, resolveTermLinks } from '#lib/utils/terms.ts';
import { formatStringTemplate } from '#lib/utils/text.ts';
import { getYoutubeSearchUrl } from '#lib/utils/youtube.ts';

interface Props {
	entry: CollectionEntry<'reviews'>;
}

interface ReviewAction {
	href: string;
	icon?: IconId | undefined;
	label: string;
}

const { entry } = Astro.props;

const { Content } = await render(entry);

const artistTerms = await resolveRefs('artists', entry.data.artists);
const styleTerms = await resolveTermLinks('styles', entry.data.styles);
const styleTermsRanked = await resolveStylesRanked(entry.data.styles);
const regionTerms = await resolveTermLinks('regions', entry.data.regions);
const eraTerms = await resolveTermLinks('eras', entry.data.eras);
const themeTerms = await resolveTermLinks('themes', entry.data.themes);
const labelTerms = await resolveRefs('labels', entry.data.labels);
const relatedItems = await getRelatedItems(entry);
const description = await getEntryDescription(entry);

const { discogsUrl, rating, releaseYear } = entry.data;
const imageFeaturedId = getImageFeaturedId(entry.data.imageFeatured);

// Contributors beyond the matched artist stay in the term links below, not in the heading
const { artist, title } = splitReleaseTitle(entry.data.title, entry.data.releaseTitle, artistTerms);

const youtubeUrl = getYoutubeSearchUrl(entry.data.youtubeSearch, artist ? [artist] : [], title);

// Every outbound link is a place to hear or buy the release, so all of them read as one row
const actions: Array<ReviewAction> = (entry.data.links ?? []).map((url) => ({
	href: url,
	label: getLinkSourceLabel(url),
}));

if (discogsUrl) actions.push({ href: discogsUrl, label: t('detail.discogs') });
if (youtubeUrl) actions.push({ href: youtubeUrl, icon: 'youtube', label: t('detail.youtube') });

const openGraphId = getOpenGraphId(entry.collection, entry.id);
const kind = { label: t('collection.reviews.title'), url: getCollectionUrl('reviews') };
const pageUrl = getSiteUrl(Astro.url.pathname);
const schemas = getReviewSchemas(entry, {
	artists: artistTerms,
	kind,
	labels: labelTerms,
	releaseTitle: title,
	url: pageUrl,
});
---

<ReleaseDetail
	date={entry.data.dateCreated}
	kind={kind}
	labels={labelTerms}
	openGraphId={openGraphId}
	releaseTitle={title}
	schemas={schemas}
	styles={styleTerms}
	title={entry.data.title}
	{...artist ? { artist } : {}}
	{...imageFeaturedId ? { image: imageFeaturedId } : {}}
	{...releaseYear ? { releaseYear } : {}}
	{...description ? { description } : {}}
>
	<Content />
	<Fragment slot="actions">
		{
			actions.length > 0 ? (
				<ul class="flex flex-wrap gap-2" data-pagefind-ignore>
					{actions.map((action) => (
						<li>
							<ButtonLink
								href={action.href}
								rel="noreferrer"
								target="_blank"
								{...(action.icon ? { icon: action.icon } : {})}
							>
								{action.label}
							</ButtonLink>
						</li>
					))}
				</ul>
			) : undefined
		}
	</Fragment>
	<Fragment slot="sections">
		<SectionCoda>
			{
				rating ? (
					<p>
						{t('detail.rating.label')}{' '}
						<span class="text-ink-300">
							{formatStringTemplate(t('detail.rating.value'), { rating })}
						</span>
					</p>
				) : undefined
			}
			<TermLinks heading={t('collection.artists.title')} terms={artistTerms} />
			<TermLinks heading={t('collection.regions.title')} terms={regionTerms} />
			<TermLinks heading={t('collection.eras.title')} terms={eraTerms} />
			<TermLinks heading={t('collection.styles.title')} terms={styleTermsRanked} />
			<TermLinks heading={t('collection.themes.title')} terms={themeTerms} />
		</SectionCoda>
	</Fragment>
	<SectionRelated items={relatedItems} slot="related" />
	{
		entry.data.commentsEnabled === false ? undefined : (
			<CommentsSection
				collection="reviews"
				entryId={entry.id}
				formerIds={entry.data.formerIds}
				slot="comments"
			/>
		)
	}
</ReleaseDetail>
