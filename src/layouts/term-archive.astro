---
import type { Page } from 'astro';
import type { CollectionEntry, CollectionKey } from 'astro:content';

import { render } from 'astro:content';

import type { ContentItem } from '#lib/catalog/catalog-data.ts';

import MainSite from '#components/main/main-site.astro';
import EntryCard from '#components/parts/entry-card.astro';
import PaginationSelect from '#components/parts/pagination-select.astro';
import TermLinks from '#components/parts/term-links.astro';
import { resolveRefs } from '#lib/utils/terms.ts';
import { toExcerpt } from '#lib/utils/text.ts';

interface Props {
	kind: string;
	page: Page<ContentItem>;
	term: CollectionEntry<
		'artists' | 'categories' | 'eras' | 'labels' | 'regions' | 'series' | 'styles' | 'tags'
	>;
}

const { kind, page, term } = Astro.props;

const { Content } = await render(term);

// Artists carry relationships (a group's members, a person's projects); other taxonomies do not
const memberLinks =
	term.collection === 'artists' ? await resolveRefs('artists', term.data.members) : [];
const projectLinks =
	term.collection === 'artists' ? await resolveRefs('artists', term.data.projects) : [];

// Description now lives in the body; derive a plain-text meta description from it for the page head
const body = term.body?.trim() ?? '';
const description = body === '' ? undefined : await toExcerpt(body);

const collectionLabels: Partial<Record<CollectionKey, string>> = {
	designs: 'Album Artwork',
	lists: 'List',
	mixes: 'Mix',
	posts: 'Writing',
	reviews: 'Review',
};
---

<MainSite title={term.data.title} {...description ? { description } : {}}>
	<header class="mb-6">
		<p class="mb-1 text-xs font-medium tracking-wide text-accent-400 uppercase">{kind}</p>
		<h1 class="text-3xl font-semibold text-ink-50">{term.data.title}</h1>
		{
			body === '' ? undefined : (
				<div class="prose-x mt-2">
					<Content />
				</div>
			)
		}
	</header>
	{
		memberLinks.length > 0 || projectLinks.length > 0 ? (
			<div class="mb-6 space-y-1">
				<TermLinks heading="Members" terms={memberLinks} />
				<TermLinks heading="Projects" terms={projectLinks} />
			</div>
		) : undefined
	}
	{
		page.data.length > 0 ? (
			<ul class="grid gap-4 sm:grid-cols-2">
				{page.data.map((entry) => (
					<li>
						<EntryCard
							date={entry.date}
							href={entry.url}
							image={entry.image}
							subtitle={collectionLabels[entry.collection]}
							title={entry.title}
						/>
					</li>
				))}
			</ul>
		) : (
			<p class="text-ink-500">Nothing here yet.</p>
		)
	}
	<PaginationSelect class="mt-8" page={page} />
</MainSite>
