---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';

import { getCollectionPath } from '@xsynaptic/shared/routing';
import { render } from 'astro:content';

import type { ContentCatalogItem } from '#lib/catalog/catalog-types.ts';
import type { LinkedName } from '#lib/utils/terms.ts';

import MainSite from '#components/main/main-site.astro';
import PaginationSelect from '#components/parts/pagination-select.astro';
import TermLinks from '#components/parts/term-links.astro';
import SearchThumbnail from '#components/search/search-thumbnail.astro';
import SectionAppearances from '#components/sections/section-appearances.astro';
import SectionDetailHeader from '#components/sections/section-detail-header.astro';
import SectionDetailHero from '#components/sections/section-detail-hero.astro';
import SectionEntries from '#components/sections/section-entries.astro';
import { isHierarchical } from '#lib/collections/terms/hierarchy.ts';
import { getTermRelations } from '#lib/collections/terms/term-relations.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { getImageFeaturedId, getImageHeroId } from '#lib/image/image-featured.ts';
import { getEntryDescription } from '#lib/utils/description.ts';
import { getPagination } from '#lib/utils/pagination.ts';
import { getAbsoluteUrl } from '#lib/utils/routing.ts';
import { buildCollectionGraph } from '#lib/utils/seo-structured-data.ts';
import { getOpenGraphId } from '#lib/utils/seo.ts';
import { resolveAncestors, resolveCredits } from '#lib/utils/terms.ts';

interface Props {
	appearances?: Array<ContentCatalogItem> | undefined;
	groupByYear?: boolean | undefined;
	items: Array<ContentCatalogItem>;
	page?: Page<ContentCatalogItem> | undefined;
	term: CollectionEntry<'artists' | 'eras' | 'labels' | 'regions' | 'series' | 'styles' | 'themes'>;
}

const { appearances, groupByYear = false, items, page, term } = Astro.props;

// Only the vocabularies passing `appearances` carry two sections, so only they label either one
const appearanceItems = appearances ?? [];
const isSectioned = appearances !== undefined;

const { Content } = await render(term);

const imageHeroId = getImageHeroId(term.data.imageFeatured);

// Only the first page of a paginated term carries the search body, its thumbnail and its relations
const isFirstPage = page === undefined || page.currentPage === 1;

// Artists carry relationships (a group's members, a person's projects); other terms do not
const memberLinks =
	term.collection === 'artists' ? await resolveCredits('artists', term.data.members) : [];
const projectLinks =
	term.collection === 'artists' ? await resolveCredits('artists', term.data.projects) : [];

const relationGroups = isFirstPage ? await getTermRelations(term.collection, term.id) : [];

// A term's description is its body, so the page head derives from it too
const body = term.body?.trim() ?? '';
const description = await getEntryDescription(term);

const breadcrumbTrail: Array<LinkedName> = [
	{
		name: t(`collection.${term.collection}.title`),
		url: getCollectionPath(term.collection),
	},
	...(isHierarchical(term.collection) ? await resolveAncestors(term.collection, term.id) : []),
];

const pageUrl = getAbsoluteUrl(Astro.url.pathname);
const schemas = isFirstPage
	? buildCollectionGraph({
			description,
			title: term.data.title,
			trail: breadcrumbTrail,
			url: pageUrl,
		})
	: undefined;
---

<MainSite
	description={description}
	noIndex={!isFirstPage}
	openGraphId={getOpenGraphId(term.collection, term.id)}
	schemas={schemas}
	title={term.data.title}
>
	{imageHeroId ? (
		<SectionDetailHero
			breadcrumbTrail={breadcrumbTrail}
			path={imageHeroId}
			slot="hero"
			title={term.data.title}
		/>
	) : undefined}
	<div class="mb-6" {...(isFirstPage ? { 'data-pagefind-body': '' } : {})}>
		{isFirstPage ? (
			<SearchThumbnail path={getImageFeaturedId(term.data.imageFeatured)} />
		) : undefined}
		{imageHeroId ? undefined : (
			<SectionDetailHeader breadcrumbTrail={breadcrumbTrail} title={term.data.title} />
		)}
		{body === '' ? undefined : (
			<div class="prose-x mt-2 content-measure" data-pagefind-weight="2">
				<Content />
			</div>
		)}
	</div>
	{memberLinks.length > 0 || projectLinks.length > 0 || relationGroups.length > 0 ? (
		<div class="mb-6 space-y-1">
			<TermLinks heading={t('artist.members')} terms={memberLinks} />
			<TermLinks heading={t('artist.projects')} terms={projectLinks} />
			{relationGroups.map((group) => (
				<TermLinks heading={group.heading} terms={group.terms} />
			))}
		</div>
	) : undefined}
	<SectionEntries groupByYear={groupByYear} isLabelled={isSectioned} items={items} />
	<SectionAppearances items={appearanceItems} />
	{page === undefined ? undefined : (
		<PaginationSelect class="mt-8" pagination={getPagination(page)} />
	)}
</MainSite>
