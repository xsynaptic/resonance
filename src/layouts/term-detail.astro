---
import type { Page } from 'astro';
import type { CollectionEntry, CollectionKey } from 'astro:content';

import { render } from 'astro:content';

import type { ContentItem } from '#lib/catalog/catalog-data.ts';
import type { ResolvedRef } from '#lib/utils/terms.ts';

import MainSite from '#components/main/main-site.astro';
import EntryCard from '#components/parts/entry-card.astro';
import ListYearHeading from '#components/parts/list-year-heading.astro';
import PaginationSelect from '#components/parts/pagination-select.astro';
import TermLinks from '#components/parts/term-links.astro';
import SectionDetailHeader from '#components/sections/section-detail-header.astro';
import { isHierarchical } from '#lib/collections/terms/hierarchy.ts';
import { groupByYear } from '#lib/utils/group-by-year.ts';
import { getOpenGraphId } from '#lib/utils/seo.ts';
import { resolveAncestors, resolveRefs } from '#lib/utils/terms.ts';
import { toExcerpt } from '#lib/utils/text.ts';

interface Props {
	page: Page<ContentItem>;
	term: CollectionEntry<
		'artists' | 'eras' | 'formats' | 'labels' | 'regions' | 'series' | 'styles' | 'themes'
	>;
}

const { page, term } = Astro.props;

const { Content } = await render(term);

// Artists carry relationships (a group's members, a person's projects); other terms do not
const memberLinks =
	term.collection === 'artists' ? await resolveRefs('artists', term.data.members) : [];
const projectLinks =
	term.collection === 'artists' ? await resolveRefs('artists', term.data.projects) : [];

// Description now lives in the body; derive a plain-text meta description from it for the page head
const body = term.body?.trim() ?? '';
const description = body === '' ? undefined : await toExcerpt(body);

const collectionLabels: Partial<Record<CollectionKey, string>> = {
	mixes: 'Mix',
	posts: 'Blog',
	reviews: 'Review',
};

// A series is a curated order (not chronological), so it stays flat; everything else groups by year
const yearGroups: Array<{ items: Array<ContentItem>; year?: number }> =
	term.collection === 'series' ? [{ items: page.data }] : groupByYear(page.data);

const breadcrumbTrail: Array<ResolvedRef> = [
	{
		label: term.collection.charAt(0).toUpperCase() + term.collection.slice(1),
		url: `/${term.collection}/`,
	},
	...(isHierarchical(term.collection) ? await resolveAncestors(term.collection, term.id) : []),
];
---

<MainSite
	openGraphId={getOpenGraphId(term.collection, term.id)}
	title={term.data.title}
	{...description ? { description } : {}}
>
	<div class="mb-6">
		<SectionDetailHeader breadcrumbTrail={breadcrumbTrail} title={term.data.title} />
		{
			body === '' ? undefined : (
				<div class="prose-x mt-2">
					<Content />
				</div>
			)
		}
	</div>
	{
		memberLinks.length > 0 || projectLinks.length > 0 ? (
			<div class="mb-6 space-y-1">
				<TermLinks heading="Members" terms={memberLinks} />
				<TermLinks heading="Projects" terms={projectLinks} />
			</div>
		) : undefined
	}
	{
		page.data.length > 0 ? (
			yearGroups.map((group) => (
				<section class="mb-8">
					{group.year === undefined ? undefined : <ListYearHeading year={group.year} />}
					<ul class="entry-grid">
						{group.items.map((entry) => (
							<li>
								<EntryCard
									date={entry.date}
									href={entry.url}
									image={entry.image}
									subtitle={collectionLabels[entry.collection]}
									title={entry.title}
								/>
							</li>
						))}
					</ul>
				</section>
			))
		) : (
			<p class="text-ink-600">Nothing here yet.</p>
		)
	}
	<PaginationSelect class="mt-8" page={page} />
</MainSite>
