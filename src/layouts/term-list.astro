---
import type { TitledCollectionKey } from '#lib/utils/terms.ts';

import MainSite from '#components/main/main-site.astro';
import PageTitle from '#components/parts/page-title.astro';
import TermDirectory from '#components/parts/term-directory.astro';
import { getDirectoryTerms } from '#lib/collections/terms/term-tree.ts';
import { buildCollectionGraph } from '#lib/utils/seo-structured-data.ts';

interface Props {
	collection: TitledCollectionKey;
	title: string;
}

const { collection, title } = Astro.props;

const terms = await getDirectoryTerms(collection);

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const schemas = buildCollectionGraph({ description: undefined, title, url: pageUrl });
---

<MainSite schemas={schemas} title={title}>
	<PageTitle title={title} />
	<TermDirectory terms={terms} />
</MainSite>
