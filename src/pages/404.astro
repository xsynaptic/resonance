---
import MainSite from '#components/main/main-site.astro';
import Anchor from '#components/parts/anchor.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
---

<MainSite title={t('notFound.title')}>
	<section class="mb-12">
		<h1 class="title-main">{t('notFound.title')}</h1>
		<p class="mt-2 content-measure text-ink-300">{t('notFound.body')}</p>
		<Anchor class="mt-6 inline-block font-bold" href="/">{t('notFound.link')}</Anchor>
	</section>
</MainSite>
