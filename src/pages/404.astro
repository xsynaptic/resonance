---
import MainSite from '#components/main/main-site.astro';
import Anchor from '#components/parts/anchor.astro';
---

<MainSite title="Page Not Found">
	<section class="mb-12">
		<h1 class="text-4xl">Page not found</h1>
		<p class="mt-2 content-measure text-ink-300">
			The page you are looking for does not exist or has moved.
		</p>
		<Anchor class="mt-6 inline-block font-bold" href="/"> Back to the home page </Anchor>
	</section>
</MainSite>
