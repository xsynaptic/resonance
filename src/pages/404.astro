---
import MainSite from '#components/main/main-site.astro';
---

<MainSite title="Page Not Found">
	<section class="mb-12">
		<h1 class="text-4xl font-bold text-ink-50">Page not found</h1>
		<p class="mt-2 max-w-prose text-ink-300">
			The page you are looking for does not exist or has moved.
		</p>
		<a
			class="mt-6 inline-block font-bold text-highlight-400 transition-colors hover:text-highlight-300"
			href="/"
		>
			Back to the home page
		</a>
	</section>
</MainSite>
