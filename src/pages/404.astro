---
import MainSite from '#components/main/main-site.astro';
import NotFoundSuggestions from '#components/not-found/not-found-suggestions.astro';
import { t } from '#lib/i18n/i18n-strings.ts';
---

<MainSite noIndex={true} title={t('notFound.title')}>
	<section class="mb-12">
		<h1 class="title-main">{t('notFound.title')}</h1>
		<p class="mt-2 content-measure text-ink-300">{t('notFound.body')}</p>
		<NotFoundSuggestions />
	</section>
</MainSite>
