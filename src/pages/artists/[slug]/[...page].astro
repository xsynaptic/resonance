---
import type { InferGetStaticPropsType } from 'astro';

import TermDetail from '#layouts/term-detail.astro';
import { getArtistsIndex } from '#lib/collections/terms/term-index.ts';
import { createTermDetailPaths } from '#lib/collections/terms/term-routes.ts';

export const getStaticPaths = createTermDetailPaths('artists', getArtistsIndex);

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<TermDetail kind="Artist" {...Astro.props} />
