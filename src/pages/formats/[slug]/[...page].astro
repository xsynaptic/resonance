---
import type { InferGetStaticPropsType } from 'astro';

import TermDetail from '#layouts/term-detail.astro';
import { getFormatsIndex } from '#lib/collections/terms/term-index.ts';
import { createTermDetailPaths } from '#lib/collections/terms/term-routes.ts';

export const getStaticPaths = createTermDetailPaths('formats', getFormatsIndex);

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<TermDetail kind="Format" {...Astro.props} />
