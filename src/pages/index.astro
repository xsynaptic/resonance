---
import { openGraphHomeId } from '@xsynaptic/shared/constants';

import type { ContentCatalogItem } from '#lib/catalog/catalog-types.ts';

import MainSite from '#components/main/main-site.astro';
import HomeSection from '#components/sections/section-home.astro';
import PlaylistsSection from '#components/sections/section-playlists.astro';
import { getCatalog } from '#lib/catalog/catalog-data.ts';
import { getPlaylists } from '#lib/collections/playlists/playlists-data.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { buildAuthorSchema, buildWebSiteSchema } from '#lib/utils/seo-structured-data.ts';

function hasFeaturedImage(item: ContentCatalogItem) {
	return item.image !== undefined;
}

const catalog = await getCatalog();

const mixItems = catalog.byCollection('mixes').filter(hasFeaturedImage).slice(0, 4);
const reviewItems = catalog.byCollection('reviews').filter(hasFeaturedImage).slice(0, 4);
const postItems = catalog.byCollection('posts').filter(hasFeaturedImage).slice(0, 4);
const playlists = await getPlaylists();
---

<MainSite openGraphId={openGraphHomeId} schemas={[buildWebSiteSchema(), buildAuthorSchema()]}>
	<section class="mb-12">
		<h1 class="title-main">{t('home.intro.title')}</h1>
		<p class="mt-2 content-measure text-ink-300">{t('home.intro.description')}</p>
	</section>
	{playlists.length > 0 ? <PlaylistsSection playlists={playlists} /> : undefined}
	<HomeSection collection="mixes" items={mixItems} />
	<HomeSection collection="reviews" items={reviewItems} />
	<HomeSection collection="posts" items={postItems} />
</MainSite>
