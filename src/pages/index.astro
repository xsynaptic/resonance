---
import { openGraphHomeId } from '@xsynaptic/shared/constants';
import { getCollectionPath } from '@xsynaptic/shared/routing';

import MainSite from '#components/main/main-site.astro';
import HomeSection from '#components/sections/section-home.astro';
import { getCatalog } from '#lib/catalog/catalog-data.ts';
import { t } from '#lib/i18n/i18n-strings.ts';
import { site } from '#lib/site.ts';
import { buildAuthorSchema, buildWebSiteSchema } from '#lib/utils/seo-structured-data.ts';

const catalog = await getCatalog();

const mixItems = catalog.byCollection('mixes').slice(0, 4);
const reviewItems = catalog.byCollection('reviews').slice(0, 4);
const postItems = catalog.byCollection('posts').slice(0, 4);
---

<MainSite openGraphId={openGraphHomeId} schemas={[buildWebSiteSchema(), buildAuthorSchema()]}>
	<section class="mb-12">
		<h1 class="title-main">{site.title}</h1>
		<p class="mt-2 content-measure text-ink-300">{t('home.intro')}</p>
	</section>
	<HomeSection
		heading={t('home.mixes.heading')}
		items={mixItems}
		listHref={getCollectionPath('mixes')}
		listLabel={t('home.mixes.link')}
		priority={true}
	/>
	<HomeSection
		heading={t('home.reviews.heading')}
		items={reviewItems}
		listHref={getCollectionPath('reviews')}
		listLabel={t('home.reviews.link')}
	/>
	<HomeSection
		heading={t('home.posts.heading')}
		items={postItems}
		listHref={getCollectionPath('posts')}
		listLabel={t('home.posts.link')}
	/>
</MainSite>
