---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import ListDetail from '#layouts/list-detail.astro';
import { getPublishedLists } from '#lib/collections/lists/lists-data.ts';

export const getStaticPaths = (async () => {
	const lists = await getPublishedLists();

	return lists.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<ListDetail {...Astro.props} />
