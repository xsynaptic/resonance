---
import type { InferGetStaticPropsType } from 'astro';

import TermDetail from '#layouts/term-detail.astro';
import { getRegionsIndex } from '#lib/collections/terms/term-index.ts';
import { createTermDetailPaths } from '#lib/collections/terms/term-routes.ts';

export const getStaticPaths = createTermDetailPaths('regions', getRegionsIndex);

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<TermDetail kind="Region" {...Astro.props} />
