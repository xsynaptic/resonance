---
import type { InferGetStaticPropsType } from 'astro';

import EntryList from '#layouts/entry-list.astro';
import { createEntryListPaths } from '#lib/collections/collection-routes.ts';
import { t } from '#lib/i18n/i18n-strings.ts';

export const getStaticPaths = createEntryListPaths('reviews');

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<EntryList
	description={t('collection.reviews.description')}
	title={t('collection.reviews.title')}
	{...Astro.props}
/>
