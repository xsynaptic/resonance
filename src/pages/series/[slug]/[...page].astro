---
import type { InferGetStaticPropsType } from 'astro';

import TermDetail from '#layouts/term-detail.astro';
import { getSeriesIndex } from '#lib/collections/terms/term-index.ts';
import { createTermDetailPaths } from '#lib/collections/terms/term-routes.ts';

export const getStaticPaths = createTermDetailPaths('series', getSeriesIndex);

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<TermDetail {...Astro.props} />
