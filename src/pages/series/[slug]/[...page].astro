---
import type { InferGetStaticPropsType } from 'astro';

import TermArchive from '#layouts/term-archive.astro';
import { getSeriesIndex } from '#lib/collections/taxonomy/taxonomy-data.ts';
import { createTermArchivePaths } from '#lib/collections/taxonomy/term-routes.ts';

export const getStaticPaths = createTermArchivePaths('series', getSeriesIndex);

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<TermArchive kind="Series" {...Astro.props} />
