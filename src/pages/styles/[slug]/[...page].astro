---
import type { InferGetStaticPropsType } from 'astro';

import TermDetail from '#layouts/term-detail.astro';
import { getStylesIndex } from '#lib/collections/terms/term-index.ts';
import { createTermDetailPaths } from '#lib/collections/terms/term-routes.ts';

export const getStaticPaths = createTermDetailPaths('styles', getStylesIndex);

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, term } = Astro.props;
---

<TermDetail items={page.data} page={page} term={term} />
