---
import type { InferGetStaticPropsType } from 'astro';

import TermDetail from '#layouts/term-detail.astro';
import { getThemesIndex } from '#lib/collections/terms/term-index.ts';
import { createTermDetailPaths } from '#lib/collections/terms/term-routes.ts';

export const getStaticPaths = createTermDetailPaths('themes', getThemesIndex);

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
---

<TermDetail kind="Theme" {...Astro.props} />
