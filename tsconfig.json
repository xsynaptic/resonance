{
	"extends": "astro/tsconfigs/strictest",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": [
		"dist",
		"packages/content",
		"packages/player/playwright-report",
		"packages/player/test-results",
		"worker",
		"worker-configuration.d.ts"
	],
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": ".",
		"strictNullChecks": true,
		"erasableSyntaxOnly": true,
		"jsx": "react-jsx"
	}
}
