{
	"extends": "astro/tsconfigs/strictest",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist", "packages/content", "packages/scripts/src/wp-extract", "worker"],
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": ".",
		"strictNullChecks": true,
		"erasableSyntaxOnly": true,
		"jsx": "react-jsx"
	}
}
